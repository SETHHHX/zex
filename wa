                            task.wait(1)
                            targets = getSittingNPCs(HomelessStorage)
                            ws += 1
                            if ws > 30 then break end
                        until #targets > 0 or not chipFarmActive
                    end
                    if not chipFarmActive then return false end
                    task.wait(2)

                    -- PASO 1: Clipboard + comprar
                    if Teleport(CFrame.new(-771, 4, -198)) == "Stopped" then return false end
                    task.wait(1.0)
                    
                    local lab = workspace.Map.Locations["The Laboratory"]
                    local clipboardPrompt = nil
                    if lab then
                        clipboardPrompt = lab:FindFirstChild("Prompts") and lab.Prompts:FindFirstChild("Clipboard") and lab.Prompts.Clipboard:FindFirstChild("ProximityPrompt")
                    end
                    if clipboardPrompt then
                        FirePromptSafe(clipboardPrompt, 3)
                    else
                        local VIM = game:GetService("VirtualInputManager")
                        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.1)
                        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end
                    task.wait(0.5)
                    storeEvent:FireServer("Potato"); task.wait(0.5)
                    storeEvent:FireServer("Flour"); task.wait(0.5)

                    -- PASO 2: Procesar chips
                    if Teleport(CFrame.new(-479, 4, -436)) == "Stopped" then return false end
                    task.wait(0.5)
                    local pressPrompt = lab and lab:FindFirstChild("Prompts") and lab.Prompts:FindFirstChild("Press") and lab.Prompts.Press:FindFirstChild("ProximityPrompt")
                    if pressPrompt then
                        FirePromptSafe(pressPrompt, 3)
                    else
                        local VIM = game:GetService("VirtualInputManager")
                        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.1)
                        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end
                    task.wait(1)

                    if Teleport(CFrame.new(-463, 4, -469)) == "Stopped" then return false end
                    safeEquip("Potato")
                    task.wait(0.5)
                    local cutterPrompt = workspace.Map.Locations["The Laboratory"]["Cutting Boards"]["Potato Cutter"].Model.Union.Attachment.ProximityPrompt
                    if cutterPrompt then FirePromptSafe(cutterPrompt, 3) end
                    task.wait(3)

                    if Teleport(CFrame.new(-462, 4, -475)) == "Stopped" then return false end
                    task.wait(0.5)
                    local bagPrompt = workspace.Map.Locations["The Laboratory"].Prompts["Plastic Bag"].Attachment.ProximityPrompt
                    if bagPrompt then FirePromptSafe(bagPrompt, 3) end
                    task.wait(3)

                    if Teleport(CFrame.new(-487, 4, -536)) == "Stopped" then return false end
                    safeEquip("Flour")
                    task.wait(0.5)
                    local bowlPrompt = workspace.Map.Locations["The Laboratory"].Bowls:GetChildren()[2].ProximityPrompt
                    if bowlPrompt then FirePromptSafe(bowlPrompt, 3) end
                    task.wait(5.7)


                    local pots = workspace.Map.Locations["The Laboratory"].Pots:GetChildren()
                    local selectedPot = pots[6]
                    if not selectedPot then return false end

                    local potPos = selectedPot:GetPivot().Position
                    Teleport(CFrame.new(potPos + Vector3.new(0, 0, 3)))
                    task.wait(1.0)

                    local potPrompt = selectedPot:FindFirstChild("ProximityPrompt")
                    if potPrompt then
                        pcall(function()
                            potPrompt.Enabled = true
                            potPrompt.HoldDuration = 0
                            potPrompt.RequiresLineOfSight = false
                            potPrompt.MaxActivationDistance = 50
                        end)

                        for i = 1, 5 do
                            pcall(function() fireproximityprompt(potPrompt) end)
                            task.wait(0.5)
                        end

                        local timerStarted = false
                        local t = 0
                        local maxWait = 65
                        while chipFarmActive and t < maxWait do
                            task.wait(1); t = t + 1
                            local timer = selectedPot:FindFirstChild("Timer")
                            if timer and timer:FindFirstChild("TextLabel") then
                                local currentTime = timer.TextLabel.Text
                                if currentTime ~= "0" and not timerStarted then
                                    timerStarted = true
                                end
                                if currentTime == "0" and timerStarted then break end
                                if currentTime == "0" and t > 10 and not timerStarted then
                                    pcall(function() fireproximityprompt(potPrompt) end)
                                    timerStarted = true
                                end
                            end
                        end

                        task.wait(1.0)
                        if chipFarmActive then 
                            local VIM = game:GetService("VirtualInputManager")
                            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.1)
                            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            task.wait(1)
                        end
                    end

                    -- PASO 4: Poor Guy
                    if Teleport(CFrame.new(-33, 4, -25)) == "Stopped" then return false end
                    task.wait(1.0)
                    local poorGuy = workspace.Folders.NPCs:FindFirstChild("Poor Guy")
                    if poorGuy then 
                        local prompt = poorGuy.UpperTorso:FindFirstChildOfClass("ProximityPrompt")
                        if prompt then
                            FirePromptSafe(prompt, 3)
                            task.wait(1.5)
                        end
                    end

                    -- PASO 5: Entregar Hot Chips
                    local hotChipsCount = getItemCount("Hot Chips")
                    if hotChipsCount > 0 then
                        local allTargets = getSittingNPCs(HomelessStorage)
                        for _, v in ipairs(getSittingNPCs(HomelessLive)) do table.insert(allTargets, v) end
                        for _, npc in ipairs(allTargets) do
                            if hotChipsCount <= 0 then break end
                            if not npc or not npc.Parent or npc:GetAttribute("AnimationState") ~= "Sitting" then continue end
                            Teleport(npc.HumanoidRootPart.CFrame)
                            safeEquip("Hot Chips")
                            task.wait(0.3)
                            local prompt = npc.UpperTorso:FindFirstChildOfClass("ProximityPrompt")
                            if prompt then FirePromptSafe(prompt, 3) end
                            task.wait(1.5)
                            Config["AutoFarm"]["Chips"]["Status"]["Earned"] += 300
                            Config["AutoFarm"]["Chips"]["Status"]["Delivered"] += 1
                            hotChipsCount = hotChipsCount - 1
                        end
                    end

                    return true
                end

                while chipFarmActive do
                    local success = ChipCycle()
                    if not success then task.wait(3) end
                    if chipFarmActive then task.wait(2) end
                end

                stopChipCamLock()
            end)
        end

