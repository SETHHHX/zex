do --// Initialization & Anti-Cheat Bypass
    local StarterGui = cloneref and cloneref(game:GetService("StarterGui")) or game:GetService("StarterGui")
    local Bind = Instance.new("BindableFunction")
    
    local Thread_Changed = false
    local Anti_Cheat_Bypassed = false

    do 
        if getnilinstances and getreg and getscriptfromthread then
            local Target_Names = {}

            local nil_instances = getnilinstances()
            for i = 1, #nil_instances do
                local obj = nil_instances[i]
                if obj and (obj:IsA("Script") or obj:IsA("LocalScript")) then
                    local name = tostring(obj.Name)
                    if #name >= 16 and name:match("^%w+$") then
                        Target_Names[name] = true
                    else
                        Thread_Changed = true
                    end
                end
            end

            if Thread_Changed then
                warn("[DEBUG]: Structural variance detected in nil instances. Engaging deep registry scan...")
            end

            local Success, Error = pcall(function()
                local registry = getreg()
                for _, v in next, registry do
                    if type(v) == "thread" and coroutine.status(v) ~= "dead" then
                        local success_src, script_src = pcall(getscriptfromthread, v)
                        if success_src and script_src then
                            local script_name = tostring(script_src)
                            
                            if Target_Names[script_name] or (Thread_Changed and #script_name >= 16 and script_name:match("^%w+$")) then
                                coroutine.close(v)
                                Anti_Cheat_Bypassed = true
                            end
                        end
                    end
                end
            end)

            if not Success and Error then
                warn("[DEBUG]: Critical error during registry thread termination: " .. tostring(Error))
            elseif Anti_Cheat_Bypassed then
                pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
                    Title = "Success",
                    Text = "Anti-cheat threads terminated. Proceed?",
                    Duration = 30,
                    Button1 = "Proceed",
                    Button2 = "Cancel",
                    Callback = Bind
                })
                warn("[DEBUG]: Anti-cheat threads successfully terminated!")
            else
                warn("[DEBUG]: Registry scan complete. No active anti-cheat threads found.")
                Thread_Changed = true
                task.spawn(function() task.wait(0.1); Bind:Invoke("Proceed") end)
            end
        else
            warn("[DEBUG]: Environment unsupported. Missing required closure/registry functions.")
            pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
                Title = "Warning",
                Text = "Environment unsupported. Code execution may be unsafe. Proceed?",
                Duration = 15,
                Button1 = "Use Anyway",
                Button2 = "Cancel",
                Callback = Bind
            })
        end
    end

