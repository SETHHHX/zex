-- ✅ FUNCIÓN MEJORADA: Busca el mensaje en TODA la GUI
local function WaitForBankResult(timeout)
    timeout = timeout or 15
    local start = tick()

    while tick() - start < timeout do
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then
            task.wait(0.1)
            continue
        end

        -- Buscar en TODOS los hijos de PlayerGui
        for _, guiObject in ipairs(playerGui:GetDescendants()) do
            if guiObject:IsA("TextLabel") or guiObject:IsA("TextBox") then
                local text = guiObject.Text or ""

                -- Mensaje de rechazo
                if text:find("unsuccessful") or text:find("Your application was unsuccessful") then
                    print("✅ Detectado: REJECTED")
                    return "REJECTED"
                end

                -- Mensaje de aprobación
                if text:find("successful") and text:find("30 seconds") then
                    print("✅ Detectado: APPROVED")
                    return "APPROVED"
                end

                -- Mensaje de no estar en lista
                if text:find("not on the wait list") then
                    print("✅ Detectado: NO_CARD")
                    return "NO_CARD"
                end
            end
        end

        task.wait(0.1)
    end

    print("⏰ TIMEOUT esperando respuesta del banco")
    return "TIMEOUT"
end

-- ✅ NUEVO: lanza la verificación del banco en un thread separado.
-- No bloquea el loop principal; el resultado se guarda en bankCheckResult
-- y el loop principal de Start_MultiFarm lo revisa periódicamente.
local function StartBackgroundBankCheck(timeout)
    if bankCheckRunning then
        return -- ya hay una verificación corriendo, no lanzar otra
    end

    bankCheckRunning = true
    bankCheckResult = nil

    bankCheckThread = task.spawn(function()
        local result = WaitForBankResult(timeout or 15)

        -- Verificación manual extra si dio timeout
        if result == "TIMEOUT" then
            task.wait(0.5)
            local c = LocalPlayer.Character
            local stillHasID = LocalPlayer.Backpack:FindFirstChild("Fake ID") or (c and c:FindFirstChild("Fake ID"))
            if not stillHasID then
                print("✅ Fake ID desapareció = aplicación aceptada! (detectado en background)")
                result = "APPROVED"
            end
        end

        bankCheckResult = result
        bankCheckRunning = false
    end)
end

