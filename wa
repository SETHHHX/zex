 --// Teleport Logic
        Teleport = function(Destination)
            local movementMode = Config["AutoFarm"]["MovementType"]

            if movementMode == "Teleport Mode (IN-PROGRESS)" then
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, 9e9, 0)
                task.wait(1)
                LocalPlayer.Character.HumanoidRootPart.CFrame = Destination
                return (LocalPlayer.Character.HumanoidRootPart.Position - Destination.Position).Magnitude < 20 and "Success" or "Failed"

            elseif movementMode == "Safe Mode" then
                if LocalPlayer.Character.Humanoid.SeatPart and LocalPlayer.Character.Humanoid.SeatPart.Name == "DriveSeat" then
                    return "Failed"
                end
                local Root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not Root then return "Failed" end
                _SM_Root = Root

                _SM_MeshPart = Instance.new("Part")
                _SM_MeshPart.Name = "AntiFall_Platform1"
                _SM_MeshPart.Size = Vector3.new(2048, 2, 2048)
                _SM_MeshPart.CFrame = CFrame.new(0, -6.5, 0)
                _SM_MeshPart.Transparency = 0.3
                _SM_MeshPart.Anchored = true
                _SM_MeshPart.CanCollide = true
                _SM_MeshPart.Parent = Workspace

                _SM_MeshPart2 = Instance.new("Part")
                _SM_MeshPart2.Name = "AntiFall_Platform2"
                _SM_MeshPart2.Size = Vector3.new(2048, 2, 2048)
                _SM_MeshPart2.CFrame = CFrame.new(935, -6.5, 65)
                _SM_MeshPart2.Transparency = 0.3
                _SM_MeshPart2.Anchored = true
                _SM_MeshPart2.CanCollide = true
                _SM_MeshPart2.Parent = Workspace

                _SM_HeartbeatConnection = RunService.Stepped:Connect(function() if Root and Root.Parent then Noclip() end end)
                SafeModeRunning = true
                local UndergroundPos = Vector3.new(Root.Position.X, -1, Root.Position.Z)
                local Tween_Root = TweenService:Create(Root, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = CFrame.new(UndergroundPos) * CFrame.Angles(0, math.atan2(Root.CFrame.LookVector.X, Root.CFrame.LookVector.Z), 0) })
                Tween_Root:Play(); Tween_Root.Completed:Wait()
                task.wait(0.2)

                local GoalPos = Vector3.new(Destination.X, -2.1378674507141113, Destination.Z)
                LookDown(15, false)

                while anyFarmRunning() and Root and Root.Parent and (Vector3.new(Root.Position.X, 0, Root.Position.Z) - Vector3.new(GoalPos.X, 0, GoalPos.Z)).Magnitude > (1.7 + math.random() * 0.1) do
                    local Direction = (GoalPos - Root.Position).Unit
                    local LookTarget = Vector3.new(GoalPos.X, -2.1378674507141113, GoalPos.Z)
                    local NextPosition = Root.Position + Direction
                    Noclip()
                    Root.CFrame = CFrame.new(Vector3.new(NextPosition.X, -2.1378674507141113, NextPosition.Z), LookTarget)
                    task.wait(0.05)
                end

                if LookDownConnection then LookDownConnection:Disconnect(); LookDownConnection = nil end
                if not anyFarmRunning() then
                    SafeModeCleanup()
                    if Root and Root.Parent then
                        local surfacePos = Vector3.new(Root.Position.X, 3, Root.Position.Z)
                        local Tween_Up = TweenService:Create(Root, TweenInfo.new(1, Enum.EasingStyle.Linear), { CFrame = CFrame.new(surfacePos) * CFrame.Angles(0, math.atan2(Root.CFrame.LookVector.X, Root.CFrame.LookVector.Z), 0) })
                        Tween_Up:Play(); Tween_Up.Completed:Wait()
                    end
                    return "Stopped"
                end
                Root.CFrame = Destination
                task.wait(0.1)
                SafeModeCleanup()
                return "Success"

elseif movementMode == "Bike" then
                local Bike = Find_Bike()
                if Bike == nil then
                    SpawnBike()
                    Bike = Find_Bike()
                    if Bike == nil then return "Failed" end
                end

                local Character = LocalPlayer.Character
                local Hum = Character and Character:FindFirstChildOfClass("Humanoid")
                if not Character or not Hum then return "Failed" end

                if not Hum.SeatPart or Hum.SeatPart.Name ~= "DriveSeat" then
                    Character.HumanoidRootPart.CFrame = Bike.DriveSeat.CFrame
                    task.wait(0.2)
                    if Bike.DriveSeat:FindFirstChild("Attachment") and Bike.DriveSeat.Attachment:FindFirstChild("ProximityPrompt") then
                        fireproximityprompt(Bike.DriveSeat.Attachment.ProximityPrompt)
                    end
                    task.wait(0.4)
                end

                if not Hum.SeatPart or Hum.SeatPart.Name ~= "DriveSeat" then
                    Character.HumanoidRootPart.CFrame = Destination
                    return "Success"
                end

                local primaryPart = Bike.PrimaryPart or Bike:FindFirstChild("Root")
                if not primaryPart then return "Failed" end

                local targetPos = Destination.Position + Vector3.new(0, 1.5, 0)
                local targetCFrame = CFrame.new(targetPos, targetPos + Destination.LookVector)

                -- Limpiar cualquier freno viejo de un TP anterior
                local oldPos = primaryPart:FindFirstChild("_TP_HoldPosition")
                if oldPos then oldPos:Destroy() end
                local oldOri = primaryPart:FindFirstChild("_TP_HoldOrientation")
                if oldOri then oldOri:Destroy() end
                local oldAtt = primaryPart:FindFirstChild("_TP_Attachment")
                if oldAtt then oldAtt:Destroy() end

                -- Mover TODA la bici de una sola vez usando SetPrimaryPartCFrame,
                -- que respeta los welds entre las partes (no las desarma como
                -- mover cada parte individualmente sí puede hacer).
                Bike:SetPrimaryPartCFrame(targetCFrame)

                for _, Value in Bike:GetDescendants() do
                    if Value:IsA("BasePart") then
                        pcall(function()
                            Value.Velocity = Vector3.new(0, 0, 0)
                            Value.RotVelocity = Vector3.new(0, 0, 0)
                            Value.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            Value.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end)
                    end
                end

                -- Frizar el chasis con fuerza MODERADA (no extrema) para que no
                -- se mueva ni caiga, sin romper los welds de las ruedas.
                local attachment = Instance.new("Attachment")
                attachment.Name = "_TP_Attachment"
                attachment.Parent = primaryPart

                local holdPos = Instance.new("BodyPosition")
                holdPos.Name = "_TP_HoldPosition"
                holdPos.Position = targetPos
                holdPos.MaxForce = Vector3.new(50000, 50000, 50000)
                holdPos.P = 3000
                holdPos.D = 500
                holdPos.Parent = primaryPart

                local holdOri = Instance.new("BodyGyro")
                holdOri.Name = "_TP_HoldOrientation"
                holdOri.CFrame = targetCFrame
                holdOri.MaxTorque = Vector3.new(50000, 50000, 50000)
                holdOri.P = 3000
                holdOri.D = 500
                holdOri.Parent = primaryPart

                Character.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.5, 0))

                task.wait(0.2)

                return "Success"
            end
        end

        -- ✅ NUEVO: descongela la bici quitando los constraints de freno del TP,
-- para que vuelva a moverse con física normal cuando se detiene el farm.
local function UnfreezeBike()
    local Bike = Find_Bike()
    if not Bike then return end

    local primaryPart = Bike.PrimaryPart or Bike:FindFirstChild("Root")
    if not primaryPart then return end

    local holdPos = primaryPart:FindFirstChild("_TP_HoldPosition")
    if holdPos then holdPos:Destroy() end

    local holdOri = primaryPart:FindFirstChild("_TP_HoldOrientation")
    if holdOri then holdOri:Destroy() end

    local attachment = primaryPart:FindFirstChild("_TP_Attachment")
    if attachment then attachment:Destroy() end

    -- Limpiar también cualquier velocidad residual al soltar la bici
    for _, Value in Bike:GetDescendants() do
        if Value:IsA("BasePart") then
            pcall(function()
                Value.Velocity = Vector3.new(0, 0, 0)
                Value.RotVelocity = Vector3.new(0, 0, 0)
                Value.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                Value.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end

    print("🚲 Bici descongelada")
end

        SpawnBike = function()
            local Bike = Find_Bike()
            local b = buffer.create(1)
            buffer.writeu8(b, 0, 1)

            if Bike == nil then
                ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("RPC"):FireServer(b, "Spawn", "DirtBike")
                local BikeForce = false
                task.spawn(function() task.wait(3); BikeForce = true end)
                repeat task.wait() until Find_Bike() ~= nil or BikeForce == true
                Bike = Find_Bike()
                task.wait()
                if Bike == nil then return "Failed" end
            end
            Bike.DriveSeat.Attachment.ProximityPrompt.HoldDuration = 0
            Bike.DriveSeat.Attachment.ProximityPrompt.RequiresLineOfSight = false
            LocalPlayer.Character.HumanoidRootPart.CFrame = Bike.PrimaryPart.CFrame
            task.wait(0.3)
            fireproximityprompt(Bike.DriveSeat.Attachment.ProximityPrompt)
            task.wait(0.5)
        end

        --// Apartment Helpers
        BuyApartment = function()
            local Owns_Apartment = function(Apartment)
                local Board = Apartment:FindFirstChild("Board")
                local Label = Board and Board:FindFirstChild("name") and Board.name:FindFirstChild("SurfaceGui") and Board.name.SurfaceGui:FindFirstChild("TextLabel")
                return Label and Label.Text == LocalPlayer.Name
            end
            local Is_Vacant = function(Apartment)
                local Board = Apartment:FindFirstChild("Board")
                local Label = Board and Board:FindFirstChild("name") and Board.name:FindFirstChild("SurfaceGui") and Board.name.SurfaceGui:FindFirstChild("TextLabel")
                return Label and Label.Text == "VACANT"
            end
            local Apartments = Workspace.Map:FindFirstChild("APTS")
            local Houses     = Workspace.Map:FindFirstChild("Houses")
            if not Apartments or not Houses then return false end

            local SelectedApartment = nil
            for _, ApartmentName in ipairs(Apartments_Lists) do
                local APT = Apartments:FindFirstChild(ApartmentName)
                if APT and APT:IsA("Model") then
                    if Owns_Apartment(APT) then SelectedApartment = APT; break
                    elseif not SelectedApartment and Is_Vacant(APT) then SelectedApartment = APT end
                end
            end
            if Owns_Apartment(SelectedApartment) then
                return true
            end
            if not SelectedApartment then return false end
            local Board = SelectedApartment:FindFirstChild("Board")
            if Board then
                Teleport(CFrame.new(Board:GetPivot().Position))
            end
            if Is_Vacant(SelectedApartment) then
                local prompt = Board and Board:FindFirstChild("backboard") and Board.backboard:FindFirstChild("ProximityPrompt")
                if prompt then
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                    task.wait(0.5)
                    fireproximityprompt(prompt)
                end
            end
            task.wait(1)
            return true
        end

