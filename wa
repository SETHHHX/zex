        local waitCount = 0
        repeat
            CheckCardAndSafeZone()
            task.wait(1); waitCount += 1
        until Task_Text == "Let the solution cook for 45 seconds." or waitCount > 40 or not MultiFarmRunning
        if hum then hum:UnequipTools() end
        print("✅ Gelatin puesta!")
    end

    -- COLLECT
    if GetNumberOfItemsInBackpack("Empty Bag") >= 1 then
        print("🛍️ Esperando cocción y recogiendo...")
        local timerLabel = Pot:FindFirstChild("Timer") and Pot.Timer:FindFirstChild("TextLabel")
        if timerLabel then
            repeat
                CheckCardAndSafeZone()
                task.wait(1)
            until timerLabel.Text == "0" or not MultiFarmRunning
        end
        Teleport(Pot.CFrame * CFrame.new(0, 0, 3)); task.wait(0.5)
        safeEquip("Empty Bag")
        tween_and_prompt(Pot.Attachment.ProximityPrompt)
