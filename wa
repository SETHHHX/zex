    local inSafeZone = false

    -- ✅ NUEVO: además de chequear si la card está lista para recoger,
    -- revisamos si llegó un resultado del banco desde el background thread.
    local function CheckCardAndSafeZone()
        -- Revisar resultado del banco en background (no bloqueante)
        if bankCheckResult ~= nil then
            local result = bankCheckResult
            bankCheckResult = nil -- consumir el resultado

            if result == "REJECTED" then
