-- ✅ NUEVO: helper que intenta el prompt del Bank Teller con reposicionamiento
-- automático si el prompt no está disponible o el NPC está en cooldown.
local function TryApplyAtBank(maxAttempts, repositionEvery)
    maxAttempts = maxAttempts or 25
    repositionEvery = repositionEvery or 6 -- cada cuántos intentos sin éxito se reposiciona

    local attempts = 0
    local attemptsSinceReposition = 0

    local function getTellerAndPrompt()
        local tellerNPC = workspace.Folders.NPCs:FindFirstChild("Bank Teller")
        local tellerPrompt = tellerNPC and tellerNPC.UpperTorso and tellerNPC.UpperTorso.Attachment:FindFirstChildOfClass("ProximityPrompt")
        return tellerNPC, tellerPrompt
    end

    local function doReposition(tellerNPC)
        print("🔁 Prompt no disponible / NPC en cooldown, reposicionando...")
        if tellerNPC and tellerNPC:FindFirstChild("HumanoidRootPart") then
            Teleport(tellerNPC.HumanoidRootPart.CFrame * CFrame.new(0, 0, -2.5))
        else
            Teleport(CFrame.new(-48.74, 6.50, -317.00))
        end
        task.wait(1.2)
    end

    -- posición inicial
    local tellerNPC = getTellerAndPrompt()
    doReposition(tellerNPC)

    while attempts < maxAttempts do
        if not MultiFarmRunning then return false end

        tellerNPC, tellerPrompt = getTellerAndPrompt()

        -- Si el prompt no existe o está deshabilitado (cooldown del NPC),
        -- NO lo contamos como "se presionó" — reposicionamos en vez de asumir rechazo.
        local promptUsable = tellerPrompt ~= nil and tellerPrompt.Enabled ~= false

        if not promptUsable then
            attemptsSinceReposition += 1
            print("⚠️ Prompt del banco no disponible (NPC posiblemente en cooldown)...")
            if attemptsSinceReposition >= repositionEvery then
                doReposition(tellerNPC)
                attemptsSinceReposition = 0
            else
                task.wait(0.6)
            end
            attempts += 1
            continue
        end

        -- Prompt disponible: lo presionamos
        print("🔄 Aplicando al banco (intento " .. (attempts + 1) .. ")...")
        pointCamAt(tellerNPC.UpperTorso)
        safeFirePrompt(tellerPrompt)
        task.wait(0.5)
        attempts += 1
        attemptsSinceReposition = 0

        return true -- se logró presionar el prompt con éxito
    end

    print("❌ No se pudo presionar el prompt del banco tras varios intentos")
    return false
end

