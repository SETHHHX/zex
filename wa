function Start_MultiFarm()
    if MultiFarmRunning then return end
    MultiFarmRunning = true
    waitingForCard = false
    cardRetryNeeded = false
    bankCheckResult = nil
    bankCheckRunning = false

    MultiFarmThread = task.spawn(function()
        print("🚀 Iniciando MultiFarm (Marshmallow + Card)...")

        local c = LocalPlayer.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local oldCard = LocalPlayer.Backpack:FindFirstChild("Card") or (c and c:FindFirstChild("Card"))
        if oldCard then
            print("🗑️ Eliminando card vieja del inventario...")
            if hum then hum:UnequipTools() end
            task.wait(0.3)
            oldCard:Destroy()
            task.wait(0.5)
        end

        -- ✅ Ya NO eliminamos la Fake ID vieja: si existe, DoCardCycle la reutiliza.

        local cardSuccess = DoCardCycle()
        if not cardSuccess then
            print("❌ Falló ciclo inicial de Card, reintentando en el loop...")
            cardRetryNeeded = true
        end

        while MultiFarmRunning do
            -- ✅ Revisar resultado del banco en background también aquí,
            -- por si el bot está en el loop principal y no dentro de DoMallowCycle.
            if bankCheckResult ~= nil then
                local result = bankCheckResult
                bankCheckResult = nil

                if result == "REJECTED" then
                    print("❌ Aplicación rechazada (background, loop principal)!")
                    local cc = LocalPlayer.Character
                    local hh = cc and cc:FindFirstChildOfClass("Humanoid")
                    if hh then hh:UnequipTools() end
                    cardRetryNeeded = true

                elseif result == "APPROVED" then
                    print("✅ Aplicación aceptada (background, loop principal)!")
                    waitingForCard = true
                    cardCooldownStart = tick()

                elseif result == "NO_CARD" then
                    local cc = LocalPlayer.Character
                    if not (LocalPlayer.Backpack:FindFirstChild("Card") or (cc and cc:FindFirstChild("Card"))) then
                        cardRetryNeeded = true
                    end

                elseif result == "TIMEOUT" then
                    cardRetryNeeded = true
                end
            end

            local cardCooldown = IsCardInCooldown()
            local mallowCooldown = IsMallowInCooldown()

            if cardRetryNeeded then
                print("🔄 Reintentando ciclo de Card fallido...")
                task.wait(2)
                local ok = DoCardCycle()
                if ok then
                    cardRetryNeeded = false
                else
                    task.wait(3)
                end
                continue
            end

            if cardCooldown and mallowCooldown then
                Teleport(SAFEZONE_POSITION)
                task.wait(2)
                continue
            end

            if waitingForCard and not cardCooldown then
                print("⏰ Card lista! Recogiendo y swippeando...")
                local swipeResult = CollectCard()

                if swipeResult == "RESTART" then
                    print("🔄 Reiniciando ciclo de card desde cero...")
                    waitingForCard = false
                    cardRetryNeeded = true
                    task.wait(2)

                elseif swipeResult == true then
                    print("🔄 Card swippeada! Iniciando nuevo ciclo...")
                    task.wait(1)
                    if MultiFarmRunning then
                        local ok = DoCardCycle()
                        if not ok then cardRetryNeeded = true end
                    end

                else
                    print("❌ Falló CollectCard, marcando para reintentar...")
                    waitingForCard = false
                    cardRetryNeeded = true
                    task.wait(2)
                end
                continue
            end

            if not mallowCooldown then
                print("🍬 Haciendo Marshmallow...")
                local mallowSuccess = DoMallowCycle()
                if not mallowSuccess then
                    print("⚠️ Falló ciclo de Marshmallow, reintentando...")
                    task.wait(2)
                end
                continue
            end

            task.wait(0.5)
        end

        print("🛑 MultiFarm detenido")
        MultiFarmRunning = false
        waitingForCard = false
        cardRetryNeeded = false
    end)
end

function Stop_MultiFarm()
    if MultiFarmThread then
        pcall(task.cancel, MultiFarmThread)
        MultiFarmThread = nil
    end
    if bankCheckThread then
        pcall(task.cancel, bankCheckThread)
        bankCheckThread = nil
    end
    MultiFarmRunning = false
    waitingForCard = false
    cardRetryNeeded = false
    bankCheckResult = nil
    bankCheckRunning = false
    if LookDownConnection then LookDownConnection:Disconnect(); LookDownConnection = nil end
    SafeModeCleanup()
    UnfreezeBike()  -- ✅ NUEVO: suelta la bici al detener el farm
    print("🛑 MultiFarm detenido")
end

