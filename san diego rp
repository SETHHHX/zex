-- ===== FUNCIONES DE ACCIÓN Y SPAWN (POR PROXIMIDAD) =====

local function getClosestPodium()
    local character = p.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local spawnersFolder = workspace:WaitForChild("VehicleSpawners")
    local closestPodium = nil
    local shortestDistance = math.huge
    
    for _, obj in ipairs(spawnersFolder:GetChildren()) do
        local targetPart = nil
        if obj:IsA("BasePart") then
            targetPart = obj
        elseif obj:IsA("Model") then
            targetPart = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        else
            targetPart = obj:FindFirstChildOfClass("BasePart")
        end
        
        if targetPart and targetPart.Position then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestPodium = obj
            end
        end
    end
    return closestPodium
end

local function spawnVehicle()
    if not autofarmEnabled then return false end
    print("🚗 AutoSpawner: Buscando el podio más cercano...")
    
    if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
        warn("❌ No character to spawn vehicle")
        return false
    end
    
    local podium = getClosestPodium()
    if podium then
        print("🎯 Podio encontrado por proximidad: " .. podium:GetFullName())
        local args = { podium, VEHICLE_MODEL }
        
        local success, err = pcall(function()
            game:GetService("ReplicatedStorage")
                :WaitForChild("__remotes")
                :WaitForChild("VehicleSpawnerService")
                :WaitForChild("SpawnVehicleFromSpawner")
                :InvokeServer(unpack(args))
        end)
            
        if success then
            return true
        else
            return false
        end
    else
        return false
    end
end

local function viajarA(targetPos)
    c = p.Character or c
    h = c:FindFirstChildOfClass("Humanoid") or h
    hrp = c:FindFirstChild("HumanoidRootPart") or hrp

    if not autofarmEnabled or not h then return end
    running = true
    if currentFreezeConnection then currentFreezeConnection:Disconnect() end
    
    local s = h.SeatPart
    if not s then
        running = false
        return
    end
    
    local v = s.Parent
    while v and not v:FindFirstChild("Root") do v = v.Parent end
    if not v then running = false return end
    local r = v:FindFirstChild("Root")
    
    local wheelsModel = v:FindFirstChild("Wheels")
    if wheelsModel then wheelsModel:Destroy() end
    
    for _, part in ipairs(v:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.AssemblyLinearVelocity = Vector3.new(0,0,0)
            part.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end
    if r then r.Anchored = false end
    task.wait(0.05)
    
    local noclipConnection
    noclipConnection = game:GetService("RunService").Stepped:Connect(function()
        if not running or not autofarmEnabled or not v or not v.Parent then 
            if noclipConnection then noclipConnection:Disconnect() end 
            return 
        end
        
        for _, part in ipairs(v:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if p.Character then
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
    
    local llego = false
    local heartbeatConnection
    
    heartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not running or not autofarmEnabled or not r or not r.Parent then 
            if heartbeatConnection then heartbeatConnection:Disconnect() end 
            return 
        end
        
        local pos = r.Position
        local dir = targetPos - pos
        local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
        
        if dist < DISTANCIA_LLEGADA then
            running = false
            if heartbeatConnection then heartbeatConnection:Disconnect() end
            if noclipConnection then noclipConnection:Disconnect() end
            
            r.CFrame = CFrame.new(targetPos)
            
            currentFreezeConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if running or not autofarmEnabled or not r or not r.Parent then 
                    if currentFreezeConnection then currentFreezeConnection:Disconnect() end 
                    return 
                end
                r.CFrame = CFrame.new(targetPos)
                r.AssemblyLinearVelocity = Vector3.new(0,0,0)
                r.AssemblyAngularVelocity = Vector3.new(0,0,0)
            end)
            llego = true
            return
        end
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {v, c}
        local ray = workspace:Raycast(pos + Vector3.new(0,15,0), Vector3.new(0,-50,0), raycastParams)
        if ray then
            r.CFrame = CFrame.new(Vector3.new(pos.X, ray.Position.Y + 2.5, pos.Z))
        else
            r.CFrame = CFrame.new(Vector3.new(pos.X, math.max(pos.Y, targetPos.Y - 3), pos.Z))
        end
        
        local currentSpeed = (dist > FRENADO_INICIO) and MAX_SPEED or math.max(FRENADO_MINIMO, MAX_SPEED * (dist / FRENADO_INICIO))
        local moveDir = Vector3.new(dir.X, 0, dir.Z).Unit
        if moveDir.Magnitude == 0 then moveDir = Vector3.new(1, 0, 0) end
        
        r.AssemblyLinearVelocity = moveDir * currentSpeed
        r.CFrame = CFrame.lookAt(r.Position, r.Position + moveDir)
        r.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end)
    
    repeat 
        task.wait(0.1) 
    until llego or not running or not autofarmEnabled or (h and h.Health <= 0)
end

local function contarItems(nombreItem)
    local count = 0
    if p:FindFirstChild("Backpack") then
        for _, item in ipairs(p.Backpack:GetChildren()) do
            if item.Name == nombreItem then count = count + 1 end
        end
    end
    return count
end

-- ===== CONTROL DEL CICLO PRINCIPAL =====

local function startAutofarm()
    if autofarmEnabled then return end
    autofarmEnabled = true
    
    mainLoopThread = task.spawn(function()
        
        while autofarmEnabled do
            c = p.Character or p.CharacterAdded:Wait()
            h = c:WaitForChild("Humanoid")
            
            if h.Health <= 0 then
                p.CharacterAdded:Wait()
                task.wait(1)
                continue
            end
            
            if not h.SeatPart and autofarmEnabled then
                local spawned = spawnVehicle()
                if spawned then
                    local timeout = 0
                    repeat 
                        task.wait(0.1)
                        timeout = timeout + 0.1
                    until h.SeatPart or timeout > 5 or not autofarmEnabled or h.Health <= 0
                end
            end

            if not h.SeatPart or h.Health <= 0 or not autofarmEnabled then
                task.wait(1)
                continue
            end

            -- FASE 1: COMPRA
            viajarA(Vector3.new(6819, 9, 17))
            if not autofarmEnabled or h.Health <= 0 then continue end
            task.wait(0.5)
            
            while contarItems("Fake Diamond Ring") < 5 and autofarmEnabled and h.Health > 0 do

                pcall(function()
                    local args = { workspace:WaitForChild("WorldBuyableItems"):WaitForChild("Fake Diamond Ring") }
                    game:GetService("ReplicatedStorage"):WaitForChild("__remotes"):WaitForChild("WorldBuyableItemService"):WaitForChild("PurchaseWorldBuyableItem"):FireServer(unpack(args))
                end)
                task.wait(0.4)
            end
            if not autofarmEnabled or h.Health <= 0 then continue end
            
            -- FASE 2: VENTA
            viajarA(Vector3.new(209, 6, -37))
            if not autofarmEnabled or h.Health <= 0 then continue end
            task.wait(0.5)
            
            pcall(function()
                local argsVenta = { workspace:WaitForChild("NPC"):WaitForChild("Seller4") }
                game:GetService("ReplicatedStorage"):WaitForChild("__remotes"):WaitForChild("SmuggleService"):WaitForChild("SellSmuggledGoods"):FireServer(unpack(argsVenta))
            end)
            
            local tiempoEspera = 0
            repeat 
                task.wait(0.2) 
                tiempoEspera = tiempoEspera + 0.2
            until (p.Backpack:FindFirstChild("Briefcase")) or tiempoEspera > 3 or not autofarmEnabled or h.Health <= 0
            if not autofarmEnabled or h.Health <= 0 then continue end
            
            -- FASE 3: LAVADO
            if p.Backpack:FindFirstChild("Briefcase") then
                print("🧼 Viajando a Lavar dinero")
                viajarA(Vector3.new(6807, 9, -34))
                if not autofarmEnabled or h.Health <= 0 then continue end
                task.wait(0.5)
                
                while p.Backpack:FindFirstChild("Briefcase") and autofarmEnabled and h.Health > 0 do
                    pcall(function()
                        local argsLavado = { workspace:WaitForChild("LaunderPrompts"):WaitForChild("LaunderTrigger"):WaitForChild("PromptPart") }
                        game:GetService("ReplicatedStorage"):WaitForChild("__remotes"):WaitForChild("SmuggleService"):WaitForChild("LaunderBriefcase"):FireServer(unpack(argsLavado))
                    end)
                    task.wait(0.5)
                end
            else
            end
            
            task.wait(1)
        end
    end)
end

local function stopAutofarm()
    autofarmEnabled = false
    running = false
    
    if h and h.SeatPart then
        local v = h.SeatPart.Parent
        while v and not v:FindFirstChild("Root") do v = v.Parent end
        if v and v:FindFirstChild("Root") then
            v.Root.Anchored = true
            v.Root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            print("📌 Vehículo retenido y anclado en su última posición.")
        end
    end

    if _G.StopCarMovement then _G.StopCarMovement() end
    mainLoopThread = nil
end

