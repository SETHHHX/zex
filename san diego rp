-- Función principal que aplica el texto y la animación al personaje actual
local function setupNametag(character)
	-- Si había una animación corriendo del personaje anterior, la desconectamos
	if connection then
		connection:Disconnect()
		connection = nil
	end

	-- Buscar de forma segura los componentes dentro del nuevo personaje
	local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoidRootPart then return end
	
	local nametagGui = humanoidRootPart:WaitForChild("NametagGui", 10)
	if not nametagGui then return end
	
	local nameAndRank = nametagGui:WaitForChild("NameAndRank", 10)
	if not nameAndRank then return end
	
	local playerNameLabel = nameAndRank:WaitForChild("PlayerName", 10)
	local rankNameLabel = nameAndRank:WaitForChild("RankName", 10)
	
	if playerNameLabel and rankNameLabel then
		-- Asignar los textos
		playerNameLabel.Text = "ZEX HUB"
		rankNameLabel.Text = "gg/F4kWBQx4xA"
		
		-- Iniciar el ciclo de color para las etiquetas de este personaje
		connection = RunService.RenderStepped:Connect(function()
			local currentTime = tick()
			local hue = (currentTime * SPEED) % 1
			local rainbowColor = Color3.fromHSV(hue, 1, 1)
			
			playerNameLabel.TextColor3 = rainbowColor
			rankNameLabel.TextColor3 = rainbowColor
		end)
	end
end

