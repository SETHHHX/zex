    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        if not isAlive(p) then continue end
        if not isEnemy(p) then continue end
        local part = getTargetPart(p)
        if not part then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        local screen2D = Vector2.new(screenPos.X, screenPos.Y)
        if not onScreen then continue end
        if isInFOV(screen2D) then
            local dist = (screen2D - getScreenCenter()).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = p
            end
        end
    end
    return closest
end

local function createFOVCircle()
    if fovCircle then return end
    if not Drawing then return end
    fovCircle = Drawing.new("Circle")
    fovCircle.Visible = showFOV
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Thickness = 1.5
    fovCircle.Transparency = 1
    fovCircle.Filled = false
    fovCircle.NumSides = 64
    fovCircle.Radius = fovSize
    fovCircle.Position = getScreenCenter()
end

local function startFOVLoop()
    if fovLoop then fovLoop:Disconnect() end
    fovLoop = RunService.RenderStepped:Connect(function()
        if fovCircle then
            fovCircle.Radius = fovSize
            fovCircle.Position = getScreenCenter()
            fovCircle.Visible = showFOV
        end
    end)
end

local function startAimlock()
    if aimlockLoop then aimlockLoop:Disconnect(); aimlockLoop = nil end

    aimlockLoop = RunService.RenderStepped:Connect(function()
        if not aimlockEnabled or not aimlockTarget then return end
        if not isAlive(aimlockTarget) then
            aimlockTarget = nil
            return
        end

        local part = getTargetPart(aimlockTarget)
        if not part then aimlockTarget = nil; return end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then return end

        local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
        
        -- Obtener la sensibilidad actual de Roblox (por defecto suele ser 1, pero puede variar)
        local robloxSens = UserSettings():GetService("UserGameSettings").MouseSensitivity
        -- Factor de escala dinámico: a mayor sensibilidad del juego, reducimos el multiplicador
        local sensCompensation = math.clamp(1 / (robloxSens * 2), 0.05, 1)

        if stickyEnabled then
            local mousePos = UserInputService:GetMouseLocation()
            local mouseToTarget = targetScreen - Vector2.new(mousePos.X, mousePos.Y)
            
            -- Si ya está muy cerca del objetivo (Deadzone), dejamos de forzar para evitar el Jittering
            if mouseToTarget.Magnitude < 2 then return end

            local agression = math.clamp(mouseToTarget.Magnitude / 50, 1, 3)
            mousemoverel(
                mouseToTarget.X * smoothness * agression * sensCompensation,
                mouseToTarget.Y * smoothness * agression * sensCompensation
            )
        else
            local center = getScreenCenter()
            local delta = targetScreen - center
            
            -- Deadzone para aimlock común
            if delta.Magnitude < 2 then return end

            mousemoverel(
                delta.X * smoothness * sensCompensation, 
                delta.Y * smoothness * sensCompensation
            )
        end
    end)
end

local function stopAimlock()
    if aimlockLoop then aimlockLoop:Disconnect(); aimlockLoop = nil end
    aimlockTarget = nil
end

