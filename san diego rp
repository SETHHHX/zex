-- Función auxiliar para limpiar los dibujos de un jugador específico
local function RemoveESP(player)
    if Cache[player] then
        if Cache[player].Box then Cache[player].Box:Remove() end
        if Cache[player].Name then Cache[player].Name:Remove() end
        if Cache[player].HealthBar then Cache[player].HealthBar:Remove() end -- NUEVO
        if Cache[player].HealthText then Cache[player].HealthText:Remove() end -- NUEVO
        if Cache[player].Bones then
            for _, line in pairs(Cache[player].Bones) do
                line:Remove()
            end
        end
        Cache[player] = nil
    end
end

-- Limpieza automática si un jugador se va
Players.PlayerRemoving:Connect(RemoveESP)

-- Función para crear los elementos visuales en el caché
local function CreateESP(player)
    if Cache[player] then return end
    
    local lines = {}
    for i = 1, #R15Bones do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Visible = false
        table.insert(lines, line)
    end

    Cache[player] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HealthBar = Drawing.new("Square"), -- NUEVO
        HealthText = Drawing.new("Text"),  -- NUEVO
        Bones = lines
    }
    
    -- Configuración base de la caja
    Cache[player].Box.Thickness = 1.5
    Cache[player].Box.Filled = false
    Cache[player].Box.Color = Color3.fromRGB(255, 0, 0)
    Cache[player].Box.Visible = false

    -- Configuración base del nombre
    Cache[player].Name.Size = 16
    Cache[player].Name.Center = true
    Cache[player].Name.Outline = true
    Cache[player].Name.Color = Color3.fromRGB(255, 255, 255)
    Cache[player].Name.Visible = false

    -- NUEVO: Configuración base de la barra de vida
    Cache[player].HealthBar.Thickness = 1
    Cache[player].HealthBar.Filled = true
    Cache[player].HealthBar.Visible = false

    -- NUEVO: Configuración base del texto de vida
    Cache[player].HealthText.Size = 14
    Cache[player].HealthText.Center = true
    Cache[player].HealthText.Outline = true
    Cache[player].HealthText.Color = Color3.fromRGB(255, 255, 255)
    Cache[player].HealthText.Visible = false
end

