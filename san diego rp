function startAutoFarm()
    print("=" .. string.rep("=", 50))
    print("🚀 STARTING AUTO FARM")
    print("=" .. string.rep("=", 50))

    while AutoFarmRunning do
        local car = findMyVehicle()
        if not car then
            warn("❌ No vehicle found, searching...")
            currentStep = "no_vehicle"
            
            if AutoFarmRunning then
                print("🚗 Attempting to spawn vehicle...")
                spawnVehicle()
                task.wait(3)
            end
            continue
        end

        destroyVehicleWheels(car)
        
        local purchaseOk = doPurchase()
        if not AutoFarmRunning then break end
        if not purchaseOk then task.wait(1); continue end
        
        local sellOk = doSell()
        if not AutoFarmRunning then break end
        if not sellOk then task.wait(1); continue end
        
        local washOk = doWash()
        if not AutoFarmRunning then break end
        if not washOk then task.wait(1); continue end

        print("\n✅ === CYCLE COMPLETED SUCCESSFULLY ===\n")
        currentStep = "cycle_completed"
        task.wait(1)
    end

    print("🛑 AutoFarm stopped")
end

