        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HealthBar = Drawing.new("Square"), -- NUEVO
        HealthText = Drawing.new("Text"),  -- NUEVO
        Bones = lines
    }
    
    -- Configuración base de la caja
    Cache[player].Box.Thickness = 1.5
    Cache[player].Box.Filled = false
    Cache[player].Box.Color = Color3.fromRGB(255, 0, 0)
    Cache[player].Box.Visible = false

    -- Configuración base del nombre
    Cache[player].Name.Size = 16
    Cache[player].Name.Center = true
    Cache[player].Name.Outline = true
    Cache[player].Name.Color = Color3.fromRGB(255, 255, 255)
    Cache[player].Name.Visible = false

    -- NUEVO: Configuración base de la barra de vida
    Cache[player].HealthBar.Thickness = 1
    Cache[player].HealthBar.Filled = true
    Cache[player].HealthBar.Visible = false

    -- NUEVO: Configuración base del texto de vida
