-- 💀 DEATH DETECTION SYSTEM
-- =============================================
local function setupDeathDetection()
    player.CharacterAdded:Connect(function(character)
        if deathDetected and AutoFarmRunning then
            print("💀 Death detected! Respawning and restarting farm...")
            deathDetected = false
            
            if AutoFarmThread then
                pcall(task.cancel, AutoFarmThread)
                AutoFarmThread = nil
            end
            
            task.wait(2) -- Wait for character to fully load
            if not AutoFarmRunning then return end
            
            print("🔄 Respawning vehicle after death...")
            local spawnAttempts = 0
            local vehicleSpawned = false
            
            while spawnAttempts < 5 and not vehicleSpawned do
                if not AutoFarmRunning then return end
                spawnAttempts = spawnAttempts + 1
                print("🚗 Spawn attempt " .. spawnAttempts .. "/5...")
                
                if spawnVehicle() then
                    local waitStart = tick()
                    while tick() - waitStart < 20 do
                        if not AutoFarmRunning then return end
                        
                        if isPlayerInVehicle() then
                            local car = findMyVehicle()
                            if car then
                                print("✅ Player in vehicle after death! Restarting farm...")
                                vehicleSpawned = true
                                
                                task.wait(1)
                                currentStep = "restarted_after_death"
                                if AutoFarmThread then pcall(task.cancel, AutoFarmThread) end
                                AutoFarmThread = task.spawn(startAutoFarm)
                                return
                            end
                        end
                        task.wait(0.5)
                    end
                end
                
                if not vehicleSpawned then
                    print("⚠️ Spawn attempt " .. spawnAttempts .. " failed, retrying...")
                    task.wait(2)
                end
            end
            
            if not vehicleSpawned then
                warn("❌ Failed to spawn vehicle after death after 5 attempts")
                print("🔄 Performing full reset...")
                resetPlayerAndRestart("Death recovery failed")
            end
        end
    end)
    
    -- Monitor health for unexpected deaths
    task.spawn(function()
        while true do
            task.wait(1)
            if AutoFarmRunning and not stuckResetting then
                local character = player.Character
                local humanoid = character and character:FindFirstChild("Humanoid")
                
                if not character or not humanoid or humanoid.Health <= 0 then
                    if not deathDetected then
                        deathDetected = true
                        print("💀 WARNING: Player died unexpectedly! Waiting for respawn...")
                        travelActive = false
                        if activeMovementLoop then
                            activeMovementLoop:Disconnect()
                            activeMovementLoop = nil
                        end
                    end
                end
            end
        end
    end)
    
    print("🛡️ Death detection system active")
end

-- =============================================
-- 🔄 ANTI-STUCK SYSTEM (Reset on action failure)
-- =============================================

function resetPlayerAndRestart(reason)
    if stuckResetting then 
        print("⚠️ Already resetting, ignoring...")
        return 
    end
    
    stuckResetting = true
    print("=" .. string.rep("=", 50))
    print("🔄 RESETTING DUE TO STUCK: " .. reason)
    print("=" .. string.rep("=", 50))
    
    local wasRunning = AutoFarmRunning
    
    if wasRunning then
        stopAutoFarm()
        task.wait(1)
    end
    
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        print("💀 Killing character for reset...")
        player.Character.Humanoid.Health = 0
    end
    
    print("⏳ Waiting for respawn...")
    task.wait(4)
    
    local waitStart = tick()
    local characterReady = false
    
    while tick() - waitStart < 20 do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            if player.Character.Humanoid.Health > 0 then
                print("✅ Character respawned")
                characterReady = true
                break
            end
        end
        task.wait(0.5)
    end
    
    if not characterReady then
        warn("❌ Failed to respawn after 20 seconds")
        stuckResetting = false
        return
    end
    
    task.wait(2)
    
    if wasRunning then
        print("🔄 Restarting Auto Farm...")
        AutoFarmRunning = true
        
        print("🚗 Spawning new vehicle...")
        local spawnSuccess = spawnVehicle()
        
        if not spawnSuccess then
            warn("⚠️ Retrying spawn...")
            task.wait(2)
            spawnVehicle()
        end
        
        print("⏳ Waiting to enter vehicle...")
        local vehicleWaitStart = tick()
        local inVehicle = false
        
        while tick() - vehicleWaitStart < 35 do
            if isPlayerInVehicle() then
                local car = findMyVehicle()
                if car then
                    print("✅ In vehicle! Starting farm...")
                    inVehicle = true
                    break
                end
            end
            
            if tick() - vehicleWaitStart > 5 and not findMyVehicle() and tick() - vehicleWaitStart < 10 then
                print("🔄 Retrying vehicle spawn...")
                spawnVehicle()
            end
            
            task.wait(0.5)
        end
        
        if inVehicle then
            task.wait(1)
            currentStep = "reset_complete"
            if AutoFarmThread then pcall(task.cancel, AutoFarmThread) end
            AutoFarmThread = task.spawn(startAutoFarm)
        else
            warn("❌ Failed to get vehicle after reset")
            AutoFarmRunning = false
        end
    end
    
    stuckResetting = false
end

