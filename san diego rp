-- Tabla centralizada para guardar el estado de los toggles
local ESPConfig = {
    Master = false,
    TeamCheck = false,
    Names = false,
    Boxes = false,
    Bones = false,
    Health = false -- NUEVO: Estado del ESP de vida
}

-- Estructura para almacenar los objetos Drawing de cada jugador
