local function doPurchase()
    print("📦 === PHASE: PURCHASE ===")
    currentStep = "purchasing"
    
    for attempt = 1, MAX_RETRIES do
        if not AutoFarmRunning then return false end
        
        print("🛫 Traveling to purchase location... (Attempt " .. attempt .. "/" .. MAX_RETRIES .. ")")
        local travelOk = travelToLocation(BUY_POS, "Purchase Point")
        
        if not AutoFarmRunning then return false end
        if not travelOk then
            warn("⚠️ Travel to purchase failed")
            task.wait(1)
            continue
        end
        
        print("🛍️ Buying diamond rings... (Currently have " .. countDiamondRings() .. "/5)")
        local ringsNeeded = 5 - countDiamondRings()
        
        for i = 1, ringsNeeded do
            if not AutoFarmRunning then return false end
            local buyable = workspace:WaitForChild("WorldBuyableItems"):FindFirstChild("Fake Diamond Ring")
            if buyable then
                ReplicatedStorage:WaitForChild("__remotes"):WaitForChild("WorldBuyableItemService"):WaitForChild("PurchaseWorldBuyableItem"):FireServer(buyable)
                task.wait(0.5)
            end
        end
        
        task.wait(1)
        
        if countDiamondRings() >= 5 then
            print("✅ Purchase successful! 5 rings in inventory")
            return true
        end
        
        warn("⚠️ Purchase failed (Attempt " .. attempt .. "/" .. MAX_RETRIES .. "), have " .. countDiamondRings() .. "/5 rings")
    end
    
    print("❌ PURCHASE FAILED " .. MAX_RETRIES .. " TIMES. RESETTING...")
    task.spawn(function() resetPlayerAndRestart("Purchase failed " .. MAX_RETRIES .. " times") end)
    
    repeat task.wait(0.5) until not AutoFarmRunning or not stuckResetting
    return false
end

local function doSell()
    print("💰 === PHASE: SELL ===")
    currentStep = "selling"
    
    for attempt = 1, MAX_RETRIES do
        if not AutoFarmRunning then return false end
        
        if countDiamondRings() < 5 then
            print("⚠️ No rings to sell, returning to purchase...")
            return false
        end
        
        print("🛫 Traveling to sell location... (Attempt " .. attempt .. "/" .. MAX_RETRIES .. ")")
