local function getClosestPodium()
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local spawnersFolder = workspace:WaitForChild("VehicleSpawners")
    local closestPodium = nil
    local shortestDistance = math.huge
    
    for _, obj in ipairs(spawnersFolder:GetChildren()) do
        local targetPart = nil
        if obj:IsA("BasePart") then
            targetPart = obj
        elseif obj:IsA("Model") then
            targetPart = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        else
            targetPart = obj:FindFirstChildOfClass("BasePart")
        end
        
        if targetPart and targetPart.Position then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestPodium = obj
            end
        end
    end
    return closestPodium
end

function spawnVehicle()
    print("🚗 AutoSpawner: Searching for nearest podium...")
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        warn("❌ No character to spawn vehicle")
        return false
    end
    
    local podium = getClosestPodium()
    if podium then
        print("🎯 Podium found: " .. podium:GetFullName())
        local args = { podium, VEHICLE_MODEL }
        
        game:GetService("ReplicatedStorage")
            :WaitForChild("__remotes")
            :WaitForChild("VehicleSpawnerService")
            :WaitForChild("SpawnVehicleFromSpawner")
            :InvokeServer(unpack(args))
            
        print("✅ Spawn event sent successfully")
        return true
    else
        warn("❌ No podium found nearby")
        return false
    end
end

function isPlayerInVehicle()
    if not player.Character then return false end
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    if humanoid.SeatPart then
        local seatPart = humanoid.SeatPart
        local vehicleModel = seatPart:FindFirstAncestorOfClass("Model")
        if vehicleModel then
            local vehiclesFolder = workspace:FindFirstChild("Vehicles")
            if vehiclesFolder and vehicleModel:IsDescendantOf(vehiclesFolder) then
                return true
            end
        end
    end
    return false
end

local function destroyVehicleWheels(vehicleModel)
    if not vehicleModel then return end
    local wheelsFolder = vehicleModel:FindFirstChild("Wheels")
    if wheelsFolder then wheelsFolder:Destroy() end
    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if name:find("wheel") or name:find("knuckle") or name:find("antiroll") or name:find("steering") then
                part:Destroy()
            end
        end
    end
end

local function freezeInertia(vehicleModel)
    if not vehicleModel then return end
    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.Velocity = Vector3.zero
                part.RotVelocity = Vector3.zero
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

local function getAllParts(vehicleModel)
    local parts = {}
    if not vehicleModel then return parts end
    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then table.insert(parts, part) end
    end
    return parts
end

local function anchorVehicle(vehicleModel)
    if not vehicleModel then return end
    for _, part in ipairs(getAllParts(vehicleModel)) do
        part.Anchored = true
    end
end

local function unanchorVehicle(vehicleModel)
    if not vehicleModel then return end
    for _, part in ipairs(getAllParts(vehicleModel)) do
        part.Anchored = false
    end
end

local function calculatePathfindingRoute(startPos, endPos)
    local path = PathfindingService:CreatePath({
        AgentRadius = 5,
        AgentHeight = 5,
        AgentCanJump = false,
    })
    local success = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    if success and path.Status == Enum.PathStatus.Success then
        return path:GetWaypoints()
    else
        return nil
    end
end

