local function findMyVehicle()
    local vehiclesFolder = workspace:FindFirstChild("Vehicles")
    if not vehiclesFolder then return nil end
    for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
        local ownerIdProp = vehicle:FindFirstChild("OwnerUserId")
        local ownerIdValue = ownerIdProp and (ownerIdProp:IsA("ValueObject") and ownerIdProp.Value or ownerIdProp)
        if ownerIdValue == player.UserId or vehicle:GetAttribute("OwnerUserId") == player.UserId then
            return vehicle
        end
    end
    return nil
end

local function clearForces(vehicleModel)
    if not vehicleModel then return end
    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            for _, child in ipairs(part:GetChildren()) do
                if child.Name == "_DragForce" or child.Name == "_DragGyro" then
                    child:Destroy()
                end
            end
        end
    end
end

local function activatePlayerNoClip()
    local character = player.Character
    if not character then return end
    pcall(function()
        if not PhysicsService:IsCollisionGroupCreated(GROUP_NOCLIP_PLAYER) then
            PhysicsService:CreateCollisionGroup(GROUP_NOCLIP_PLAYER)
        end
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_PLAYER, "Default", false)
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_PLAYER, "Players", false)
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_PLAYER, GROUP_NOCLIP_PLAYER, false)
    end)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            originalPlayerState[part] = { CollisionGroup = part.CollisionGroup, CanCollide = part.CanCollide }
            part.CollisionGroup = GROUP_NOCLIP_PLAYER
            part.CanCollide = false
        end
    end
end

local function deactivatePlayerNoClip()
    local character = player.Character
    if not character then return end
    for part, data in pairs(originalPlayerState) do
        if part and part.Parent then
            part.CollisionGroup = data.CollisionGroup
            part.CanCollide = data.CanCollide
        end
    end
    originalPlayerState = {}
end

local function activateTotalNoClip(vehicleModel)
    if not vehicleModel then return end
    pcall(function()
        if not PhysicsService:IsCollisionGroupCreated(GROUP_NOCLIP_CAR) then
            PhysicsService:CreateCollisionGroup(GROUP_NOCLIP_CAR)
        end
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_CAR, GROUP_NOCLIP_CAR, false)
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_CAR, "Default", false)
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_CAR, "Players", false)
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_CAR, "Vehicle", false)
        PhysicsService:CollisionGroupSetCollidable(GROUP_NOCLIP_CAR, "World", false)
    end)
    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            if part:GetAttribute("OriginalCollisionGroup") == nil then
                part:SetAttribute("OriginalCollisionGroup", part.CollisionGroup)
            end
            part.CollisionGroup = GROUP_NOCLIP_CAR
            part.CanCollide = false
            if part:IsA("MeshPart") then
                part.Transparency = 0.3
                part.Material = Enum.Material.SmoothPlastic
            end
        end
    end
end

local function deactivateTotalNoClip(vehicleModel)
    if not vehicleModel then return end
    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            local originalGroup = part:GetAttribute("OriginalCollisionGroup")
            part.CollisionGroup = originalGroup or "Default"
            part.CanCollide = true
            if part:IsA("MeshPart") then
                part.Transparency = 0
                part.Material = Enum.Material.Plastic
            end
        end
    end
end

function stopAutoFarm()
    print("⏸️ Stopping AutoFarm...")
    AutoFarmRunning = false
    travelActive = false
    if activeMovementLoop then
        activeMovementLoop:Disconnect()
        activeMovementLoop = nil
    end
    
    -- 🛑 CRITICAL: Detener el hilo inmediatamente para evitar duplicados x2
    if AutoFarmThread then
        pcall(task.cancel, AutoFarmThread)
        AutoFarmThread = nil
    end
    
    local myCar = findMyVehicle()
    if myCar then
        clearForces(myCar)
        deactivateTotalNoClip(myCar)
        deactivatePlayerNoClip()
    end
    currentStep = "farm_stopped"
end

