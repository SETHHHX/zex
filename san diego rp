local function travelToLocation(targetPos, destinationName)
    local myCar = findMyVehicle()
    if not myCar then
        warn("❌ No vehicle found for travel to " .. destinationName)
        return false
    end

    destroyVehicleWheels(myCar)
    task.wait(0.2)

    local primaryPart = myCar:FindFirstChild("Root") or myCar.PrimaryPart or myCar:FindFirstChildOfClass("VehicleSeat")
    if not primaryPart then return false end

    reachedCurrentDestination = false
    travelActive = true

    local dragTargetPos = Vector3.new(targetPos.X, targetPos.Y + dragHeightOffset, targetPos.Z)
    local waypoints = calculatePathfindingRoute(primaryPart.Position, dragTargetPos)
    if not waypoints or #waypoints == 0 then
        waypoints = {{Position = primaryPart.Position}, {Position = dragTargetPos}}
    end

    clearForces(myCar)
    unanchorVehicle(myCar)
    activateTotalNoClip(myCar)
    activatePlayerNoClip()

    local parts = getAllParts(myCar)
    for _, part in ipairs(parts) do
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "_DragForce"
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = part

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "_DragGyro"
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.CFrame = part.CFrame
        bodyGyro.Parent = part
    end

    local currentWaypointIndex = 1
    local fixedHeight = dragTargetPos.Y

    if activeMovementLoop then activeMovementLoop:Disconnect() end
    activeMovementLoop = RunService.Stepped:Connect(function()
        if not myCar or not myCar.Parent or not travelActive or not AutoFarmRunning then
            if activeMovementLoop then activeMovementLoop:Disconnect(); activeMovementLoop = nil end
            return
        end

        freezeInertia(myCar)
        local currentPosition = primaryPart.Position
        local currentTarget = waypoints[currentWaypointIndex] or {Position = dragTargetPos}

        local destinationPoint = currentTarget.Position
        local planeDirection = Vector3.new(destinationPoint.X - currentPosition.X, 0, destinationPoint.Z - currentPosition.Z)

        if planeDirection.Magnitude < 8 and currentWaypointIndex < #waypoints then
            currentWaypointIndex = currentWaypointIndex + 1
            return
        end

        local finalDirection = Vector3.new(dragTargetPos.X - currentPosition.X, 0, dragTargetPos.Z - currentPosition.Z)
        if finalDirection.Magnitude < 6 or (currentWaypointIndex >= #waypoints and planeDirection.Magnitude < 6) then
            travelActive = false
            if activeMovementLoop then activeMovementLoop:Disconnect(); activeMovementLoop = nil end

            print("🎯 Arriving at " .. destinationName .. "...")
            local initialPos = primaryPart.Position
            local currentOrientation = primaryPart.CFrame.Rotation

            for i = 1, 15 do
                local alpha = i / 15
                local interpolatedPos = initialPos:Lerp(Vector3.new(targetPos.X, dragTargetPos.Y, targetPos.Z), alpha)
                freezeInertia(myCar)
                myCar:PivotTo(CFrame.new(interpolatedPos) * currentOrientation)
                task.wait(1/60)
            end

            local afterDragPos = primaryPart.Position
            for i = 1, 20 do
                local alpha = i / 20
                local risingPos = afterDragPos:Lerp(targetPos, alpha)
                freezeInertia(myCar)
                myCar:PivotTo(CFrame.new(risingPos) * currentOrientation)
                task.wait(1/60)
            end

            clearForces(myCar)
            freezeInertia(myCar)
            anchorVehicle(myCar)
            task.wait(0.05)

            myCar:PivotTo(CFrame.new(targetPos) * currentOrientation)
            task.wait(0.05)

            deactivateTotalNoClip(myCar)
            deactivatePlayerNoClip()
            task.wait(0.05)
            freezeInertia(myCar)

            reachedCurrentDestination = true
            print("✅ Arrived at " .. destinationName .. "!")
            return
        end

        local speed = planeDirection.Unit * dragSpeed
        for _, part in ipairs(parts) do
            local bv = part:FindFirstChild("_DragForce")
            if bv and bv:IsA("BodyVelocity") then bv.Velocity = speed end
            local bg = part:FindFirstChild("_DragGyro")
            if bg and bg:IsA("BodyGyro") then
                bg.CFrame = CFrame.lookAt(currentPosition, Vector3.new(destinationPoint.X, currentPosition.Y, destinationPoint.Z))
            end
        end

        local currentHeight = primaryPart.Position.Y
        local heightDifference = fixedHeight - currentHeight
        if math.abs(heightDifference) > 0.3 then
            local gradualCorrection = math.clamp(heightDifference, -3, 3)
            myCar:PivotTo(CFrame.new(0, gradualCorrection, 0) * myCar:GetPivot())
        end
    end)

    local safetyTime = 0
    repeat
        task.wait(0.5)
        safetyTime = safetyTime + 0.5
    until reachedCurrentDestination or safetyTime >= 35 or not AutoFarmRunning

    if not reachedCurrentDestination and AutoFarmRunning then
        if activeMovementLoop then activeMovementLoop:Disconnect(); activeMovementLoop = nil end
        travelActive = false

        -- 🛠️ FIX: Error de sintaxis corregido (+) por (..)
        print("⏰ Timeout, forcing arrival at " .. destinationName .. "...")
        local initialPos = primaryPart.Position
        local currentOrientation = primaryPart.CFrame.Rotation

        for i = 1, 15 do
            local alpha = i / 15
            local interpolatedPos = initialPos:Lerp(targetPos, alpha)
            freezeInertia(myCar)
            myCar:PivotTo(CFrame.new(interpolatedPos) * currentOrientation)
            task.wait(1/60)
        end

        clearForces(myCar)
        anchorVehicle(myCar)
        myCar:PivotTo(CFrame.new(targetPos) * currentOrientation)
        task.wait(0.1)
        deactivateTotalNoClip(myCar)
        deactivatePlayerNoClip()
        freezeInertia(myCar)
    end

    print("⏳ Waiting " .. ACTION_DELAY .. " seconds for position stabilization...")
    task.wait(ACTION_DELAY)
    
    return true
end

