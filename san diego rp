local function applyLowGraphics()
    print("🎮 Applying Low Graphics settings...")
    
    -- Lighting configuration
    pcall(function()
        Lighting.Brightness = 0
        Lighting.ClockTime = 12
        Lighting.FogEnd = 1000
        Lighting.FogStart = 0
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(150, 150, 150)
        Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
    end)
    
    -- Quality Settings configuration
    pcall(function()
        settings().Rendering.QualityLevel = 1 -- Lowest level
    end)
    
    -- Remove visual effects
    pcall(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
                v:Destroy()
            end
            if v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            end
            if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                v:Destroy()
            end
        end
    end)
    
    -- Disable shadows on all parts
    pcall(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CastShadow = false
            end
        end
    end)
    
    -- Configure Streaming (texture loading)
    pcall(function()
        workspace.StreamingEnabled = true
        workspace.StreamingMinRadius = 50
        workspace.StreamingPauseMode = Enum.StreamingPauseMode.Default
    end)
    
end

local function restoreGraphics()
    
    pcall(function()
        settings().Rendering.QualityLevel = 10 -- Maximum level
    end)
    
    pcall(function()
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
        workspace.StreamingEnabled = false
    end)
    
end

