local statsParagraph = mainSection:Paragraph({
    Header = "📊 Profit Tracker",
    Body = "Tracker stopped. Activate it to start measuring profits."
}, "FarmStatsParagraph")

local function updateStatistics()
    if not farmStartTime or not farmStartMoney then return end

    local currentMoney = getCurrentMoney()
    if not currentMoney then return end

    local elapsedTime = tick() - farmStartTime
    local totalProfit = currentMoney - farmStartMoney

    local profitPerHour = 0
    if elapsedTime > 1 then
        profitPerHour = (totalProfit / elapsedTime) * 3600
    end

    local statsText = string.format(
        "⏱️ Time: %s\n💰 Start: %s\n💵 Current: %s\n📈 Earned: %s\n🚀 Projection/hour: %s",
        formatTime(elapsedTime),
        formatMoney(farmStartMoney),
        formatMoney(currentMoney),
        formatMoney(totalProfit),
        formatMoney(profitPerHour)
    )

    if statsParagraph and statsParagraph.UpdateBody then
        statsParagraph:UpdateBody(statsText)
    end
end

local function startStatsTracker()
    statsTrackingActive = true
    farmStartTime = tick()
    farmStartMoney = getCurrentMoney() or 0
    print("📊 Tracker started - Initial money: " .. formatMoney(farmStartMoney))

    if statsParagraph and statsParagraph.UpdateHeader then
        statsParagraph:UpdateHeader("📊 Profit Tracker 🟢")
    end

    if statsThread then
        pcall(task.cancel, statsThread)
    end

    statsThread = task.spawn(function()
        while statsTrackingActive do
            updateStatistics()
            task.wait(1)
        end
    end)
end

local function stopStatsTracker()
    statsTrackingActive = false
    if statsThread then
        pcall(task.cancel, statsThread)
        statsThread = nil
    end

    if statsParagraph and statsParagraph.UpdateHeader then
        statsParagraph:UpdateHeader("📊 Profit Tracker 🔴")
    end

    if farmStartTime and farmStartMoney then
        local currentMoney = getCurrentMoney()
        if currentMoney then
            local totalTime = tick() - farmStartTime
            local totalProfit = currentMoney - farmStartMoney
            local profitPerHour = totalTime > 1 and (totalProfit / totalTime) * 3600 or 0

            local finalText = string.format(
                "🛑 Session ended\n⏱️ Duration: %s\n📈 Total profit: %s\n🚀 Average/hour: %s",
                formatTime(totalTime),
                formatMoney(totalProfit),
                formatMoney(profitPerHour)
            )
            if statsParagraph and statsParagraph.UpdateBody then
                statsParagraph:UpdateBody(finalText)
            end
        end
    end
    farmStartTime = nil
    farmStartMoney = nil
end

