local function getCurrentMoney()
    local success, result = pcall(function()
        local moneyLabel = player.PlayerGui.MainHUDGui.TopRight.Money.TextLabel
        local text = moneyLabel.Text
        local cleanNumber = text:gsub("%$", ""):gsub(",", "")
        return tonumber(cleanNumber)
    end)
    if success and result then
        return result
    end
    return nil
end

local function formatMoney(amount)
    if not amount then return "$0" end
    local formatted = tostring(math.floor(amount))
    local isNegative = formatted:sub(1,1) == "-"
    if isNegative then formatted = formatted:sub(2) end

    local k
    while true do
        formatted, k = formatted:gsub("^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end

    return (isNegative and "-$" or "$") .. formatted
end

local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)

    if hours > 0 then
        return string.format("%dh %dm %ds", hours, minutes, secs)
    elseif minutes > 0 then
        return string.format("%dm %ds", minutes, secs)
    else
        return string.format("%ds", secs)
    end
end

