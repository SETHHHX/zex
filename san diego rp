-- Conexiones de huesos para R15 (las más comunes)
local R15Bones = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

-- Función auxiliar para limpiar los dibujos de un jugador específico
local function RemoveESP(player)
    if Cache[player] then
        if Cache[player].Box then Cache[player].Box:Remove() end
        if Cache[player].Name then Cache[player].Name:Remove() end
        if Cache[player].HealthBar then Cache[player].HealthBar:Remove() end -- NUEVO
        if Cache[player].HealthText then Cache[player].HealthText:Remove() end -- NUEVO
        if Cache[player].Bones then
            for _, line in pairs(Cache[player].Bones) do
                line:Remove()
            end
        end
        Cache[player] = nil
    end
end

-- Limpieza automática si un jugador se va
Players.PlayerRemoving:Connect(RemoveESP)

-- Función para crear los elementos visuales en el caché
local function CreateESP(player)
    if Cache[player] then return end
    
    local lines = {}
    for i = 1, #R15Bones do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Visible = false
        table.insert(lines, line)
    end

