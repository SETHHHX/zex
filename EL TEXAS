-- Obtener el vehículo actual si estás sentado en uno
local function getActualVehicle()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    
    local seat = humanoid.SeatPart
    if seat then
        local parent = seat.Parent
        while parent do
            if parent:IsA("Model") and (parent:GetAttribute("Owner") ~= nil or parent:FindFirstChild("DriveSeat")) then
                return parent
            end
            parent = parent.Parent
        end
    end
    return nil
end

-- ===== FUNCIÓN DE ARRASTRE ADAPTADA (TU MÉTODO EFECTIVO) =====
local function viajarA(targetPos)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not _G.AutoFarmContrabando or not humanoid then return end
    runningMovement = true
    if currentFreezeConnection then currentFreezeConnection:Disconnect() end
    
    local seat = humanoid.SeatPart
    if not seat then
        runningMovement = false
        return
    end
    
    local vehicle = getActualVehicle()
    if not vehicle then runningMovement = false return end
    
    local r = vehicle:FindFirstChild("Root") or vehicle.PrimaryPart
    if not r then runningMovement = false return end
    
    -- Eliminar ruedas para evitar fricción si el juego usa un sistema similar al Camry6
    local wheelsModel = vehicle:FindFirstChild("Wheels")
    if wheelsModel then wheelsModel:Destroy() end
    
    for _, part in ipairs(vehicle:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.AssemblyLinearVelocity = Vector3.new(0,0,0)
            part.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end
    r.Anchored = false
    task.wait(0.05)
    
    -- Noclip del vehículo y personaje durante el arrastre
    local noclipConnection
    noclipConnection = game:GetService("RunService").Stepped:Connect(function()
        if not runningMovement or not _G.AutoFarmContrabando or not vehicle or not vehicle.Parent then 
            if noclipConnection then noclipConnection:Disconnect() end 
            return 
        end
        
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
    
    local llego = false
    local heartbeatConnection
    
    heartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not runningMovement or not _G.AutoFarmContrabando or not r or not r.Parent then 
            if heartbeatConnection then heartbeatConnection:Disconnect() end 
            return 
        end
        
        local pos = r.Position
        local dir = targetPos - pos
        local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
        
        -- Verificar llegada
        if dist < DISTANCIA_LLEGADA then
            runningMovement = false
            if heartbeatConnection then heartbeatConnection:Disconnect() end
            if noclipConnection then noclipConnection:Disconnect() end
            
            r.CFrame = CFrame.new(targetPos)
            
            -- Mantener congelado en la posición final para interactuar de forma segura
            currentFreezeConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if runningMovement or not _G.AutoFarmContrabando or not r or not r.Parent then 
                    if currentFreezeConnection then currentFreezeConnection:Disconnect() end 
                    return 
                end
                r.CFrame = CFrame.new(targetPos)
                r.AssemblyLinearVelocity = Vector3.new(0,0,0)
                r.AssemblyAngularVelocity = Vector3.new(0,0,0)
            end)
            llego = true
            return
        end
        
        -- Mantener el vehículo pegado al suelo usando Raycast
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {vehicle, character}
        local ray = workspace:Raycast(pos + Vector3.new(0,15,0), Vector3.new(0,-50,0), raycastParams)
        if ray then
            r.CFrame = CFrame.new(Vector3.new(pos.X, ray.Position.Y + 2.5, pos.Z))
        else
            r.CFrame = CFrame.new(Vector3.new(pos.X, math.max(pos.Y, targetPos.Y - 3), pos.Z))
        end
        
        -- Cálculo de velocidad y suavizado de frenado
        local currentSpeed = (dist > FRENADO_INICIO) and MAX_SPEED or math.max(FRENADO_MINIMO, MAX_SPEED * (dist / FRENADO_INICIO))
        local moveDir = Vector3.new(dir.X, 0, dir.Z).Unit
        if moveDir.Magnitude == 0 then moveDir = Vector3.new(1, 0, 0) end
        
        r.AssemblyLinearVelocity = moveDir * currentSpeed
        r.CFrame = CFrame.lookAt(r.Position, r.Position + moveDir)
        r.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end)
    
    repeat 
        task.wait(0.1) 
    until llego or not runningMovement or not _G.AutoFarmContrabando or (humanoid and humanoid.Health <= 0)
end

-- Función para contar artículos en la mochila
local function getItemCount(itemName)
    local count = 0
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item.Name == itemName then
                count = count + 1
            end
        end
    end
    return count
end

