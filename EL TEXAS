-- 🔥 FUNCIÓN PARA ACTUALIZAR ESTADÍSTICAS (MEJORADA)
local function updateStatistics()
    if not farmStartTime or not farmStartMoney then return end

    local currentMoney = getCurrentMoney()
    if not currentMoney then return end

    local elapsedTime = tick() - farmStartTime
    local totalProfit = currentMoney - farmStartMoney
    
    -- Guardar historial
    table.insert(moneyHistory, currentMoney)
    if #moneyHistory > maxHistory then
        table.remove(moneyHistory, 1)
    end

    -- Calcular proyecciones
    local profitPerHour = 0
    local profitPerMinute = 0
    local profitPerSecond = 0
    
    if elapsedTime > 1 then
        profitPerSecond = totalProfit / elapsedTime
        profitPerMinute = profitPerSecond * 60
        profitPerHour = profitPerSecond * 3600
    end

    -- Calcular progreso (basado en proyección)
    local progressPercent = 0
    if profitPerHour > 0 and elapsedTime > 60 then
        local expectedProfit = (profitPerHour / 3600) * elapsedTime
        if expectedProfit > 0 then
            progressPercent = math.min((totalProfit / expectedProfit) * 100, 100)
        end
    end
    
    local progressBar = createProgressBar(progressPercent)

    -- 🔥 TEXTO MEJORADO CON MÁS INFORMACIÓN
    local statsText = string.format(
        [[
<font color="#00FF00">⏱️ Time:</font> <font color="#FFFFFF">%s</font>
<font color="#FFD700">💰 Start:</font> <font color="#FFFFFF">%s</font>
<font color="#00BFFF">💵 Current:</font> <font color="#FFFFFF">%s</font>
<font color="#00FF00">📈 Earned:</font> <font color="#FFFFFF">%s</font>
<font color="#FF6B6B">🚀 /hour:</font> <font color="#FFD700">%s</font>
<font color="#FF69B4">📊 /minute:</font> <font color="#FFFFFF">%s</font>
        ]],
        formatTime(elapsedTime),
        formatMoney(farmStartMoney),
        formatMoney(currentMoney),
        formatMoney(totalProfit),
        formatMoney(profitPerHour),
        formatMoney(profitPerMinute),
        formatMoney(profitPerSecond),
        progressBar,
        progressPercent
    )

    if statsParagraph and statsParagraph.UpdateBody then
        statsParagraph:UpdateBody(statsText)
    end
    
    -- 🔥 GUARDAR ÚLTIMO DINERO PARA DETECTAR CAMBIOS
    lastMoney = currentMoney
end

-- 🔥 FUNCIÓN PARA INICIAR TRACKER
local function startStatsTracker()
    statsTrackingActive = true
    farmStartTime = tick()
    farmStartMoney = getCurrentMoney() or 0
    lastMoney = farmStartMoney
    moneyHistory = {}
    
    print("📊 Tracker started - Initial money: " .. formatMoney(farmStartMoney))

    if statsParagraph and statsParagraph.UpdateHeader then
        statsParagraph:UpdateHeader("📊 Profit Tracker 🟢")
    end

    if statsThread then
        pcall(task.cancel, statsThread)
    end

    statsThread = task.spawn(function()
        while statsTrackingActive do
            updateStatistics()
            task.wait(1)
        end
    end)
end

-- 🔥 FUNCIÓN PARA DETENER TRACKER
local function stopStatsTracker()
    statsTrackingActive = false
    if statsThread then
        pcall(task.cancel, statsThread)
        statsThread = nil
    end

    if statsParagraph and statsParagraph.UpdateHeader then
        statsParagraph:UpdateHeader("📊 Profit Tracker 🔴")
    end

    if farmStartTime and farmStartMoney then
        local currentMoney = getCurrentMoney()
        if currentMoney then
            local totalTime = tick() - farmStartTime
            local totalProfit = currentMoney - farmStartMoney
            local profitPerHour = totalTime > 1 and (totalProfit / totalTime) * 3600 or 0
            local profitPerMinute = totalTime > 1 and (totalProfit / totalTime) * 60 or 0

            local finalText = string.format(
                [[
<font color="#FF6B6B">🛑 SESSION ENDED</font>

<font color="#00FF00">⏱️ Duration:</font> <font color="#FFFFFF">%s</font>
<font color="#00FF00">📈 Total profit:</font> <font color="#FFFFFF">%s</font>
<font color="#FFD700">🚀 Average/hour:</font> <font color="#FFFFFF">%s</font>
<font color="#FF69B4">📊 Average/min:</font> <font color="#FFFFFF">%s</font>
                ]],
                formatTime(totalTime),
                formatMoney(totalProfit),
                formatMoney(profitPerHour),
                formatMoney(profitPerMinute)
            )
            
            if statsParagraph and statsParagraph.UpdateBody then
                statsParagraph:UpdateBody(finalText)
            end
        end
    end
    farmStartTime = nil
    farmStartMoney = nil
    moneyHistory = {}
end

