-- Variable global para controlar que no se dupliquen los bucles RGB al revivir
local currentRgbLoop = nil

-- Función principal que aplica los cambios y el efecto RGB
local function aplicarOverheadZexHub()
    -- Detener el bucle anterior si existía para no causar lag de hilos
    if currentRgbLoop then 
        task.cancel(currentRgbLoop) 
        currentRgbLoop = nil
    end

    -- Esperar a que aparezca la nueva carpeta del Overhead tras el reset
    local overheadNameFolder = playerGui:WaitForChild("Overhead_" .. userName, 10)
    if not overheadNameFolder then return end
    
    local playerNameLabel = overheadNameFolder:WaitForChild("PlayerName", 5)
    local playerTeamLabel = overheadNameFolder:WaitForChild("PlayerTeam", 5)

    -- 1. Aplicar el link de Discord al Equipo
    if playerTeamLabel and playerTeamLabel:IsA("TextLabel") then
        playerTeamLabel.Text = "discord.gg/zexhub"
    end

    -- 2. Aplicar "Zex Hub" y arrancar el ciclo RGB
    if playerNameLabel and playerNameLabel:IsA("TextLabel") then
        playerNameLabel.Text = "Zex Hub"
        
        -- Guardar el nuevo hilo para poder apagarlo en el próximo reset
        currentRgbLoop = task.spawn(function()
            local h = 0
            while true do
                h = h + 0.005
                if h >= 1 then h = 0 end
                
                playerNameLabel.TextColor3 = Color3.fromHSV(h, 1, 1)
                RunService.RenderStepped:Wait()
            end
        end)
    end
end

