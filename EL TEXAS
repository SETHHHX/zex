            local firstLetter = string.upper(string.sub(text, 1, 1))
            
            -- Buscamos dinámicamente el Enum.KeyCode que empareje con esa letra
            local success, newKey = pcall(function()
                return Enum.KeyCode[firstLetter]
            end)
            
            if success and newKey then
                activationKey = newKey
                print("🔑 Keybind cambiada con éxito a: " .. tostring(newKey.Name))
            else
                print("⚠️ Entrada inválida, no se pudo mapear a una tecla.")
            end
        end
    end
}) -- Sin Flag final para total seguridad










