            -- 🔥 MODIFICAR SOLO LA MUNICIÓN (menos detectable)
            config.Ammo = 99999
            config.StoredAmmo = 99999
            config.MaxStoredAmmo = 99999
            config.AmmoInGun = 99999
            
            -- 🔥 RECONSTRUIR EL SCRIPT CON LOS NUEVOS VALORES
            local newConfig = {}
            for key, value in pairs(config) do
                newConfig[key] = value
            end
            
            -- Convertir a string
            local function serializeTable(tbl, indent)
                indent = indent or 1
                local result = "{\n"
                for key, value in pairs(tbl) do
                    local indentStr = string.rep("\t", indent)
                    if type(key) == "string" then
                        result = result .. indentStr .. "[\"" .. key .. "\"] = "
                    else
                        result = result .. indentStr .. "[" .. key .. "] = "
                    end
                    
                    if type(value) == "table" then
                        result = result .. serializeTable(value, indent + 1)
                    elseif type(value) == "string" then
                        result = result .. "\"" .. value .. "\""
                    elseif type(value) == "number" then
                        result = result .. tostring(value)
                    elseif type(value) == "boolean" then
                        result = result .. tostring(value)
                    else
                        result = result .. "nil"
                    end
                    result = result .. ",\n"
                end
                result = result .. string.rep("\t", indent - 1) .. "}"
                return result
            end
            
            local newSource = "return " .. serializeTable(newConfig)
            gunSettings.Source = newSource
            
            return true
        end

