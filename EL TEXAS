            }

            -- 2. Función interna para verificar si un modelo es un carro activo o un jugador
            local function esUnCarroActivo(objeto)
                if not objeto:IsA("Model") then return false end
                if game.Players:FindFirstChild(objeto.Name) then return true end
                
                local seat = objeto:FindFirstChildOfClass("VehicleSeat") or objeto:FindFirstChild("DriveSeat")
                if seat and seat.Occupant then return true end
                if objeto:GetAttribute("Owner") ~= nil then return true end
                
                return false
            end

            -- 3. Optimizar rendimiento de renderizado base
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            game:GetService("Lighting").GlobalShadows = false
            
            -- Recorrer la raíz del Workspace y borrar lo pesado
            for _, objeto in ipairs(workspace:GetChildren()) do
                if OBJETOS_SAGRADOS[objeto] then continue end
                if esUnCarroActivo(objeto) then continue end
                
                if objeto:IsA("Folder") or objeto:IsA("Model") or objeto:IsA("BasePart") then
                    objeto:Destroy()
                end
            end
            
            -- 4. Limpieza interna de texturas y efectos en los sobrevivientes
            for _, descendiente in ipairs(workspace:GetDescendants()) do
                local esHijoProtegido = false
                for objetoSagrado, _ in pairs(OBJETOS_SAGRADOS) do
                    if objetoSagrado and descendiente:IsDescendantOf(objetoSagrado) then
                        esHijoProtegido = true
                        break
                    end
                end
                
                if not esHijoProtegido then
                    if descendiente:IsA("PostEffect") or descendiente:IsA("Explosion") or descendiente:IsA("Sparkles") or descendiente:IsA("Smoke") or descendiente:IsA("Fire") then
                        descendiente:Destroy()
                    elseif descendiente:IsA("Texture") or descendiente:IsA("Decal") then
                        descendiente:Destroy()
                    elseif descendiente:IsA("BasePart") then
                        descendiente.CastShadow = false
                    end
                end
            end
            
            print("✨ ¡Low Graphics Activado! Mapa optimizado al extremo.")
