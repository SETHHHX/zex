----------------------------------------------------
local function autoTeleportToMap()
    -- Prioridad MÁXIMA: si hay notificación visible, ir a Lobby SIN cooldown
    local wantLobby = isGamemodeNotificationVisible()
    if wantLobby then
        local currentMap = getCurrentMap()
        if currentMap ~= "Lobby" then
            lastTeleport = 0
            fireMapsTeleport("Lobby")
            notify("Map", "Emergency TP to Lobby", 2)
            lastTeleport = tick()
        end
        return
    end

    -- Cooldown normal para el resto
    if tick() - lastTeleport < Settings.TeleportCooldown then return end
    if isLoadingGamemode() then return end

    local inGM = isInGamemode()
    if inGM then return end

    local currentMap = getCurrentMap()
    if not currentMap then return end

    local targetMap = Settings.Map
    if not Settings.Enabled and not Settings.StarsEnabled then return end
    if currentMap == targetMap then return end

    lastTeleport = tick()
    fireMapsTeleport(targetMap)
    notify("Map", "Teleporting to "..targetMap, 2)
end

