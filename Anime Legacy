--[[
====================================================
  RAINBOW NAME CHANGER
  Cambia el texto + efecto rainbow en loop
  Ruta: workspace.<jugador>.Head.Player.Main.UserName
====================================================
]]

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- ============ CONFIGURACIÓN ============
local NEW_NAME      = "@ZEX HUB"   -- ← texto a mostrar
local RAINBOW_SPEED = 1.0               -- ← velocidad (1 = normal, 0.5 = lento, 2 = rápido)
-- ========================================

local startTime = tick()

-- Función que encuentra el TextLabel del UserName
local function getUserNameLabel()
    local char = LocalPlayer.Character
    if not char then return nil end

    local head = char:FindFirstChild("Head")
    if not head then return nil end

    local playerFolder = head:FindFirstChild("Player")
    if not playerFolder then return nil end

    local main = playerFolder:FindFirstChild("Main")
    if not main then return nil end

    local userName = main:FindFirstChild("UserName")
    if not userName then return nil end

    -- El UserName puede ser un TextLabel o un Frame con TextLabel dentro
    if userName:IsA("TextLabel") then
        return userName
    elseif userName:IsA("GuiObject") then
        local label = userName:FindFirstChildWhichIsA("TextLabel")
        if label then return label end
    end

    return nil
end

-- Loop principal
local connection = RunService.RenderStepped:Connect(function()
    local label = getUserNameLabel()
    if not label then return end

    -- 1. Asegurar el texto
    if label.Text ~= NEW_NAME then
        label.Text = NEW_NAME
    end

    -- 2. Aplicar color rainbow
    local elapsed = (tick() - startTime) * RAINBOW_SPEED
    local hue = (elapsed % 5) / 5  -- cicla cada 5 segundos (0.2 Hz)
    label.TextColor3 = Color3.fromHSV(hue, 1, 1)

    -- Opcional: quitar el UIGradient si el juego lo está sobrescribiendo
    local gradient = label:FindFirstChildOfClass("UIGradient")
    if gradient and gradient.Enabled then
        gradient.Enabled = false
    end
end)


--[[
====================================================
  ANTI-AFK v2 - Simula movimiento del mouse
  Reset del timer de AFK de Roblox.
====================================================
]]

local Players           = game:GetService("Players")
local VirtualUser       = game:GetService("VirtualUser")
local UserInputService  = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local INTERVAL = 10 * 60  -- 10 minutos

local function simulateActivity()
    -- Método 1: VirtualUser (el más potente, disponible en casi todos los executors)
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)

    -- Método 2: Simular tecla Shift (que no afecta el movimiento del personaje)
    pcall(function()
        local VirtualInputManager = game:GetService("VirtualInputManager")
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end)

    -- Método 3: Simular movimiento del mouse via InputObject
    pcall(function()
        local mouse = LocalPlayer:GetMouse()
        if mouse then
            local randomX = math.random(0, 100)
            local randomY = math.random(0, 100)
            mouse.X = randomX
            mouse.Y = randomY
        end
    end)
end

-- Actividad inmediata
task.wait(2)
simulateActivity()

-- Loop cada INTERVAL
task.spawn(function()
    while true do
        task.wait(INTERVAL)
        simulateActivity()
    end
end)



