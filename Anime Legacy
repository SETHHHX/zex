local function fireBridge(payload)
    pcall(function()
        local args = {
            {
                {
                    "\001",
                    "n.U\183\190\158DU\171u\025\193\b\026\"\174",
                    payload
                },
                "\002"
            }
        }
        ReplicatedStorage
            :WaitForChild("BridgeNet")
            :WaitForChild("dataRemoteEvent")
            :FireServer(unpack(args))
    end)
end

local function invokeBridge(payload)
    local ok, result = pcall(function()
        local args = {
            {
                {
                    "\001",
                    "n.U\183\190\158DU\171u\025\193\b\026\"\174",
                    payload
                },
                "\002"
            }
        }
        return ReplicatedStorage
            :WaitForChild("BridgeNet")
            :WaitForChild("dataRemoteEvent")
            :InvokeServer(unpack(args))
    end)
    if ok then return result end
    return nil
end

