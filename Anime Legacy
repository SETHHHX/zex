local function findGamemodeNotification(namePrefix, diff)
    local PlayerGui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then return nil end

    local notifGui = PlayerGui:FindFirstChild("Notifications")
    if not notifGui then return nil end

    local list = notifGui:FindFirstChild("List")
    if not list then return nil end

    local prefix = "GamemodeNotification_" .. namePrefix

    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("Frame") and string.find(child.Name, prefix, 1, true) then
            if string.find(child.Name, diff, 1, true) then
                return child
            end
        end
    end

    return nil
end

local function isGamemodeNotificationVisible()
    if Settings.TrialJoin and findGamemodeNotification("Trial", Settings.TrialDiff) then
        return true
    end
    if Settings.DungeonJoin and findGamemodeNotification("Dungeon", Settings.DungeonDiff) then
        return true
    end
    return false
end

