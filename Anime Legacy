        notify("Config", ok and ("Loaded: "..name) or "Not found", 3)
    end
})
ConfigsModule:create_button({
    title = "Delete Config",
    callback = function()
        local name = selectedConfig or configName
        if not name or name == "" then return end
        Library:DeleteConfig(name)
        notify("Config", "Deleted: "..name, 3)
    end
})

