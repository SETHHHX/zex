local function getSessionProgress()
    local Omni = getOmni()
    if not Omni or not Omni.Data then return nil end
    local gm      = Omni.Data.Gamemode
    local session = Omni.Data.GamemodeSession
    if not gm or not session then return nil end
    local StateManager = getStateManager()
    if not StateManager then return nil end
    local maps = workspace:FindFirstChild("Client") and workspace.Client:FindFirstChild("Maps")
    if not maps then return nil end
    local mapFolder = maps:FindFirstChild(gm)
    if not mapFolder then return nil end
    local sessions = mapFolder:FindFirstChild("GamemodeSessions")
    if not sessions then return nil end
    local holder = sessions:FindFirstChild(session)
    if not holder then return nil end
    local sm = StateManager.Get(holder)
    if not sm then return nil end
    return {
        Gamemode     = gm,
        Wave         = sm:GetState("CurrentWave")     or 0,
        RoomsCleared = sm:GetState("RoomsCleared")    or 0,
        TotalRooms   = sm:GetState("TotalGatedRooms") or 0,
        WaveTotal    = sm:GetState("WaveTotal")       or 0,
    }
end

