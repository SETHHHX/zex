local function getDungeonMapFolder()
    local Omni = getOmni()
    if not Omni or not Omni.Data then return nil end
    local gm = Omni.Data.Gamemode
    if not gm or gm == "" then return nil end
    local maps = workspace:FindFirstChild("Client") and workspace.Client:FindFirstChild("Maps")
    if not maps then return nil end
    local mapObj = maps:FindFirstChild(gm)
    if not mapObj then return nil end
    return mapObj:FindFirstChild("Map")
end

local function findAnyDoorPrompt(mapFolder)
    if not mapFolder then return nil, nil end
    for _, room in ipairs(mapFolder:GetChildren()) do
        local doors = room:FindFirstChild("Doors")
        if doors then
            for _, door in ipairs(doors:GetChildren()) do
                local openDoor = door:FindFirstChild("OpenDoor")
                if openDoor and openDoor:IsA("ProximityPrompt") and openDoor.Enabled then
                    return openDoor, door
                end
            end
        end
    end
    return nil, nil
end

local function getDoorPosition(door)
    if not door then return nil end
    if door:IsA("BasePart") then return door.Position end
    local part = door:FindFirstChildWhichIsA("BasePart")
    if part then return part.Position end
    local od = door:FindFirstChild("OpenDoor")
    if od then
        if od:IsA("BasePart") then return od.Position end
        local odPart = od:FindFirstChildWhichIsA("BasePart")
        if odPart then return odPart.Position end
    end
    return nil
end

local function isOnGround()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return hum.FloorMaterial ~= Enum.Material.Air
end

local function firePromptProperly(pp)
    pcall(function()
        local hold = pp.HoldDuration or 0
        pp:InputHoldBegin()
        task.wait(hold + 0.05)
        pp:InputHoldEnd()
    end)
end

local function tryOpenDungeonDoor()
    if tick() - lastDoorOpen < 2 then return end

    local inGM, gmName = isInGamemode()
    if not inGM or not gmName or not string.find(gmName, "Dungeon") then return end

    local hrp = getHRP()
    if not hrp then return end

    local mapFolder = getDungeonMapFolder()
    if not mapFolder then return end

    local pp, door = findAnyDoorPrompt(mapFolder)
    if not pp or not door then return end

    local doorPos = getDoorPosition(door)
    if not doorPos then return end

    local dist = (hrp.Position - doorPos).Magnitude

    if dist > 6 then
        hrp.CFrame = CFrame.new(doorPos + Vector3.new(0, 3, 2))
        task.wait(0.6)
    end

    local waited = 0
    while not isOnGround() and waited < 2 do
        task.wait(0.1)
        waited = waited + 0.1
    end

    local pp2 = findAnyDoorPrompt(mapFolder)
    if not pp2 then
        lastDoorOpen = tick()
        return
    end

    local ppParent = pp2.Parent
    local ppPos = nil
    if ppParent and ppParent:IsA("BasePart") then
        ppPos = ppParent.Position
    else
        local part = ppParent and ppParent:FindFirstChildWhichIsA("BasePart")
        if part then ppPos = part.Position end
    end

    if ppPos then
        local ppDist = (hrp.Position - ppPos).Magnitude
        local maxDist = pp2.MaxActivationDistance or 10
        if ppDist > maxDist then
            hrp.CFrame = CFrame.new(ppPos + Vector3.new(0, 3, 2))
            task.wait(0.6)
        end
    end

    lastDoorOpen = tick()
    firePromptProperly(pp2)
end

