local function worldFarmLoop()
    if not Settings.Enabled then return end
    if isLoadingGamemode() then return end

    local currentMap = getCurrentMap()
    if currentMap == "Lobby" then return end

    local hrp = getHRP()
    if not hrp then return end

    updateStarsCooldown()
    if tryStarsInterleaved() then return end

    local enemies = filterBySelected(getWorldEnemies())
    if not enemies or #enemies == 0 then
        worldTarget   = nil
        worldHitCount = 0
        return
    end

    if worldTarget then
        local alive = false
        for _, e in ipairs(enemies) do
            if e.ID == worldTarget.ID and isEnemyAlive(e) then
                worldTarget = e; alive = true; break
            end
        end
        if not alive then worldTarget = nil; worldHitCount = 0 end
    end

    if not worldTarget then
        worldTarget   = chooseClosest(enemies, hrp.Position)
        worldHitCount = 0
    end
    if not worldTarget then return end

    teleportTo(worldTarget.Position)
    doAttack()
    worldHitCount = worldHitCount + 1

    if checkAndBlacklist(worldTarget, worldHitCount) then
        worldTarget   = nil
        worldHitCount = 0
    end
end

----------------------------------------------------
-- GM KILL LOOP
----------------------------------------------------
local function gmKillLoop()
    if not Settings.GMKill then return end
    if isLoadingGamemode() then return end

    local hrp = getHRP()
    if not hrp then return end

    local enemies = getGamemodeEnemies()
    if not enemies or #enemies == 0 then
        gmTarget       = nil
        gmHitCount     = 0
        gmTargetHealth = 0
        gmTargetStart  = 0
        tryOpenDungeonDoor()
        return
    end

    if gmTarget then
        local stillValid = false
        for _, e in ipairs(enemies) do
            if e.ID == gmTarget.ID and e.Instance == gmTarget.Instance and isEnemyAlive(e) then
                gmTarget = e
                stillValid = true
                break
            end
        end

        if not stillValid then
            local inst = gmTarget.Instance
            local reallyDead = false
            if not inst or not inst.Parent then reallyDead = true
            elseif inst:GetAttribute("Died") == true then reallyDead = true
            else
                local hum = inst:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then reallyDead = true end
            end

            if reallyDead or (not inst or not inst.Parent) then
                blacklist(gmTarget.ID)
                gmTarget       = nil
                gmHitCount     = 0
                gmTargetHealth = 0
                gmTargetStart  = 0
            end
        end
    end

    if not gmTarget then
        local newTarget = chooseClosest(enemies, hrp.Position)
        if newTarget then
            gmTarget   = newTarget
            gmHitCount = 0
            local hum = newTarget.Instance:FindFirstChildOfClass("Humanoid")
            gmTargetHealth = hum and hum.Health or 0
            gmTargetStart  = tick()
        end
    end
    if not gmTarget then return end

    if not isEnemyAlive(gmTarget) then
        blacklist(gmTarget.ID)
        gmTarget       = nil
        gmHitCount     = 0
        gmTargetHealth = 0
        gmTargetStart  = 0
        return
    end

    local elapsed = tick() - gmTargetStart
    if elapsed > 15 then
        local hum = gmTarget.Instance:FindFirstChildOfClass("Humanoid")
        local currentHealth = hum and hum.Health or 0
        if currentHealth >= gmTargetHealth then
            blacklist(gmTarget.ID)
            gmTarget       = nil
            gmHitCount     = 0
            gmTargetHealth = 0
            gmTargetStart  = 0
            return
        else
            gmTargetHealth = currentHealth
            gmTargetStart  = tick()
        end
    end

    teleportTo(gmTarget.Position)
    doAttack()
    gmHitCount = gmHitCount + 1

    local hum = gmTarget.Instance:FindFirstChildOfClass("Humanoid")
    if hum then
        gmTargetHealth = math.min(gmTargetHealth, hum.Health)
    end
end

