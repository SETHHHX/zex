local function getEnemyUtils()
    local ok, mod = pcall(function() return require(ReplicatedStorage.Omni.Utils.Enemies) end)
    return ok and mod or nil
end

local function getWorldEnemies()
    local list = {}
    for _, inst in ipairs(CollectionService:GetTagged("Enemy")) do
        if inst and inst.Parent then
            if not inst:GetAttribute("Died") and not inst:GetAttribute("Shielded") then
                local enemyId  = inst:GetAttribute("EnemyID")
                local nameAttr = inst:GetAttribute("Name") or inst:GetAttribute("EnemyName") or inst.Name
                local pos      = nil
                local data     = inst:FindFirstChild("Data")
                if data then
                    local cur = data:FindFirstChild("CurrentPosition")
                    if cur then
                        local utils = getEnemyUtils()
                        if utils and utils.GetPosition and enemyId then
                            local ok2, cf = pcall(function() return utils.GetPosition(enemyId) end)
                            if ok2 and cf and typeof(cf) == "CFrame" then pos = cf.Position end
                        end
                        if not pos then
                            local ok3, p = pcall(function() return cur.Value.Position end)
                            if ok3 then pos = p end
                        end
                    end
                end
                if not pos then
                    local hrp2 = inst:FindFirstChild("HumanoidRootPart")
                    if hrp2 then pos = hrp2.Position end
                end
                if pos and enemyId then
                    table.insert(list, {
                        ID       = tostring(enemyId),
                        Instance = inst,
                        Position = pos,
                        Name     = tostring(nameAttr),
                    })
                end
            end
        end
    end
    return list
end

local function getGamemodeEnemies()
    local list = {}
    local Omni = getOmni()
    if not Omni or not Omni.Data then return list end

    local gm      = Omni.Data.Gamemode
    local session = Omni.Data.GamemodeSession
    if not gm or gm == "" then return list end

    for _, inst in ipairs(CollectionService:GetTagged("Enemy")) do
        if inst and inst.Parent then
            local isDead = inst:GetAttribute("Died") == true
            local isShielded = inst:GetAttribute("Shielded") == true
            local hum = inst:FindFirstChildOfClass("Humanoid")
            local isHumDead = hum and hum.Health <= 0

            if not isDead and not isShielded and not isHumDead then
                local eGM = inst:GetAttribute("Gamemode")
                local eSession = inst:GetAttribute("SessionID")
                local matchesGM = (not eGM) or eGM == "" or eGM == gm
                local matchesSession = (not eSession) or eSession == "" or eSession == "Global" or eSession == session

                if matchesGM and matchesSession then
                    local id = tostring(inst:GetAttribute("EnemyID") or inst.Name)
                    if not (blacklistedTargets[id] and tick() - blacklistedTargets[id] < 1.5) then
                        local pos = nil
                        local hrp2 = inst:FindFirstChild("HumanoidRootPart")
                        if hrp2 then pos = hrp2.Position
                        else
                            local part = inst:FindFirstChildWhichIsA("BasePart")
                            if part then pos = part.Position end
                        end
                        if not pos then
                            local data = inst:FindFirstChild("Data")
                            if data then
                                local cur = data:FindFirstChild("CurrentPosition")
                                if cur and cur.Value then
                                    local ok, p = pcall(function() return cur.Value.Position end)
                                    if ok then pos = p end
                                end
                            end
                        end
                        if pos then
                            table.insert(list, {
                                ID       = id,
                                Instance = inst,
                                Position = pos,
                                Name     = tostring(inst:GetAttribute("Name") or inst:GetAttribute("EnemyName") or inst.Name),
                            })
                        end
                    end
                end
            end
        end
    end
    return list
end

local function filterBySelected(enemies)
    if not Settings.SelectedEnemies or #Settings.SelectedEnemies == 0 then return enemies end
    local sel = {}
    for _, n in ipairs(Settings.SelectedEnemies) do sel[n] = true end
    local out = {}
    for _, e in ipairs(enemies) do
        if sel[e.Name] then
            table.insert(out, e)
        else
            for s in pairs(sel) do
                if string.find(string.lower(e.Name), string.lower(s), 1, true) then
                    table.insert(out, e)
                    break
                end
            end
        end
    end
    return out
end

local function chooseClosest(enemies, myPos)
    local best, bestD = nil, math.huge
    for _, e in ipairs(enemies) do
        local d = (e.Position - myPos).Magnitude
        if d < bestD then best = e; bestD = d end
    end
    return best
end

teleportTo = function(pos)
    local hrp = getHRP()
    if not hrp then return end
    hrp.CFrame = CFrame.new(pos)
end

local function doAttack()
    if tick() - lastAttack < Settings.AttackDelay then return end
    lastAttack = tick()
    fireBridge({"General","Combat","PlayerAttack", n=3})
end

isEnemyAlive = function(e)
    if not e or not e.Instance or not e.Instance.Parent then return false end
    if e.Instance:GetAttribute("Died") == true then return false end
    local hum = e.Instance:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    if blacklistedTargets[e.ID] and tick() - blacklistedTargets[e.ID] < 1.5 then return false end
    return true
end

local function blacklist(id)
    if id then blacklistedTargets[id] = tick() end
end

local function checkAndBlacklist(target, hitCount)
    if hitCount < 4 then return false end
    local inst = target.Instance
    local dead = false
    if not inst or not inst.Parent then dead = true
    elseif inst:GetAttribute("Died") == true then dead = true
    else
        local hum = inst:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then dead = true end
    end
    if dead or hitCount >= 12 then
        blacklist(target.ID)
        return true
    end
    return false
end

