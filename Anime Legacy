local function gamemodeLoop()
    tryCloseResults()
    local inGM, gmName = isInGamemode()
    local progress = getSessionProgress()

    if Settings.TrialJoin then
        if inGM and gmName and string.find(gmName, "Trial") then
            if progress and progress.Wave >= Settings.TrialLeaveWave then
                leaveGamemode()
                notify("Trial", "Left at wave "..progress.Wave, 3)
            end
        else
            tryAutoJoinTrial()
        end
    end

    if Settings.DungeonJoin then
        if inGM and gmName and string.find(gmName, "Dungeon") then
            if progress and progress.RoomsCleared >= Settings.DungeonLeaveRoom then
                leaveGamemode()
                notify("Dungeon", "Left at room "..progress.RoomsCleared, 3)
            end
        else
            tryAutoJoinDungeon()
        end
    end

    autoTeleportToMap()
end

