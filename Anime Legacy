local fighterDropdown = nil
local fighterOptionToID = {}

local function buildFighterOptions()
    local Omni = getOmni()
    if not Omni or not Omni.Data or not Omni.Data.Fighters then return {} end

    local list = Omni.Data.Fighters.List or {}
    local options = {}
    fighterOptionToID = {}

    for id, data in pairs(list) do
        local name = data.Name or "Unknown"
        local level = data.Level or 1
        local shiny = data.Shiny and " [S]" or ""
        local label = name .. shiny .. " (Lv. " .. level .. ")"
        local finalLabel = label
        local counter = 2
        while fighterOptionToID[finalLabel] do
            finalLabel = label .. " #" .. counter
            counter = counter + 1
        end
        fighterOptionToID[finalLabel] = id
        table.insert(options, finalLabel)
    end

    table.sort(options)
    return options
end

local function limitConsumed(consumed, maxPerFood)
    local limited = {}
    for food, amount in pairs(consumed) do
        limited[food] = math.min(amount, maxPerFood or 100)
    end
    return limited
end

local function feedFighter(fighterId)
    local Omni = getOmni()
    local FighterFeed = getFighterFeed()
    if not Omni or not FighterFeed or not Omni.Data or not Omni.Data.Fighters then
        return false, "Omni/Data not available"
    end

    local fighterData = Omni.Data.Fighters.List[fighterId]
    if not fighterData then
        return false, "Fighter not found (ID "..tostring(fighterId)..")"
    end

    local remaining = FighterFeed.GetRemainingExp(fighterData, Omni.Data)
    if remaining <= 0 then
        return false, (fighterData.Name or "Fighter").." is already MAXED"
    end

    local consumed = FighterFeed.AddAll(fighterData, Omni.Data, {})
    if not consumed or next(consumed) == nil then
        return false, "No food available (AddAll empty)"
    end

    consumed = limitConsumed(consumed, Settings.FeedMaxPerFood)
    if next(consumed) == nil then
        return false, "No food after limit"
    end

    local preview = FighterFeed.GetPreview(fighterData, Omni.Data, consumed)
    if not preview or not next(preview.Consumed or {}) then
        return false, "Preview invalid"
    end

    fireBridge({"General", "Fighters", "Feed", fighterId, consumed, n = 5})
    return true, "Feed sent"
end

local function feedLoop()
    if not Settings.FeedEnabled then return end
    if not Settings.FeedFighterID then return end
    if tick() - lastFeed < Settings.FeedDelay then return end
    lastFeed = tick()

    local ok, err = pcall(feedFighter, Settings.FeedFighterID)

    if not ok then
        if tick() - lastFeedNotif > 5 then
            lastFeedNotif = tick()
            notify("Feed Error", tostring(err), 3)
        end
    elseif err then
        if tick() - lastFeedNotif > 5 then
            lastFeedNotif = tick()
            notify("Auto Feed", tostring(err), 3)
        end
        if string.find(tostring(err), "MAXED") or string.find(tostring(err), "No food") then
            Settings.FeedEnabled = false
        end
    end
end

local function startFeed()
    if feedConnection then return end
    feedConnection = RunService.Heartbeat:Connect(feedLoop)
end

local function stopFeed()
    if feedConnection then
        feedConnection:Disconnect()
        feedConnection = nil
    end
end

