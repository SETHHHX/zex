local PlayerSettings = {
    WalkSpeedEnabled = false,
    WalkSpeed = 30,
    FlyEnabled = false,
    FlySpeed = 50,
}

local DEFAULT_WALKSPEED = 16
local lastWalkSpeedState = false

task.spawn(function()
    while true do
        local hum = getHumanoid()
        if hum then
            if PlayerSettings.WalkSpeedEnabled then
                hum.WalkSpeed = PlayerSettings.WalkSpeed
            elseif lastWalkSpeedState == true then
                hum.WalkSpeed = DEFAULT_WALKSPEED
            end
            lastWalkSpeedState = PlayerSettings.WalkSpeedEnabled
        end
        task.wait(0.2)
    end
end)

local flyBV, flyBG
local function startFly()
    local hrp = getHRP()
    if not hrp then return end
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyBG.P = 1e4
    flyBG.Parent = hrp
end

local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

RunService.RenderStepped:Connect(function()
    if not PlayerSettings.FlyEnabled then return end
    local hrp = getHRP()
    if not hrp or not flyBV or not flyBG then return end
    local cam = Camera.CFrame
    local dir = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
    if dir.Magnitude > 0 then dir = dir.Unit * PlayerSettings.FlySpeed end
    flyBV.Velocity = dir
    flyBG.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.LookVector)
end)

