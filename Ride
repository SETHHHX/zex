local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getMyBasePosition()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local myId = LocalPlayer.UserId
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local ownerId = plot:GetAttribute("NestsOwnerLoaded")
            if ownerId and tonumber(ownerId) == myId then
                local baseplate = plot:FindFirstChild("Baseplate")
                if baseplate and baseplate:IsA("BasePart") then
                    return baseplate.Position
                end
                return plot:GetPivot().Position
            end
        end
    end
    return nil
end

-- Noclip
local noclipConnection
local function setNoclip(enabled)
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if not enabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        return
    end
    noclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function tweenTo(pos, speed)
    local hrp = getHRP()
    if not hrp then return end
    speed = speed or 80
    local distance = (hrp.Position - pos).Magnitude
    local time = math.clamp(distance / speed, 0.25, 8)
    local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
    })
    tween:Play()
    tween.Completed:Wait()
end

