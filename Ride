----------------------------------------------------
-- SETTINGS → Configs
----------------------------------------------------
local configName = ""
local selectedConfig = nil

local function listConfigs()
    local list = {}
    pcall(function()
        list = Library:GetConfigs() or {}
    end)
    if type(list) ~= "table" or #list == 0 then
        return {"None"}
    end
    return list
end

ConfigsModule:create_paragraph({
    Header = "How to use",
    Body = "1. Type a name\n2. <font color='#33ff00'>Save Config</font>\n3. Select and <font color='#00BFFF'>Load Config</font>\n4. Optional: <font color='#FFD700'>Set as Auto Load</font>"
})

ConfigsModule:create_textbox({
    title = "Config Name",
    flag = "ConfigNameBox",
    placeholder = "my_config",
    callback = function(text)
        configName = tostring(text or "")
    end
})

local ConfigDropdown = ConfigsModule:create_dropdown({
    title = "Saved Configs",
    flag = "SavedConfigsDropdown",
    options = listConfigs(),
    multi_dropdown = false,
    searchable = true,
    callback = function(selected)
        selectedConfig = tostring(selected or "")
        if selectedConfig == "None" then selectedConfig = nil end
        if selectedConfig and selectedConfig ~= "" then
            configName = selectedConfig
        end
    end
})

ConfigsModule:create_button({
    title = "Save Config",
    callback = function()
        if configName == "" then
            Library.SendNotification({ title = "Config", text = "Enter a name first.", duration = 3 })
            return
        end
        local ok, name = Library:SaveConfig(configName)
        Library.SendNotification({
            title = "Config",
            text = ok and ("Saved: " .. tostring(name)) or "Failed to save.",
            duration = 3
        })
    end
})

ConfigsModule:create_button({
    title = "Load Config",
    callback = function()
        local name = selectedConfig or configName
        if not name or name == "" then
            Library.SendNotification({ title = "Config", text = "Select or type a config name.", duration = 3 })
            return
        end
        local ok = Library:LoadConfig(name)
        Library.SendNotification({
            title = "Config",
            text = ok and ("Loaded: " .. tostring(name)) or "Config not found.",
            duration = 3
        })
    end
})

ConfigsModule:create_button({
    title = "Delete Config",
    callback = function()
        local name = selectedConfig or configName
        if not name or name == "" then
            Library.SendNotification({ title = "Config", text = "Nothing to delete.", duration = 3 })
            return
        end
        Library:DeleteConfig(name)
        Library.SendNotification({ title = "Config", text = "Deleted: " .. tostring(name), duration = 3 })
    end
})

ConfigsModule:create_divider({ showtopic = true, title = "Auto Load" })

ConfigsModule:create_button({
    title = "Set as Auto Load",
    callback = function()
        local name = selectedConfig or configName
        if not name or name == "" then
            Library.SendNotification({ title = "Auto Load", text = "Select a config first.", duration = 3 })
            return
        end
        local ok = Library:SetAutoLoad(name)
        Library.SendNotification({
            title = "Auto Load",
            text = ok and ("Will auto load: " .. tostring(name)) or "Failed.",
            duration = 3
        })
    end
})

ConfigsModule:create_button({
    title = "Reset Auto Load",
    callback = function()
        local current = Library:GetAutoLoad()
        Library:ClearAutoLoad()
        Library.SendNotification({
            title = "Auto Load",
            text = current and ("Cleared: " .. tostring(current)) or "Auto load was not set.",
            duration = 3
        })
    end
})

ConfigsModule:create_button({
    title = "Show Auto Load",
    callback = function()
        local current = Library:GetAutoLoad()
        Library.SendNotification({
            title = "Auto Load",
            text = current and ("Current: " .. tostring(current)) or "None set.",
            duration = 3
        })
    end
})

