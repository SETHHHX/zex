UISettings:create_button({
    title = "Cycle Theme (demo)",
    callback = function()
        local names = Window:GetThemeNames()
        local current = select(1, Window:GetTheme()) or "Purple"
        local idx = 1
        for i, n in ipairs(names) do
            if n == current then
                idx = i
                break
            end
        end
        local nextName = names[(idx % #names) + 1]
        Window:SetTheme(nextName)
        Library.SendNotification({
            title = "Theme",
            text = "Now: " .. tostring(nextName),
            duration = 2
        })
    end
})

