local ESPSettings = {
    Enabled = false,
    MaxDistance = 0,
    ShowDistance = true,
    ShowName = true,
    ShowRarity = true,
    TextSize = 15,
    OnlyRare = false,
}

local drawings = {}

local function createEsp(model)
    if drawings[model] then return end
    local box = Drawing.new("Square")
    box.Thickness = 1.8
    box.Filled = false
    box.Visible = false
    local text = Drawing.new("Text")
    text.Size = ESPSettings.TextSize
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.new(0, 0, 0)
    text.Visible = false
    drawings[model] = { box = box, text = text, rarity = getRarity(model.Name) }
end

local function removeEsp(model)
    local data = drawings[model]
    if not data then return end
    data.box:Remove()
    data.text:Remove()
    drawings[model] = nil
end

local function isRareEnough(rarity)
    if not ESPSettings.OnlyRare then return true end
    return rarity == "Epic" or rarity == "Legendary" or rarity == "Mythic" or rarity == "Divine" or rarity == "Ethereal"
end

RunService.RenderStepped:Connect(function()
    if not ESPSettings.Enabled then
        for _, data in pairs(drawings) do
            data.box.Visible = false
            data.text.Visible = false
        end
        return
    end
    local root = getHRP()
    local myPos = root and root.Position or Camera.CFrame.Position
    local rendered = workspace:FindFirstChild("RenderedEggs")
    if not rendered then return end
    for _, egg in ipairs(rendered:GetChildren()) do
        if egg:IsA("Model") then createEsp(egg) end
    end
    for model, data in pairs(drawings) do
        if not model.Parent or model.Parent ~= rendered then
            removeEsp(model)
            continue
        end
        local rarity = data.rarity
        if not isRareEnough(rarity) then
            data.box.Visible = false
            data.text.Visible = false
            continue
        end
        local pos = model:GetPivot().Position
        local distance = (pos - myPos).Magnitude
        if ESPSettings.MaxDistance > 0 and distance > ESPSettings.MaxDistance then
            data.box.Visible = false
            data.text.Visible = false
            continue
        end
        local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
        if not onScreen or screenPos.Z < 0 then
            data.box.Visible = false
            data.text.Visible = false
            continue
        end
        local color = RarityColors[rarity] or Color3.fromRGB(255, 255, 255)
        local size = math.clamp(2200 / distance, 10, 38)
        data.box.Size = Vector2.new(size, size)
        data.box.Position = Vector2.new(screenPos.X - size/2, screenPos.Y - size/2)
        data.box.Color = color
        data.box.Visible = true
        local lines = {}
        if ESPSettings.ShowName then table.insert(lines, model.Name) end
        if ESPSettings.ShowRarity then table.insert(lines, rarity) end
        if ESPSettings.ShowDistance then table.insert(lines, math.floor(distance) .. "m") end
        data.text.Text = table.concat(lines, "\n")
        data.text.Size = ESPSettings.TextSize
        data.text.Position = Vector2.new(screenPos.X, screenPos.Y + size/2 + 4)
        data.text.Color = color
        data.text.Visible = true
    end
end)

if workspace:FindFirstChild("RenderedEggs") then
    workspace.RenderedEggs.ChildRemoved:Connect(removeEsp)
end

