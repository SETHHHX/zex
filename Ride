local AutoSettings = {
    Enabled = false,
    TweenSpeed = 80,
    CollectDelay = 0.45,
    ReturnDelay = 0.4,
    LoopDelay = 1.2,
    MaxDistance = 3000,
    AllowedRarities = {
        Common = true, Rare = true, Epic = true, Legendary = true,
        Mythic = true, Divine = true, Ethereal = true
    },
    AllowedEggs = {},
}

local function getPriority(eggName)
    return RarityPriority[getRarity(eggName)] or 0
end

local function hasAnySpecificEggSelected()
    for _, v in pairs(AutoSettings.AllowedEggs) do
        if v then return true end
    end
    return false
end

local function findBestEgg()
    local rendered = workspace:FindFirstChild("RenderedEggs")
    if not rendered then return nil end
    local bestEgg, bestPriority, bestDist = nil, -1, math.huge
    local myPos = getHRP() and getHRP().Position or Vector3.zero
    local useSpecific = hasAnySpecificEggSelected()

    for _, egg in ipairs(rendered:GetChildren()) do
        if egg:IsA("Model") then
            local name = egg.Name
            local rarity = getRarity(name)
            if not AutoSettings.AllowedRarities[rarity] then continue end
            if useSpecific and not AutoSettings.AllowedEggs[name] then continue end
            local priority = getPriority(name)
            local pos = egg:GetPivot().Position
            local dist = (pos - myPos).Magnitude
            if AutoSettings.MaxDistance > 0 and dist > AutoSettings.MaxDistance then continue end
            if priority > bestPriority or (priority == bestPriority and dist < bestDist) then
                bestPriority = priority
                bestDist = dist
                bestEgg = egg
            end
        end
    end
    return bestEgg
end

local function getPrompt(egg)
    for _, desc in ipairs(egg:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then return desc end
    end
end

local function firePrompt(prompt)
    if not prompt then return end
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + 0.15)
            prompt:InputHoldEnd()
        end
    end)
end

task.spawn(function()
    while true do
        if AutoSettings.Enabled then
            local basePos = getMyBasePosition()
            local egg = findBestEgg()
            if egg and egg.Parent and basePos then
                setNoclip(true)
                tweenTo(egg:GetPivot().Position, AutoSettings.TweenSpeed)
                task.wait(AutoSettings.CollectDelay)
                if egg.Parent then firePrompt(getPrompt(egg)) end
                task.wait(AutoSettings.ReturnDelay)
                tweenTo(basePos, AutoSettings.TweenSpeed)
                setNoclip(false)
            end
        else
            setNoclip(false)
        end
        task.wait(AutoSettings.LoopDelay)
    end
end)

