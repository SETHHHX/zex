            tweenPlayerTo(cfg.exitPos, fastModeEnabled and 0.35 or 0.6)
        end
        fw(0.08, 0.02)
    end

    -- Always tween to sell position (never CFrame TP)
    local sellPos = getSellerPosition(cfg)
    if hrp and sellPos then
        if isTweenFarm() then
            tweenPlayerConstantSpeed(sellPos, tweenFarmSpeed)
        else
            tweenPlayerTo(sellPos, fastModeEnabled and 0.4 or 0.75)
        end
    end
    fw(0.12, 0.03)
end

local function fireSell(cfg)
    cfg = cfg or getActiveSeller()
    local npc = getSellerNpc(cfg)
    if not npc then return end
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("__remotes")
            :WaitForChild("SmuggleService")
            :WaitForChild("SellSmuggledGoods")
            :FireServer(npc)
    end)
end

local function venderAnillos()
    if isRespawning then return end
    -- Use LOCKED seller from this cycle (do not re-roll Random)
    local cfg = getActiveSeller()
    local itemName = selectedFarmItem or "Fake Diamond Ring"
    setStatus("Selling " .. itemName .. " at " .. tostring(activeSellerName) .. "...")
    ensureAtSeller(cfg)

    local prevItems = getFarmItemBackpackCount()
    local prevBrief = getBriefcaseCount()
    if prevItems <= 0 then
        setStatus("Nothing to sell")
        return true
    end

    local timeout = 0
    -- Much longer window: keep trying until sold
    local maxTimeout = fastModeEnabled and 90 or 180
    local noProgress = 0
    local attempts = 0
    local soldOk = false
    local lastReposition = 0

    -- Keep selling until ALL bought items leave backpack
    while diamondFarmEnabled and h and h.Health > 0 and not isRespawning do
        local itemsLeft = getFarmItemBackpackCount()
        local briefs = getBriefcaseCount()

        if itemsLeft <= 0 then
            soldOk = true
            break
        end

        local sellPos = getSellerPosition(cfg)
        local distToSell = (hrp and sellPos) and (hrp.Position - sellPos).Magnitude or 0
        -- Reposition if far OR periodically if no progress (possible silent rollback)
        if hrp and sellPos and (distToSell > 10 or (noProgress >= 4 and (os.clock() - lastReposition) > 1.2)) then
            setStatus("Reposition sell (" .. tostring(activeSellerName) .. ")...")
            ensureAtSeller(cfg)
            lastReposition = os.clock()
            noProgress = 0
        end

        fireSell(cfg)
        attempts = attempts + 1
        local t0 = os.clock()
        humanActionWait(attempts)
        timeout = timeout + (os.clock() - t0)

        local nowItems = getFarmItemBackpackCount()
        local nowBrief = getBriefcaseCount()
        if nowItems < prevItems then
            ringsSold = ringsSold + (prevItems - nowItems)
            prevItems = nowItems
            noProgress = 0
        elseif nowBrief > prevBrief then
            prevBrief = nowBrief
            noProgress = 0
        else
            noProgress = noProgress + 1
        end

        if noProgress > 5 then
            ensureAtSeller(cfg)
            fireSell(cfg)
            attempts = attempts + 1
            humanActionWait(attempts)
            noProgress = 0
            lastReposition = os.clock()
        end

        if timeout > maxTimeout then
            setStatus("Sell still trying — items left: " .. tostring(getFarmItemBackpackCount()))
            timeout = 0
            ensureAtSeller(cfg)
            if not diamondFarmEnabled or isRespawning then break end
            for _ = 1, 8 do
                if getFarmItemBackpackCount() <= 0 then break end
                fireSell(cfg)
                humanActionWait(attempts)
                attempts = attempts + 1
            end
            if getFarmItemBackpackCount() <= 0 then
                soldOk = true
                break
            end
            break
        end
    end

    local extra = 0
    while getFarmItemBackpackCount() > 0 and extra < 6 and diamondFarmEnabled and not isRespawning do
        fireSell(cfg)
        task.wait(0.25)
        extra = extra + 0.25
    end

    if getFarmItemBackpackCount() <= 0 then
        soldOk = true
        setStatus("Sold all " .. itemName)
    else
        setStatus("Sell incomplete — items left: " .. tostring(getFarmItemBackpackCount()))
    end

    task.wait(0.2 + math.random() * 0.25)
    return soldOk
end


local function getLaunderStandPos()
    -- NEVER use PromptPart.Position (can stream to wrong coords like 6558,92,-439)
    -- Always stand at fixed wash position
    return Vector3.new(6810, 17, -35)
end

local function getLaunderPromptPart()
    -- Nuevo path: workspace.Gameplay.LaunderPrompts.LaunderTrigger.PromptPart
    local target = Vector3.new(6810, 17, -35)
    local folder = nil
    local gameplay = workspace:FindFirstChild("Gameplay")
    if gameplay then
        folder = gameplay:FindFirstChild("LaunderPrompts")
    end
    if not folder then
        folder = workspace:FindFirstChild("LaunderPrompts")
    end
    if not folder then
        pcall(function()
            local gp = workspace:FindFirstChild("Gameplay") or workspace:WaitForChild("Gameplay", 3)
            if gp then
                folder = gp:WaitForChild("LaunderPrompts", 3)
            end
            if not folder then
                folder = workspace:WaitForChild("LaunderPrompts", 3)
            end
        end)
    end
    if not folder then return nil end

    local best, bestDist = nil, math.huge
    for _, d in ipairs(folder:GetDescendants()) do
        if d.Name == "PromptPart" and d:IsA("BasePart") then
            local dist = (d.Position - target).Magnitude
            if dist < bestDist then
                bestDist = dist
                best = d
            end
        end
    end

    if best and bestDist > 80 then
        setStatus(string.format("Launder prompt far (%.0f studs)", bestDist))
    end
    return best
end

local function ensureAtLaunder()
    if not isTweenFarm() then
        bajarseDelVehiculo()
        fw(0.15, 0.04)
    end
    local standPos = Vector3.new(6810, 17, -35)
    POSICIONES.LAVADO = standPos
    if hrp then
        if isTweenFarm() then
            -- already walked to wash waypoints; micro-adjust if needed
            if (hrp.Position - standPos).Magnitude > 4 then
                tweenPlayerConstantSpeed(standPos, tweenFarmSpeed)
            end
        elseif tweenPlayerTo then
            tweenPlayerTo(standPos, fastModeEnabled and 0.35 or 0.65)
        else
            hrp.CFrame = CFrame.new(standPos + Vector3.new(0, 3, 0))
