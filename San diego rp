-- ============================================================
-- Library Config API (premium-compatible)
-- ============================================================
do
    local HttpService = game:GetService("HttpService")
    local CONFIG_FOLDER = "ZexHub/Configs"
    local AUTOLOAD_FILE = "ZexHub/autoload.txt"

    local function ensureFolders()
        pcall(function()
            if makefolder then
                makefolder("ZexHub")
                makefolder(CONFIG_FOLDER)
            end
        end)
    end

    local function cleanName(name)
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        name = name:gsub("[^%w%-%_ ]", ""):gsub("%s+", "_")
        if name == "" then return nil end
        return name
    end

    local function configPath(name)
        return CONFIG_FOLDER .. "/" .. name .. ".json"
    end

    function Library:GetConfigs()
        ensureFolders()
        local list = {}
        pcall(function()
            if listfiles then
                for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
                    local n = tostring(f):match("([^/\\]+)%.json$")
                    if n then table.insert(list, n) end
                end
            end
        end)
        table.sort(list)
        return list
    end

    function Library:SaveConfig(name)
        ensureFolders()
        name = cleanName(name)
        if not name then return false, nil end

        local flags = {}
        -- from registry if present
        if FlagRegistry then
            for flag, entry in pairs(FlagRegistry) do
                flags[flag] = entry.current
            end
        end
        pcall(function()
            if self._config and self._config._flags then
                for k, v in pairs(self._config._flags) do
                    if flags[k] == nil then flags[k] = v end
                end
            end
        end)

        local payload = {
            name = name,
            savedAt = os.date("%Y-%m-%d %H:%M:%S"),
            flags = flags,
            _flags = flags,
            _keybinds = (self._config and self._config._keybinds) or {},
        }

        local ok = pcall(function()
            writefile(configPath(name), HttpService:JSONEncode(payload))
        end)
        return ok, name
    end

    function Library:LoadConfig(name)
        ensureFolders()
        name = cleanName(name)
        if not name then return false end
        local path = configPath(name)
        if not (isfile and isfile(path)) then return false end

        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if not ok or type(data) ~= "table" then return false end

        local flags = data.flags or data._flags or {}
        if type(flags) ~= "table" then return false end

        -- write into library config
        pcall(function()
            if not self._config then
                self._config = { _flags = {}, _keybinds = {}, _library = {} }
            end
            self._config._flags = self._config._flags or {}
            for k, v in pairs(flags) do
                self._config._flags[k] = v
            end
            if type(data._keybinds) == "table" then
                self._config._keybinds = data._keybinds
            end
        end)

        -- apply to live UI via FlagRegistry
        if FlagRegistry and setFlagValue then
            for k, v in pairs(flags) do
                pcall(setFlagValue, k, v)
            end
        end
        return true
    end

    function Library:DeleteConfig(name)
        name = cleanName(name)
        if not name then return false end
        local path = configPath(name)
        local ok = pcall(function()
            if isfile and isfile(path) and delfile then
                delfile(path)
            end
        end)
        -- clear autoload if it pointed here
        pcall(function()
            if self:GetAutoLoad() == name then
                self:ClearAutoLoad()
            end
        end)
        return ok
    end

    function Library:SetAutoLoad(name)
        ensureFolders()
        name = cleanName(name)
        if not name then return false end
        local ok = pcall(function()
            writefile(AUTOLOAD_FILE, name)
        end)
        return ok
    end

    function Library:GetAutoLoad()
        local name = nil
        pcall(function()
            if isfile and isfile(AUTOLOAD_FILE) then
                name = cleanName(readfile(AUTOLOAD_FILE))
            end
        end)
        return name
    end

    function Library:ClearAutoLoad()
        pcall(function()
            if isfile and isfile(AUTOLOAD_FILE) and delfile then
                delfile(AUTOLOAD_FILE)
            end
        end)
        return true
    end

    function Library:TryAutoLoad()
        local name = self:GetAutoLoad()
        if not name then return false, nil end
        local ok = self:LoadConfig(name)
        return ok, name
    end
end




