local function lavarBriefcases()
    if isRespawning then return end
    setStatus("Laundering briefcases...")

    local last = getBriefcaseCount()
    if last == 0 then return end

    ensureAtLaunder()

    local maxAttempts = fastModeEnabled and 100 or 60
    local attempts = 0
    local standPos = getLaunderStandPos()

    while getBriefcaseCount() > 0 and diamondFarmEnabled and h and h.Health > 0 and not isRespawning and attempts < maxAttempts do
        -- si nos empujaron lejos, arrastrar de nuevo al lavado
        if hrp and standPos and (hrp.Position - standPos).Magnitude > 12 then
            tweenPlayerTo(standPos, fastModeEnabled and 0.3 or 0.55)
        end

        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("__remotes")
                :WaitForChild("SmuggleService")
                :WaitForChild("LaunderBriefcase")
                :FireServer(getLaunderPromptPart())
        end)
        attempts = attempts + 1
        humanActionWait(attempts)

        if attempts % 10 == 0 then
            local cur = getBriefcaseCount()
            if cur < last then
                washesDone = washesDone + (last - cur)
                last = cur
            end
        end
    end

    local remaining = getBriefcaseCount()
    if remaining < last then
        washesDone = washesDone + (last - remaining)
    end
    task.wait(0.2 + math.random() * 0.3)
end

