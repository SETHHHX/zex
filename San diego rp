local function suppressBikePhysics(root)
    if not root then return end
    local names = { "BalanceForce", "SteerTorque", "StoppieForce" }
    if not bikeWheelieEnabled then
        table.insert(names, "WheelieForce")
    end
    for _, name in ipairs(names) do
        local inst = root:FindFirstChild(name)
        if inst then
            if inst:IsA("VectorForce") then inst.Force = Vector3.zero
            elseif inst:IsA("Torque") then inst.Torque = Vector3.zero end
        end
    end
    root.AssemblyAngularVelocity = Vector3.zero
end

local function buildBikeRayParams(bike)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excl = {}
    if p.Character then table.insert(excl, p.Character) end
    if bike then table.insert(excl, bike) end
    local vf = workspace:FindFirstChild("Vehicles")
    if vf then table.insert(excl, vf) end
    for _, name in ipairs({ "Effects", "Debris", "Ignore", "RaysIgnore" }) do
        local f = workspace:FindFirstChild(name)
        if f then table.insert(excl, f) end
    end
    params.FilterDescendantsInstances = excl
    return params
end

local function getBikeGroundHeight(x, z, refY, bike)
    local params = buildBikeRayParams(bike)
    refY = refY or 20
    local hits = {}
    for _, pr in ipairs({
        { originY = refY + 6, dirY = -40 },
        { originY = refY + 35, dirY = -80 },
        { originY = 400, dirY = -800 },
    }) do
        local result = workspace:Raycast(Vector3.new(x, pr.originY, z), Vector3.new(0, pr.dirY, 0), params)
        if result then table.insert(hits, result.Position.Y) end
    end
    if #hits == 0 then return refY end
    local best, bestDiff = hits[1], math.abs(hits[1] - refY)
    for i = 2, #hits do
        local d = math.abs(hits[i] - refY)
        if d < bestDiff then best = hits[i] bestDiff = d end
    end
    if math.abs(best - refY) > BIKE_MAX_HEIGHT_CORRECT then
        if best > refY then best = refY + BIKE_MAX_HEIGHT_CORRECT
        else best = refY - BIKE_MAX_HEIGHT_CORRECT end
    end
    return best + BIKE_HEIGHT_OFFSET
end

local function uprightBikeCF(pos, look, wheelie)
    local f = Vector3.new(look.X, 0, look.Z)
    if f.Magnitude < 0.05 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    local cf = CFrame.lookAt(pos, pos + f, Vector3.yAxis)
    if wheelie then cf = cf * CFrame.Angles(math.rad(28), 0, 0) end
    return cf
end

local function freezeBikeWheels(bike, freeze)
    if not bike then return end
    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            local n = string.lower(part.Name)
            local isWheel = n:find("wheel") or n:find("tire") or n:find("rim")
                or n:find("collider") or n:find("tyre")
            if isWheel or (part.Parent and string.lower(part.Parent.Name):find("wheel")) then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                if freeze then
                    if bikeWheelCollideSaved[part] == nil then
                        bikeWheelCollideSaved[part] = part.CanCollide
                    end
                    part.CanCollide = false
                else
                    if bikeWheelCollideSaved[part] ~= nil then
                        part.CanCollide = bikeWheelCollideSaved[part]
                        bikeWheelCollideSaved[part] = nil
                    end
                end
            end
        end
    end
    for _, inst in ipairs(bike:GetDescendants()) do
        if inst:IsA("HingeConstraint") or inst:IsA("CylindricalConstraint") then
            pcall(function()
                if freeze then
                    inst.AngularVelocity = 0
                    if inst.MotorMaxTorque then inst.MotorMaxTorque = 0 end
                end
            end)
        end
    end
end

softFreezeBike = function(bike, forceHoldEvenIfSeated)
    if not bike then return end
    stopBikeHold()
    local root = getVehicleRoot(bike)
    if root then
        for _, name in ipairs({ "BalanceForce", "SteerTorque", "WheelieForce", "StoppieForce" }) do
            local inst = root:FindFirstChild(name)
            if inst then
                if inst:IsA("VectorForce") then inst.Force = Vector3.zero end
                if inst:IsA("Torque") then inst.Torque = Vector3.zero end
            end
        end
        for _, child in ipairs(root:GetChildren()) do
            if child.Name == "_BV" or child.Name == "_BG" then
                pcall(function() child:Destroy() end)
            end
        end
    end
    if not root then return end

    local pos = root.Position
    local highPlatform = (pos.Y >= 28)
    local gy = getBikeGroundHeight(pos.X, pos.Z, pos.Y, bike)
    local holdY
    if highPlatform then
        holdY = pos.Y -- NUNCA bajar al Terrain en VENTA/pisos altos
    else
        holdY = math.max(gy + 0.85, pos.Y)
        if holdY > gy + 4 then holdY = gy + 1.2 end
    end
    local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) else look = look.Unit end
    local holdPos = Vector3.new(pos.X, holdY, pos.Z)
    local holdLook = look
    local lockHighY = highPlatform
    pcall(function()
        bike:PivotTo(uprightBikeCF(holdPos, holdLook, false))
    end)
    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Anchored = false
        end
    end
    freezeBikeWheels(bike, true)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    local holdEvenSeated = forceHoldEvenIfSeated == true

    bikeHoldConnection = RunService.Heartbeat:Connect(function()
        if not bike or not bike.Parent then
            freezeBikeWheels(bike, false)
            stopBikeHold()
            return
        end
        if not holdEvenSeated and h and h.SeatPart then
            local seat = h.SeatPart
            local owner = seat
            while owner and owner ~= bike do owner = owner.Parent end
            if owner == bike then
                freezeBikeWheels(bike, false)
                stopBikeHold()
                return
            end
        end
        local r = getVehicleRoot(bike)
        if not r then return end
        for _, name in ipairs({ "BalanceForce", "SteerTorque", "WheelieForce", "StoppieForce" }) do
            local inst = r:FindFirstChild(name)
            if inst then
                if inst:IsA("VectorForce") then inst.Force = Vector3.zero end
                if inst:IsA("Torque") then inst.Torque = Vector3.zero end
            end
        end
        if not (lockHighY or holdPos.Y >= 28) then
            local ngy = getBikeGroundHeight(holdPos.X, holdPos.Z, holdPos.Y, bike)
            local wantY = ngy + 0.85
            if holdPos.Y < wantY - 0.3 then
                holdPos = Vector3.new(holdPos.X, wantY, holdPos.Z)
            elseif holdPos.Y > ngy + 4 then
                holdPos = Vector3.new(holdPos.X, wantY, holdPos.Z)
            end
        end
        pcall(function()
            bike:PivotTo(uprightBikeCF(holdPos, holdLook, false))
        end)
        freezeBikeWheels(bike, true)
        for _, part in ipairs(bike:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
end

dragBikeToPosition = function(targetPos, parkAtEnd)
    if parkAtEnd == nil then parkAtEnd = true end
    if isRespawning or not diamondFarmEnabled then return false end
    local bike = findMyVehicle()
    if not bike then return false end
    local root = getVehicleRoot(bike)
    if not root then return false end
    if not h or not h.SeatPart then
        if subirseConPrompt then subirseConPrompt() end
        task.wait(0.2)
        if not h or not h.SeatPart then return false end
    end

    local from = root.Position
    local dist0 = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(from.X, 0, from.Z)).Magnitude
    if dist0 < BIKE_ARRIVE_DIST then
        if parkAtEnd then softFreezeBike(bike) end
        return true
    end

    stopBikeHold()
    freezeBikeWheels(bike, false)
    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Anchored = false
        end
    end
    bikeSetNoclip(bike, true)
    if p.Character then bikeSetNoclip(p.Character, true) end

    -- Neon + beam también en bike (mismo estilo que el carro)
    pcall(function()
        if aplicarEsteticaNeon then aplicarEsteticaNeon(bike) end
    end)

    local endY = getBikeGroundHeight(targetPos.X, targetPos.Z, targetPos.Y, bike)
    if endY < 10 then endY = math.max(targetPos.Y, 17) + BIKE_HEIGHT_OFFSET end
    if targetPos.Y >= 28 then
        endY = targetPos.Y + BIKE_HEIGHT_OFFSET
    end
    local endPos = Vector3.new(targetPos.X, endY, targetPos.Z)

    pcall(function()
        if crearLineaGuia then crearLineaGuia(root, endPos) end
    end)

    local done = false
    local t0 = os.clock()
    local lastPos = root.Position
    local lastMoveCheck = os.clock()
    local stuckFrames = 0
    local lastJumpTime = 0
    local conn

    local function doJump(pos, dir, fwd, up)
        local md = dir.Magnitude > 0.05 and dir.Unit or Vector3.new(0, 0, -1)
        local ny = pos.Y + up
        if targetPos.Y >= 28 then ny = math.min(ny, endPos.Y + 3) end
        local np = pos + md * fwd
        pcall(function()
            bike:PivotTo(uprightBikeCF(Vector3.new(np.X, ny, np.Z), md, bikeWheelieEnabled))
        end)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        lastJumpTime = os.clock()
    end

    conn = RunService.Heartbeat:Connect(function()
        if done then return end
        if not bike.Parent or not root.Parent then done = true return end
        if os.clock() - t0 > BIKE_TIMEOUT then done = true return end
        if h.Parent and not h.SeatPart then done = true return end
        if isRespawning or not diamondFarmEnabled then done = true return end

        suppressBikePhysics(root)
        local pos = root.Position
        local flat = Vector3.new(endPos.X - pos.X, 0, endPos.Z - pos.Z)
        local dist = flat.Magnitude
        local now = os.clock()

        if targetPos.Y >= 28 then
            if dist < 14 and pos.Y >= endPos.Y - 6 then
                local look = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
                pcall(function()
                    bike:PivotTo(uprightBikeCF(Vector3.new(endPos.X, endPos.Y, endPos.Z), look, bikeWheelieEnabled))
                end)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                done = true
                return
            end
        elseif dist < BIKE_ARRIVE_DIST then
            local look = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
            local fy = getBikeGroundHeight(endPos.X, endPos.Z, pos.Y, bike)
            pcall(function()
                bike:PivotTo(uprightBikeCF(Vector3.new(endPos.X, fy, endPos.Z), look, bikeWheelieEnabled))
            end)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            done = true
            return
        end

        if flat.Magnitude < 0.05 then return end
        local dir = flat.Unit

        if now - lastMoveCheck >= 0.35 then
            local moved = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude
            if moved < 0.8 then stuckFrames = stuckFrames + 1 else stuckFrames = math.max(0, stuckFrames - 1) end
            lastPos = pos
            lastMoveCheck = now
        end

        if stuckFrames >= 3 and (now - lastJumpTime) > 0.22 then
            local jumpUp = targetPos.Y >= 28 and math.max(14, endPos.Y - pos.Y + 2) or 18
            doJump(pos, dir, 12, jumpUp)
            stuckFrames = 0
            pos = root.Position
            flat = Vector3.new(endPos.X - pos.X, 0, endPos.Z - pos.Z)
            if flat.Magnitude > 0.05 then dir = flat.Unit end
        end

        local gy
        if targetPos.Y >= 28 then
            if dist > 80 then
                gy = getBikeGroundHeight(pos.X, pos.Z, pos.Y, bike)
            else
                local t = 1 - math.clamp(dist / 80, 0, 1)
                local groundY = getBikeGroundHeight(pos.X, pos.Z, pos.Y, bike)
                gy = groundY + (endPos.Y - groundY) * math.clamp(t * 1.4, 0, 1)
                if dist < 25 then gy = endPos.Y end
            end
        else
            gy = getBikeGroundHeight(pos.X, pos.Z, pos.Y, bike)
        end

        local speed = getHumanDragSpeed(dragSpeed or BIKE_SPEED)
        pcall(function()
            bike:PivotTo(uprightBikeCF(Vector3.new(pos.X, gy, pos.Z), dir, bikeWheelieEnabled))
        end)
        root.AssemblyLinearVelocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    while not done do
        task.wait(0.03)
        if isRespawning or not diamondFarmEnabled then done = true end
    end
    if conn then conn:Disconnect() end
    if root and root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        suppressBikePhysics(root)
    end
    if parkAtEnd and bike and bike.Parent then
        local r = getVehicleRoot(bike)
        if r then
            local y = getBikeGroundHeight(targetPos.X, targetPos.Z, targetPos.Y, bike)
            if targetPos.Y >= 28 then
                y = math.max(y, targetPos.Y + BIKE_HEIGHT_OFFSET)
            end
            if y < 10 then y = math.max(targetPos.Y, 17) + BIKE_HEIGHT_OFFSET end
            pcall(function()
                bike:PivotTo(uprightBikeCF(Vector3.new(targetPos.X, y, targetPos.Z), r.CFrame.LookVector, false))
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        softFreezeBike(bike, true)
        task.wait(0.08)
        if p.Character then bikeSetNoclip(p.Character, false) end
    elseif bike and bike.Parent then
        bikeRefreshNoclip(bike)
    end
    pcall(function()
        if limpiarLineaGuia then limpiarLineaGuia() end
    end)
    return true
end


