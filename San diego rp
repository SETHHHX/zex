local function startSeatWatcher()
    if seatWatchConnection then
        seatWatchConnection:Disconnect()
        seatWatchConnection = nil
    end
    notSeatedTime = 0

    seatWatchConnection = RunService.Heartbeat:Connect(function(dt)
        if not diamondFarmEnabled or not autoRecoverEnabled or isRespawning then
            notSeatedTime = 0
            return
        end
        if _G.BankRobberyActive then
            notSeatedTime = 0
            return
        end
        if allowOnFootFarm or isTweenFarm() then
            notSeatedTime = 0
            return
        end
        if not h or h.Health <= 0 then
            notSeatedTime = 0
            return
        end

        if h.SeatPart then
            notSeatedTime = 0
        else
