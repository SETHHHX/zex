local function findMyVehicle()
    local vehiclesFolder = workspace:FindFirstChild("Vehicles")
    if not vehiclesFolder then return nil end
   
    for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
        local ownerIdProp = vehicle:FindFirstChild("OwnerUserId")
        local ownerIdValue = ownerIdProp and (ownerIdProp:IsA("ValueObject") and ownerIdProp.Value or ownerIdProp)
        local attributeOwner = vehicle:GetAttribute("OwnerUserId")
       
        if ownerIdValue == player.UserId or attributeOwner == player.UserId then
            return vehicle
        end
    end
    return nil
end

local function deleteVehicle(vehicle)
    if not vehicle or not vehicle.Parent then return end
    pcall(function()
        vehicle:Destroy()
    end)
end

