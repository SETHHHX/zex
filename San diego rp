-- ===== Infinite Fuel (CarunoHub logic → Vehiclesmod Toggle) =====
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")

	local player = Players.LocalPlayer
	local infiniteFuelEnabled = false
	local fuelHeartbeat = nil
	local fuelInfoTables = setmetatable({}, { __mode = "k" })
	local lastFuelInfoScan = 0
	local fuelPatchAccumulator = 0

	local function getDrivenVehicle()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		local vehicles = Workspace:FindFirstChild("Vehicles")
		if not seat or not vehicles then
			return nil, nil
		end
		local object = seat
		while object and object.Parent ~= vehicles do
			object = object.Parent
		end
		if not object or object.Parent ~= vehicles or not object:IsA("Model") then
			return nil, nil
		end
		local root = object:FindFirstChild("Root")
		if not root or not root:IsA("BasePart") then
			root = object.PrimaryPart or seat.AssemblyRootPart
		end
		return object, root
	end

	local function scanGarbageCollectedTables(callback)
		if type(getgc) ~= "function" then
			return false
		end
		local success, objects = pcall(getgc, true)
		if not success or type(objects) ~= "table" then
			return false
		end
		for _, object in ipairs(objects) do
			if type(object) == "table" then
				pcall(callback, object)
			end
		end
		return true
	end

	local function patchVehicleFuel(vehicle, root)
		if not vehicle or not vehicle.Parent then
			return false
		end
		local maxFuel = vehicle:GetAttribute("MaxFuel")
		if type(maxFuel) ~= "number" or maxFuel <= 0 then
			maxFuel = vehicle:GetAttribute("Fuel")
		end
		if type(maxFuel) ~= "number" or maxFuel <= 0 then
			return false
		end
		pcall(function()
			vehicle:SetAttribute("CurrentFuel", maxFuel)
			vehicle:SetAttribute("Fuel", maxFuel)
		end)
		if lastFuelInfoScan == 0 or os.clock() - lastFuelInfoScan >= 1 then
			lastFuelInfoScan = os.clock()
			scanGarbageCollectedTables(function(object)
				if type(rawget(object, "CurrentFuel")) == "number"
					and type(rawget(object, "MaxFuel")) == "number"
					and typeof(rawget(object, "Root")) == "Instance" then
					fuelInfoTables[object] = true
				end
			end)
		end
		for object in pairs(fuelInfoTables) do
			if rawget(object, "Root") == root then
				object.CurrentFuel = maxFuel
				object.MaxFuel = maxFuel
			end
		end
		return true
	end

	local function startInfiniteFuel()
		infiniteFuelEnabled = true
		local vehicle, root = getDrivenVehicle()
		if vehicle then
			patchVehicleFuel(vehicle, root)
		end
		if fuelHeartbeat then
			fuelHeartbeat:Disconnect()
			fuelHeartbeat = nil
		end
		fuelPatchAccumulator = 0
		fuelHeartbeat = RunService.Heartbeat:Connect(function(dt)
			if not infiniteFuelEnabled then
				return
			end
			fuelPatchAccumulator = fuelPatchAccumulator + dt
			if fuelPatchAccumulator < 0.05 then
				return
			end
			fuelPatchAccumulator = 0
			local vehicle, root = getDrivenVehicle()
			if vehicle then
				patchVehicleFuel(vehicle, root)
			end
		end)
		return true
	end

	local function stopInfiniteFuel()
		infiniteFuelEnabled = false
		fuelPatchAccumulator = 0
		if fuelHeartbeat then
			fuelHeartbeat:Disconnect()
			fuelHeartbeat = nil
		end
		return true
	end

	Vehiclesmod:Toggle({
		Name = "Infinite Fuel",
		Default = false,
		Callback = function(Value)
			if Value then
				startInfiniteFuel()
			else
				stopInfiniteFuel()
			end
		end
	}, "infinite_fuel_toggle")
end





do -- BLOQUE AISLADO PARA LIBERAR REGISTROS (Evita el límite de 200 locales)
    local Config = {
        RADIUS = 200, -- Se actualizará dinámicamente con el Slider
        RETURN_POSITION = Vector3.new(2816, 18, 108),
        TWEEN_SPEED = 300
    }

    local Services = {
        Players = game:GetService("Players"),
        RunService = game:GetService("RunService"),
        ReplicatedStorage = game:GetService("ReplicatedStorage"),
        TweenService = game:GetService("TweenService"),
        Teams = game:GetService("Teams")
    }

    local State = {
        isTweening = false,
        loopConnection = nil
    }

    local LocalPlayer = Services.Players.LocalPlayer
    local BorderService = Services.ReplicatedStorage:WaitForChild("__remotes"):WaitForChild("BorderAuthorisationService")
    local GrantRemote = BorderService:WaitForChild("GrantEntry")
    local InspectionRemote = BorderService:WaitForChild("SendToInspection")

    local VisualCircle = Instance.new("CylinderHandleAdornment")
    VisualCircle.Color3 = Color3.fromRGB(0, 255, 120)
    VisualCircle.Transparency = 0.7
    VisualCircle.Radius = Config.RADIUS
    VisualCircle.Height = 0.2
    VisualCircle.CFrame = CFrame.Angles(math.rad(90), 0, 0)
    VisualCircle.AlwaysOnTop = false
    VisualCircle.Parent = workspace

    local Funcs = {}

    function Funcs.isGranted(player) return player:GetAttribute("Granted") == true end
    function Funcs.isBeingInspected(player) return player:GetAttribute("InspectionActive") == true end
    function Funcs.isFromMexico(player) return player:GetAttribute("FromMexico") == true end
    function Funcs.isWantedBorderStampAllowed(player) return player:GetAttribute("WantedBorderStampAllowed") == true end
    
    function Funcs.hasWantedLevel(player)
        local wantedLevel = player:GetAttribute("WantedLevel")
        return typeof(wantedLevel) == "number" and wantedLevel > 0
    end

    function Funcs.isStampReady(player)
        local lastStamped = player:GetAttribute("LastStamped")
        if type(lastStamped) == "number" then return (os.clock() - lastStamped) >= 3 end
        return true
    end

    function Funcs.canGrantEntry(player)
        if player.Team == Services.Teams.Civilian and not Funcs.hasWantedLevel(player) and Funcs.isStampReady(player) then
            return not Funcs.isGranted(player) and (Funcs.isFromMexico(player) or (Funcs.isBeingInspected(player) or Funcs.isWantedBorderStampAllowed(player)))
        end
        return false
    end

    function Funcs.canSendToInspection(player)
        if player.Team == Services.Teams.Civilian and not Funcs.hasWantedLevel(player) and Funcs.isStampReady(player) then
            if Funcs.isGranted(player) then return false end
            return not Funcs.isBeingInspected(player) and (Funcs.isFromMexico(player) or Funcs.isWantedBorderStampAllowed(player))
        end
        return false
    end

    function Funcs.equipStamp()
        local character = LocalPlayer.Character
        if not character then return false end
        if character:FindFirstChild("Stamp") then return true end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local stamp = backpack:FindFirstChild("Stamp")
            if stamp then stamp.Parent = character return true end
        end
        return false
    end

    function Funcs.tweenCharacter(targetCFrame)
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local duration = distance / Config.TWEEN_SPEED
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local tween = Services.TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end

    function Funcs.checkPlayersInRadius()
        if State.isTweening then return end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        VisualCircle.Adornee = hrp
        VisualCircle.Radius = Config.RADIUS
        VisualCircle.CFrame = CFrame.new(0, -3.2, 0) * CFrame.Angles(math.rad(90), 0, 0)
        
        for _, player in ipairs(Services.Teams.Civilian:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = player.Character.HumanoidRootPart
                local distance = (hrp.Position - targetHrp.Position).Magnitude
                
                if distance <= Config.RADIUS then
                    if Funcs.hasWantedLevel(player) or not Funcs.isStampReady(player) then continue end
                    local isGrantable = Funcs.canGrantEntry(player)
                    local isInspectable = Funcs.canSendToInspection(player)
                    
                    if isGrantable or isInspectable then
                        local equipped = Funcs.equipStamp()
                        if not equipped then continue end
                        
                        State.isTweening = true
                        player:SetAttribute("LastStamped", os.clock())
                        
                        local targetPos = targetHrp.CFrame * CFrame.new(0, 0, 2)
                        Funcs.tweenCharacter(targetPos)
                        task.wait(0.05)
                        
                        pcall(function()
                            if isGrantable then GrantRemote:InvokeServer(player)
                            elseif isInspectable then InspectionRemote:InvokeServer(player) end
                        end)
                        
                        Funcs.tweenCharacter(CFrame.new(Config.RETURN_POSITION))
                        task.wait(0.2)
                        State.isTweening = false
                        break
                    end
                end
            end
        end
    end

    LocalPlayer.CharacterRemoving:Connect(function()
        VisualCircle.Adornee = nil
        State.isTweening = false
    end)




    PoliceXp:Paragraph({
    Header = "AUTO STAMP SYSTEM",
    Body = "<font color='#00FF7F'><b>Automatically equips your Stamp and scans for eligible civilian players within your custom radius.</b></font> "
}, "AutoStampDescription")


    -- Slider para configurar el Rango/Tamaño
    PoliceXp:Slider({
        Name = "Scan Radius",
        Default = 200,
        Minimum = 10,
        Maximum = 300,
        DisplayMethod = "Value",
        Precision = 0,
        Callback = function(Value)
            Config.RADIUS = Value
            -- Actualizar el tamaño visual al instante si el círculo está activo
            if VisualCircle.Adornee then
                VisualCircle.Radius = Value
            end
        end,
        onInputComplete = function(Value)
            Config.RADIUS = Value
        end
    }, "StampRadiusSlider")



    
    -- Ejecución del Toggle
    PoliceXp:Toggle({
        Name = "Auto Stamp",
        Default = false,
        Callback = function(Value)
            if Value then
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - Config.RETURN_POSITION).Magnitude > 2 then
                    State.isTweening = true
                    Funcs.tweenCharacter(CFrame.new(Config.RETURN_POSITION))
                    State.isTweening = false
                end

                if State.loopConnection then State.loopConnection:Disconnect() end
                State.loopConnection = Services.RunService.Heartbeat:Connect(function()
                    Funcs.checkPlayersInRadius()
                end)
            else
                if State.loopConnection then
                    State.loopConnection:Disconnect()
                    State.loopConnection = nil
                end
                VisualCircle.Adornee = nil
                State.isTweening = false
            end
        end
    }, "AutoStampToggle")
end





local boxConnection = nil -- Variable global para controlar el bucle del Auto Farm

PoliceXp:Toggle({
    Name = "Auto Farm Boxes",
    Default = false,
    Callback = function(state)
        if state then
            -- Configuración de Posiciones y Objetivos
            local FETCH_POS = Vector3.new(-12, 17, -73)
            local DELIVER_POS = Vector3.new(3, 17, -52)
            local TWEEN_SPEED = 300

            local Players = game:GetService("Players")
            local RunService = game:GetService("RunService")
            local TweenService = game:GetService("TweenService")
            
            local LocalPlayer = Players.LocalPlayer
            
            -- Prompts del mapa
            local BoxJob = workspace:WaitForChild("BoxJob", 5)
            if not BoxJob then return end
            
            local FetchPrompt = BoxJob:WaitForChild("PromptParts"):WaitForChild("FetchPromptPart"):WaitForChild("BoxFetchPrompt")
            local DeliverPrompt = BoxJob:WaitForChild("PromptParts"):WaitForChild("DeliverPromptPart"):WaitForChild("BoxDeliverPrompt")

            local isFarmTweening = false

            -- Función de movimiento por Tween
            local function tweenTo(targetPos)
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local distance = (hrp.Position - targetPos).Magnitude
                local duration = distance / TWEEN_SPEED
                
                local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
                
                tween:Play()
                tween.Completed:Wait()
            end

            -- Verificar si el personaje tiene la caja equipada en el Character
            local function hasBox()
                local character = LocalPlayer.Character
                return character and character:FindFirstChild("Box") ~= nil
            end

            -- Función principal del ciclo
            local function farmCycle()
                if isFarmTweening then return end
                isFarmTweening = true

                local character = LocalPlayer.Character
                if not character or not character:FindFirstChild("HumanoidRootPart") then 
                    isFarmTweening = false 
                    return 
                end

                -- PASO 1: Si no tenemos caja, vamos a buscarla
                if not hasBox() then
                    tweenTo(FETCH_POS)
                    task.wait(0.1)
                    
                    -- Disparar el prompt de agarre
                    if FetchPrompt then
                        fireproximityprompt(FetchPrompt)
                    end
                    
                    -- Esperar brevemente a que el servidor valide y la caja aparezca en el personaje
                    local timeout = 0
                    while not hasBox() and timeout < 10 do
                        task.wait(0.1)
                        timeout = timeout + 1
                    end
                end

                -- PASO 2: Si ya tenemos la caja, vamos a entregarla
                if hasBox() then
                    tweenTo(DELIVER_POS)
                    task.wait(0.1)
                    
                    -- Disparar el prompt de entrega
                    if DeliverPrompt then
                        fireproximityprompt(DeliverPrompt)
                    end
                    
                    -- Esperar a que la caja desaparezca confirmando la entrega
                    local timeout = 0
                    while hasBox() and timeout < 10 do
                        task.wait(0.1)
                        timeout = timeout + 1
                    end
                end

                task.wait(0.2) -- Pausa de estabilidad entre ciclos
                isFarmTweening = false
            end

            -- Iniciar el bucle constante en Heartbeat
            boxConnection = RunService.Heartbeat:Connect(function()
                farmCycle()
            end)

        else
            -- Apagar y desconectar el bucle de farm de cajas de forma limpia
            if boxConnection then
                boxConnection:Disconnect()
                boxConnection = nil
            end
        end
    end
}, "AutoBoxFarmFlag")










