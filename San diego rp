-- ===== DINERO (ReplicatedStats.Money / RawValue) =====
local function getCurrentMoney()
    -- Path: LocalPlayer.ReplicatedStats.Money
    -- Prefer attribute RawValue (exact number)
    local ok, result = pcall(function()
        local rs = p:FindFirstChild("ReplicatedStats")
            or p:WaitForChild("ReplicatedStats", 2)
        if not rs then return nil end
        local money = rs:FindFirstChild("Money")
        if not money then return nil end

        local raw = money:GetAttribute("RawValue")
        if typeof(raw) == "number" then
            return raw
        end
        if type(raw) == "string" then
            local n = tonumber((raw:gsub(",", "")))
            if n then return n end
        end

        if typeof(money.Value) == "number" then
            return money.Value
        end

        local s = tostring(money.Value or "")
        s = s:gsub("%$", ""):gsub(",", ""):gsub("%s", "")
        local mult = 1
        local last = s:sub(-1):upper()
        if last == "K" then
            mult = 1000
            s = s:sub(1, -2)
        elseif last == "M" then
            mult = 1000000
            s = s:sub(1, -2)
        elseif last == "B" then
            mult = 1000000000
            s = s:sub(1, -2)
        end
        local n = tonumber(s)
        if n then return n * mult end
        return nil
    end)
    if ok and result then return result end

    local ok2, result2 = pcall(function()
        local moneyLabel = p.PlayerGui.MainHUDGui.TopRight.Money.TextLabel
        local t = moneyLabel.Text
        local clean = t:gsub("%$", ""):gsub(",", "")
        return tonumber(clean)
    end)
    if ok2 and result2 then return result2 end
    return 0
end

local function formatMoney(amount)
    if not amount then return "$0" end
    local formatted = tostring(math.floor(amount))
    local isNegative = formatted:sub(1,1) == "-"
    if isNegative then formatted = formatted:sub(2) end

    local k
    while true do
        formatted, k = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return (isNegative and "-$" or "$") .. formatted
end

local function formatTime(sec)
    sec = math.floor(sec or 0)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    if h > 0 then return string.format("%02d:%02d:%02d", h, m, s) end
    return string.format("%02d:%02d", m, s)
end

