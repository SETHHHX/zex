local function aplicarEsteticaNeon(vehiculo)
    if not vehiculo or not vehiculo.Parent then return end
    if currentActiveMission == "GymEquipment" then return end
    for _, part in ipairs(vehiculo:GetDescendants()) do
        if part:IsA("BasePart") then
            local pName = part.Name:lower()
            local parentName = part.Parent and part.Parent.Name:lower() or ""
            local skip = pName:find("root") or pName:find("hitbox") or pName:find("collider")
                or pName:find("chassis") or pName:find("trailer") or pName:find("seat")
                or parentName:find("colliders") or parentName:find("chassis")
            if not skip then
                if not pName:find("window") and not pName:find("glass") then
                    part.Transparency = 0.75
                    part.Color = Color3.fromRGB(130, 0, 255)
                    part.Material = Enum.Material.ForceField
                else
                    part.Transparency = 0.85
                    part.Color = Color3.fromRGB(180, 0, 255)
                end
            end
        end
    end
end

