local HEIGHT_OFFSET = 2.1
local function getGroundHeight(x, z, overrideY)
    local origin = Vector3.new(x, 2000, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local filter = {}
    if p.Character then table.insert(filter, p.Character) end

    local vf = workspace:FindFirstChild("Vehicles")
    if vf then table.insert(filter, vf) end

    -- Solo excluir jugador y vehículos: el raycast DEBE golpear Terrain/Map
    -- (edificios de venta, etc.). No ignorar Map como hace el bank.
    params.FilterDescendantsInstances = filter

    local result = workspace:Raycast(origin, Vector3.new(0, -4000, 0), params)
    if result then return result.Position.Y + HEIGHT_OFFSET end
    if overrideY then return overrideY + HEIGHT_OFFSET end
    return 19 + HEIGHT_OFFSET
end

