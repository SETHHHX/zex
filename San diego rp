                end
            end
            
            if not WantedESP.playersAdded._playerAddedChar then
                WantedESP.playersAdded._playerAddedChar = Players.PlayerAdded:Connect(onPlayerCharacterAdded)
            end
            
            -- Loop principal
            if not WantedESP.connection then
                WantedESP.connection = RunService.Heartbeat:Connect(function()
                    updateAllESP()
                end)
            end
            
            task.wait(0.5)
            updateAllESP()
            
        else
            -- Desconectar eventos
            for key, connection in pairs(WantedESP.playersAdded) do
                if connection and type(connection) == "table" and connection.Disconnect then
                    pcall(function() connection:Disconnect() end)
                end
            end
            WantedESP.playersAdded = {}
            
            -- Desconectar loop
            if WantedESP.connection then
                pcall(function() WantedESP.connection:Disconnect() end)
                WantedESP.connection = nil
            end
            
            -- Limpiar ESPs
            clearAllESP()
        end
    end
}, nil)


-- ENTORNO AISLADO PARA EVITAR EXCESO DE REGISTROS LUAU
task.spawn(function()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")

    local CONFIG = {
        MAX_SPEED = 350,
        MAX_REVERSE_SPEED = 150,
        TURBO_FORCE = 20000,
        REVERSE_FORCE = 10000,
        STEERING_SPEED = 4,
        STEERING_FORCE = 2000,
        STEERING_DAMPING = 0.92,
        MAX_ANGULAR_VEL = 3,
    }

    -- Independent Toggles
    local speedEnabled = false
    local turboEnabled = false
    local steeringEnabled = false

    local vehicle, root = nil, nil
    local throttle, reverse, steerLeft, steerRight = false, false, false, false

    local function GetVehicle()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local seat = hum.SeatPart
        if not seat then return nil end
        
        local current = seat
        while current do
            if current:IsA("Model") then
                local rootPart = current:FindFirstChild("Root")
                if rootPart and rootPart:IsA("BasePart") then
                    return current, rootPart
                end
            end
            current = current.Parent
        end
        return nil
    end

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then throttle = true reverse = false
        elseif input.KeyCode == Enum.KeyCode.S then reverse = true throttle = false
        elseif input.KeyCode == Enum.KeyCode.A then steerLeft = true
        elseif input.KeyCode == Enum.KeyCode.D then steerRight = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then throttle = false
        elseif input.KeyCode == Enum.KeyCode.S then reverse = false
        elseif input.KeyCode == Enum.KeyCode.A then steerLeft = false
        elseif input.KeyCode == Enum.KeyCode.D then steerRight = false
        end
    end)

    RunService.Heartbeat:Connect(function(dt)
        if not speedEnabled and not turboEnabled and not steeringEnabled then return end
        
        if not root or root.Parent == nil then
            vehicle, root = GetVehicle()
            if not root then return end
        end
        
        local vel = root.AssemblyLinearVelocity
        local speed = vel.Magnitude
        local cframe = root.CFrame
        
        -- === STEERING SECTION ===
        if steeringEnabled then
            local steerVal = 0
            if steerLeft then steerVal = -1 end
            if steerRight then steerVal = 1 end
            
            if steerVal ~= 0 then
                root:ApplyImpulse(cframe.RightVector * steerVal * CONFIG.STEERING_FORCE * dt * 60)
                root.AssemblyAngularVelocity = root.AssemblyAngularVelocity + Vector3.new(0, steerVal * CONFIG.STEERING_SPEED * dt * 3, 0)
                
                local angVel = root.AssemblyAngularVelocity
                if math.abs(angVel.Y) > CONFIG.MAX_ANGULAR_VEL then
                    root.AssemblyAngularVelocity = Vector3.new(angVel.X, math.sign(angVel.Y) * CONFIG.MAX_ANGULAR_VEL, angVel.Z)
                end
                
                if speed < 15 then
                    root:ApplyImpulse(cframe.LookVector * steerVal * CONFIG.STEERING_FORCE * 0.12 * dt * 60)
                end
            else
                local angVel = root.AssemblyAngularVelocity
                root.AssemblyAngularVelocity = Vector3.new(angVel.X, angVel.Y * CONFIG.STEERING_DAMPING, angVel.Z)
            end
        end
        
        -- === TURBO SECTION ===
        if turboEnabled then
            if throttle then
                root:ApplyImpulse(cframe.LookVector * CONFIG.TURBO_FORCE * dt * 60)
            end
            if reverse then
                root:ApplyImpulse(-cframe.LookVector * CONFIG.REVERSE_FORCE * dt * 60)
            end
        end
        
        -- === MAX SPEED SECTION ===
        if speedEnabled then
            if speed > CONFIG.MAX_SPEED and throttle then
                root.AssemblyLinearVelocity = vel.Unit * CONFIG.MAX_SPEED
            end
            if reverse and speed > CONFIG.MAX_REVERSE_SPEED then
                root.AssemblyLinearVelocity = vel.Unit * CONFIG.MAX_REVERSE_SPEED
            end
        end
        
        -- Default stability
        if math.abs(vel.Y) > 30 then
            root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * 0.3, vel.Z)
        end
    end)

