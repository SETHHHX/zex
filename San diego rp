-- SPAWN VEHÍCULO
-- =============================================
local function getClosestPodium()
    local rootPart = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local spawnersFolder = workspace:FindFirstChild("VehicleSpawners")
    if not spawnersFolder then return nil end

    local closestPodium, shortest = nil, math.huge
    for _, obj in ipairs(spawnersFolder:GetChildren()) do
        local targetPart = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart"))
        if targetPart then
            local dist = (rootPart.Position - targetPart.Position).Magnitude
            if dist < shortest then
                shortest = dist
                closestPodium = obj
            end
        end
    end
    return closestPodium
end

local function spawnVehicle()
    if isRespawning or not diamondFarmEnabled then return false end
    if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return false end

    if farmVehicleType == "Bike" then
        VEHICLE_MODEL = "Honda_CR250R"
    else
        VEHICLE_MODEL = "Camry6"
    end

    local oldCar = findMyVehicle()
    if oldCar then
        pcall(function() oldCar:Destroy() end)
        task.wait(0.5)
    end

    local podium = getClosestPodium()
    if not podium then return false end

    local success = pcall(function()
        game:GetService("ReplicatedStorage")
            :WaitForChild("__remotes")
            :WaitForChild("VehicleSpawnerService")
            :WaitForChild("SpawnVehicleFromSpawner")
            :InvokeServer(podium, VEHICLE_MODEL)
    end)

    if success then
        vehicleSpawned = true
        task.wait(0.55)
        local newCar = findMyVehicle()
        if newCar then
            local root = getVehicleRoot(newCar)
            if root then
                local pos = root.Position
                if farmVehicleType == "Bike" then
                    local y = getBikeGroundHeight(pos.X, pos.Z, pos.Y, newCar)
                    pcall(function()
                        newCar:PivotTo(uprightBikeCF(Vector3.new(pos.X, y, pos.Z), root.CFrame.LookVector, false))
                        for _, part in ipairs(newCar:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end)
                    softFreezeBike(newCar, true)
                else
                    activateCarNoclip(newCar)
                    for _, part in ipairs(newCar:GetDescendants()) do
                        if part:IsA("BasePart") then part.Anchored = true end
                    end
                end
            end
        end
    end
    return success
end

-- =============================================
-- VERIFICAR VEHÍCULO
-- =============================================
local function verificarYManejarVehiculo()
    if isRespawning or not diamondFarmEnabled then return false end

    -- Tween farm: no vehicle required — pure player movement
    if isTweenFarm() then
        allowOnFootFarm = true
        activatePlayerNoclip()
        return true
    end

    local car = findMyVehicle()
    local spawnPos = POSICIONES.SPAWN_VEHICULOS

    if car then
        local vehicleRoot = getVehicleRoot(car)
        if vehicleRoot then
            local distVeh = (hrp.Position - vehicleRoot.Position).Magnitude
            local distSpawn = (hrp.Position - spawnPos).Magnitude

            -- During ElCapo on-foot buy, car can be >50 studs away — never force reset
            if allowOnFootFarm then
                return true
            end

            if distVeh > 80 and distSpawn > 50 then
                forcePlayerReset()
                return false
            end

            if not h.SeatPart then
                if distVeh > 8 then
                    local tween = TweenService:Create(hrp, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        CFrame = CFrame.new(vehicleRoot.Position + Vector3.new(0, 2, 3))
                    })
                    tween:Play()
                    tween.Completed:Wait()
                end
                subirseConPrompt()
            end
            return true
        end
    else
        if (hrp.Position - spawnPos).Magnitude > 60 then
            forcePlayerReset()
            return false
        end

        if spawnVehicle() then
            task.wait(1)
            local newCar = findMyVehicle()
            if newCar then
                local root = getVehicleRoot(newCar)
                if root then
                    local tween = TweenService:Create(hrp, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        CFrame = CFrame.new(root.Position + Vector3.new(0, 2, 3))
                    })
                    tween:Play()
                    tween.Completed:Wait()
                end
                subirseConPrompt()
                fw(0.5, 0.08)
            end
        end
        return true
    end
    return false
end

-- =============================================
-- COMBUSTIBLE
-- =============================================
local function verificarCombustible()
    local car = findMyVehicle()
    if not car then return true end
    local currentFuel = tonumber(car:GetAttribute("CurrentFuel")) or 0
    local maxFuel = tonumber(car:GetAttribute("MaxFuel")) or 100
    if maxFuel > 0 and (currentFuel / maxFuel) < 0.3 then return false end
    return true
end

local function recargarCombustible()
    if isRespawning or not dragToPosition then return false end
    setStatus("Going to gas station")
    if not dragToPosition(POSICIONES.GASOLINERA) then
        setStatus("Failed to reach gas station")
        return false
    end
    if not diamondFarmEnabled or not h or h.Health <= 0 then return false end

    if not h.SeatPart then
        subirseConPrompt()
        fw(0.5, 0.08)
    end

    -- asegurar que el carro está realmente en la gasolinera
    local gasPos = POSICIONES.GASOLINERA
    local car = findMyVehicle()
    local root = car and getVehicleRoot(car)
    if root then
        local dist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(gasPos.X, 0, gasPos.Z)).Magnitude
        if dist > 12 then
            setStatus("Aligning at gas station...")
            pcall(function()
                local y = getGroundHeight(gasPos.X, gasPos.Z, gasPos.Y)
                car:PivotTo(CFrame.new(gasPos.X, y, gasPos.Z) * root.CFrame.Rotation)
            end)
            task.wait(0.4)
        end
    end
    task.wait(0.6)

    setStatus("Refueling...")
    local function fireRefill(state)
        pcall(function()
            local remote = game:GetService("ReplicatedStorage"):FindFirstChild("__remotes")
            if remote then
                local petrol = remote:FindFirstChild("PetrolStationService")
                if petrol and petrol:FindFirstChild("SetRefilling") then
                    petrol.SetRefilling:FireServer(state)
                end
            end
        end)
    end

    fireRefill(true)
    local t = 0
    local filled = false
    local lastFuel = -1
    while t < 18 do
        task.wait(0.5)
        t = t + 0.5
        car = findMyVehicle()
        if car then
            local cur = tonumber(car:GetAttribute("CurrentFuel")) or 0
            local max = tonumber(car:GetAttribute("MaxFuel")) or 100
            if max > 0 and (cur / max) > 0.9 then
                filled = true
                break
            end
            -- re-disparar si no sube
            if cur <= lastFuel then
                fireRefill(true)
            end
            lastFuel = cur
            setStatus(string.format("Refueling... %.0f%%", max > 0 and (cur / max * 100) or 0))
        end
    end
    fireRefill(false)
    task.wait(0.3)
    return filled or true
end

-- =============================================
-- LIMPIEZA MAPA
-- =============================================
local function eliminarFolders()
    pcall(function()
        local map = workspace:FindFirstChild("Map")
        if not map then return end

        local pb = map:FindFirstChild("PlayerBoundaries")
        if pb then pb:Destroy() end

        local models = map:FindFirstChild("Models")
        if models then
            local singles = models:FindFirstChild("Singles")
            if singles then singles:Destroy() end
        end

        local lss = map:FindFirstChild("LegalStorageSolutions")
        if lss then lss:Destroy() end

        local static = map:FindFirstChild("Static")
        if static then
            -- Map.Static.Locations["United States / San Diego"].LegalStorageSolutions
            local locations = static:FindFirstChild("Locations")
            local usSd = locations and locations:FindFirstChild("United States / San Diego")
            if usSd then
                local lss2 = usSd:FindFirstChild("LegalStorageSolutions")
                if lss2 then lss2:Destroy() end
            end

            -- Map.Static.Global.Models.Singles (force destroy)
            local global = static:FindFirstChild("Global")
            if global then
                local gModels = global:FindFirstChild("Models")
                if gModels then
                    local gSingles = gModels:FindFirstChild("Singles")
                    if gSingles then
                        gSingles:Destroy()
                    end
                    -- also destroy any leftover Singles by deep search under Global
                    for _, d in ipairs(global:GetDescendants()) do
                        if d.Name == "Singles" and d.Parent and d.Parent.Name == "Models" then
                            pcall(function() d:Destroy() end)
                        end
                    end
                end
            end
        end

        -- deep fallback: any Singles under Map.Static
        pcall(function()
            local st = map:FindFirstChild("Static")
            if st then
                for _, d in ipairs(st:GetDescendants()) do
                    if d.Name == "Singles" then
                        pcall(function() d:Destroy() end)
                    end
                end
            end
        end)

        local bm = workspace:FindFirstChild("BlackMarket")
        if bm then bm:Destroy() end
    end)
end


