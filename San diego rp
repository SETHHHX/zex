local function tweenPlayerTo(pos, duration)
    if not hrp or not pos then return end
    duration = duration or (fastModeEnabled and 0.35 or 0.7)
    -- Scale duration a bit with distance so long moves don't look instant
    local dist = (hrp.Position - pos).Magnitude
    if dist > 5 then
        duration = math.clamp(dist / 40, duration, fastModeEnabled and 1.2 or 2.5)
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(pos)
    })
    tween:Play()
    tween.Completed:Wait()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ===== TWEEN FARM: constant speed (studs/s) — Heartbeat (FPS-independent, rollback resilient) =====
cancelActiveTween = function()
    if activeTween then
        pcall(function()
            if type(activeTween) == "table" and activeTween.Cancel then
                activeTween.Cancel()
            elseif activeTween.Cancel then
                activeTween:Cancel()
            end
        end)
        activeTween = nil
    end
end

-- Heartbeat constant-speed move: recalculates from CURRENT position every frame.
-- Survives low FPS and server rollbacks (no TweenService duration desync).
tweenPlayerConstantSpeed = function(targetPos, speed)
    if not hrp or not targetPos then return false end
    if isRespawning or not diamondFarmEnabled then return false end

    speed = math.clamp(tonumber(speed) or tweenFarmSpeed or 200, 40, 400)
    local from = hrp.Position
    local dist0 = (targetPos - from).Magnitude
    if dist0 < 1.5 then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    cancelActiveTween()
    activatePlayerNoclip()
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    pcall(function()
        if crearLineaGuia then crearLineaGuia(hrp, targetPos) end
    end)

    local arriveDist = 2.5
    local maxTime = math.clamp(dist0 / math.max(speed * 0.35, 30) + 20, 12, 220)
    local t0 = os.clock()
    local lastPos = hrp.Position
    local done = false
    local ok = false
    local moveConn = nil

    moveConn = RunService.Heartbeat:Connect(function(dt)
        if done then return end
        if isRespawning or not diamondFarmEnabled or not hrp or not hrp.Parent then
            done = true
            return
        end
        if os.clock() - t0 > maxTime then
            done = true
            return
        end

        -- Cap dt so a lag spike cannot leap hundreds of studs in one frame
        dt = math.clamp(dt or 0.016, 0.001, 0.08)

        local cur = hrp.Position
        -- Server rollback detection: large unexpected jump
        local jump = (cur - lastPos).Magnitude
        local maxStep = speed * 0.08 + 8
        if jump > maxStep + 30 then
            -- rolled back / corrected by server — resume from new position, no snap
            lastPos = cur
        end

        local delta = targetPos - cur
        local dist = delta.Magnitude
        if dist <= arriveDist then
            hrp.CFrame = CFrame.new(targetPos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            done = true
            ok = true
            return
        end

        local lookFlat = Vector3.new(delta.X, 0, delta.Z)
        if lookFlat.Magnitude < 0.05 then
            lookFlat = Vector3.new(0, 0, -1)
        else
            lookFlat = lookFlat.Unit
        end
        local step = math.min(speed * dt, dist)
        local nextPos = cur + delta.Unit * step
        hrp.CFrame = CFrame.lookAt(nextPos, nextPos + lookFlat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        lastPos = nextPos
    end)

    activeTween = {
        Cancel = function()
            done = true
            if moveConn then
                pcall(function() moveConn:Disconnect() end)
                moveConn = nil
            end
        end
    }

    while not done do
        task.wait(0.03)
        if isRespawning or not diamondFarmEnabled then
            done = true
        end
    end
    if moveConn then
        pcall(function() moveConn:Disconnect() end)
        moveConn = nil
    end
    activeTween = nil

    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        local remain = (hrp.Position - targetPos).Magnitude
        -- Soft snap only if already close (avoid hard TP after big rollback)
        if remain > arriveDist and remain < 14 then
            hrp.CFrame = CFrame.new(targetPos)
            ok = true
        elseif remain <= arriveDist then
            ok = true
        end
    end
    pcall(function()
        if limpiarLineaGuia then limpiarLineaGuia() end
    end)
    return ok and diamondFarmEnabled and not isRespawning
end

-- Follow waypoints; on rollback / large desync, re-walk from closest earlier waypoint
followTweenPath = function(waypoints, statusPrefix)
    if type(waypoints) ~= "table" or #waypoints == 0 then return false end

    local function closestWaypointIndex(fromIdx, toIdx, curPos)
        local bestIdx, bestDist = fromIdx, math.huge
        for j = fromIdx, toIdx do
            local d = (curPos - waypoints[j]).Magnitude
            if d < bestDist then
                bestDist = d
                bestIdx = j
            end
        end
        return bestIdx, bestDist
    end

    local i = 1
    local recoverTries = 0
    local maxRecover = #waypoints * 4 + 8

    while i <= #waypoints do
        if not diamondFarmEnabled or isRespawning or not h or h.Health <= 0 then
            return false
        end
        if recoverTries > maxRecover then
            setStatus((statusPrefix or "Path") .. " recover limit")
            return false
        end

        local pos = waypoints[i]
        if statusPrefix then
            setStatus(string.format("%s (%d/%d)", statusPrefix, i, #waypoints))
        end

        local before = hrp and hrp.Position or pos
        local ok = tweenPlayerConstantSpeed(pos, tweenFarmSpeed)

        -- Brief settle so server can confirm position
        task.wait(0.06)

        local cur = hrp and hrp.Position
        if not cur then return false end

        local afterDist = (cur - pos).Magnitude
        -- Rollback / failed arrive: still far from this waypoint
        if (not ok) or afterDist > 35 then
            recoverTries = recoverTries + 1
            local bestIdx = closestWaypointIndex(1, i, cur)
            setStatus(string.format("%s rollback → wp %d/%d", statusPrefix or "Path", bestIdx, #waypoints))
            i = bestIdx
            fw(0.12, 0.04)
        else
            local yanked = (cur - before).Magnitude > 120 and afterDist > 40
            if yanked then
                recoverTries = recoverTries + 1
                local bestIdx = closestWaypointIndex(1, i, cur)
                setStatus(string.format("%s yank → wp %d/%d", statusPrefix or "Path", bestIdx, #waypoints))
                i = bestIdx
                fw(0.12, 0.04)
            else
                i = i + 1
                recoverTries = math.max(0, recoverTries - 1)
                fw(0.08, 0.02)
            end
        end
    end
    return true
end

local function ensureAtSeller(cfg)
    cfg = cfg or getActiveSeller()
    if not isTweenFarm() then
