local arrived = false

local function freezeInertia(part)
    if not part then return end
    pcall(function()
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function anchorCar(car)
    if not car then return end
    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = true end
    end
end

local function unanchorCar(car)
    if not car then return end
    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = false end
    end
end

local function clearForces(part)
    if not part then return end
    for _, child in ipairs(part:GetChildren()) do
        if child.Name == "_BV" or child.Name == "_BG" then child:Destroy() end
    end
end

local function resetWheels(car)
    if not car then return end
    local wheels = car:FindFirstChild("Wheels")
    if not wheels then return end
    for _, child in ipairs(wheels:GetChildren()) do
        local collider = child:FindFirstChild("Collider") or child
        if collider and collider:IsA("BasePart") then
            collider.AssemblyLinearVelocity = Vector3.zero
            collider.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function smoothArrive(car, primary, targetPos, steps)
    if not primary then return end
    local ori = primary.CFrame.Rotation
    local targetHeight = getGroundHeight(targetPos.X, targetPos.Z, targetPos.Y)
    local finalPos = Vector3.new(targetPos.X, targetHeight, targetPos.Z)
    for i = 1, steps do
        freezeInertia(primary)
        car:PivotTo(CFrame.new(primary.Position:Lerp(finalPos, i / steps)) * ori)
        task.wait(1/60)
    end
end

dragToPosition = function(targetPos)
    if isRespawning or not diamondFarmEnabled then return false end
    if not verificarYManejarVehiculo() then return false end

    -- Bike farm: usar drag de moto (fuera de truck mission)
    if shouldUseBikeDrag() then
        return dragBikeToPosition(targetPos, true)
    end

    local car = findMyVehicle()
    if not car then return false end
    local primary = getVehicleRoot(car)
    if not primary then return false end

    if not h.SeatPart then
        subirseConPrompt()
        fw(0.3, 0.05)
        if not h.SeatPart then return false end
    end

    arrived = false
    local extraHeight = (currentActiveMission == "GymEquipment") and 5.0 or 0.0
    local targetGroundY = getGroundHeight(targetPos.X, targetPos.Z, targetPos.Y) + extraHeight
    local endPos = Vector3.new(targetPos.X, targetGroundY, targetPos.Z)

    activateCarNoclip(car)
    activatePlayerNoclip()
    aplicarEsteticaNeon(car)
    unanchorCar(car)
    task.wait(0.05)
    clearForces(primary)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "_BV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = primary

    local bg = Instance.new("BodyGyro")
    bg.Name = "_BG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 10000
    bg.CFrame = primary.CFrame
    bg.Parent = primary

    crearLineaGuia(primary, endPos)

    local stuckCounter = 0
    local lastPosition = primary.Position
    local noclipFrameCheck = 0

    activeLoop = RunService.Stepped:Connect(function()
        if not car or not car.Parent or not primary or not primary.Parent then
            if activeLoop then activeLoop:Disconnect() activeLoop = nil end
            return
        end
        if isRespawning or not diamondFarmEnabled then
            if activeLoop then activeLoop:Disconnect() activeLoop = nil end
            return
        end

        noclipFrameCheck = noclipFrameCheck + 1
        if noclipFrameCheck >= 5 then
            activateCarNoclip(car)
            activatePlayerNoclip()
            noclipFrameCheck = 0
        end

        freezeInertia(primary)
        local cur = primary.Position
        local dir = Vector3.new(endPos.X - cur.X, 0, endPos.Z - cur.Z)
        local dist = dir.Magnitude

        if dist > 1 then
            local distMoved = (cur - lastPosition).Magnitude
            if distMoved < 0.3 then
                stuckCounter = stuckCounter + 1
                if stuckCounter > 15 then
                    resetWheels(car)
                    stuckCounter = 0
                end
            else
                stuckCounter = 0
            end
            lastPosition = cur
        end

        if dist < 6 then
            if activeLoop then activeLoop:Disconnect() activeLoop = nil end
            clearForces(primary)
            freezeInertia(primary)
            smoothArrive(car, primary, targetPos, 15)
            resetWheels(car)
            anchorCar(car)
            deactivateCarNoclip(car)
            deactivatePlayerNoclip()
            limpiarLineaGuia()
            arrived = true
            return
        end

        local groundY = getGroundHeight(cur.X, cur.Z, targetPos.Y) + extraHeight
        local moveDir = dir.Unit
        local heightDifference = groundY - cur.Y
        local speed = getHumanDragSpeed(dragSpeed)
        bv.Velocity = Vector3.new(moveDir.X * speed, heightDifference * 10, moveDir.Z * speed)
        bg.CFrame = CFrame.lookAt(cur, Vector3.new(endPos.X, cur.Y, endPos.Z))
    end)

    local t = 0
    repeat
        task.wait(0.5)
        t = t + 0.5
    until arrived or t >= 60 or isRespawning or not diamondFarmEnabled

    if not arrived then
        if activeLoop then activeLoop:Disconnect() activeLoop = nil end
        clearForces(primary)
        smoothArrive(car, primary, targetPos, 15)
        resetWheels(car)
        anchorCar(car)
        deactivateCarNoclip(car)
        deactivatePlayerNoclip()
        limpiarLineaGuia()
        return false
    end
    return true
end

