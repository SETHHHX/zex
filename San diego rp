-- NOCLIP
-- =============================================
local originalPartStates = {}

local function setNoclip(instance, enable)
    if not instance then return end
    for _, part in ipairs(instance:GetDescendants()) do
        if part:IsA("BasePart") then
            if enable then
                if originalPartStates[part] == nil then
                    originalPartStates[part] = part.CanCollide
                end
                part.CanCollide = false
            else
                if originalPartStates[part] ~= nil then
                    part.CanCollide = originalPartStates[part]
                    originalPartStates[part] = nil
                end
            end
        end
    end
end

local function activatePlayerNoclip()
    if p.Character then setNoclip(p.Character, true) end
end

local function deactivatePlayerNoclip()
    if p.Character then setNoclip(p.Character, false) end
end

local function activateCarNoclip(car)
    if car then setNoclip(car, true) end
end

local function deactivateCarNoclip(car)
    if car then setNoclip(car, false) end
end

-- =============================================
-- SUBIR / BAJAR
-- =============================================
subirseConPrompt = function()
    if isRespawning then return false end
    local car = findMyVehicle()
    if not car then return false end
    local seat = getVehicleSeat(car)
    if not seat then return false end
    if h and h.SeatPart == seat then return true end

    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            if shouldUseBikeDrag() then part.Anchored = false end
        end
    end

    local prompt = seat:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        fireproximityprompt(prompt, 1)
        task.wait(fastModeEnabled and 0.05 or 0.2)
        if farmVehicleType == "Bike" then
            bikeSetNoclip(car, true)
            bikeRefreshNoclip(car)
        else
            activateCarNoclip(car)
        end
        activatePlayerNoclip()
        return true
    end
    return false
end

local function bajarseDelVehiculo()
    if isRespawning or not h or not hrp then return false end

    if h.SeatPart then
        local seat = h.SeatPart
        local car = seat.Parent
        while car and not car:FindFirstChild("Root") do car = car.Parent end
        if car then
            for _, part in ipairs(car:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end

    -- Bike: settle 0.5s at position BEFORE exiting seat (prevents instant hop-off bugs)
    if farmVehicleType == "Bike" then
        task.wait(0.5)
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    h.Sit = false
    if farmVehicleType == "Bike" then
        task.wait(0.5)
    else
        task.wait(0.05)
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    if h.SeatPart then
        h:ChangeState(Enum.HumanoidStateType.Jumping)
        if farmVehicleType == "Bike" then
            task.wait(0.5)
        else
            task.wait(0.05)
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    return not h.SeatPart
end

-- Wait after arriving at a waypoint before exiting vehicle (anti ActionThroughput / humanize)
local function settleAfterArrive(sec)
    sec = sec or 1
    if fastModeEnabled or _G.FastModeEnabled then
        task.wait(math.max(0.35, sec * 0.4))
    else
        -- slight jitter so MachineCycleTiming is not fixed
        if antiDetectEnabled then
            task.wait(sec * (0.85 + math.random() * 0.35))
        else
            task.wait(sec)
        end
    end
end

local function bajarseTrasLlegar()
    settleAfterArrive(1)
    return bajarseDelVehiculo()
end


