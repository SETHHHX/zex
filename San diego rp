do
    local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")

local player = Players.LocalPlayer
local DRAG_SPEED = 900
local HEIGHT_OFFSET = 5          -- Altura de seguridad para evitar baches en el terreno
local LAGPIT_PREDICTION = 0.25   -- Factor de adelanto para posicionarse enfrente del rival con lag
local MIN_SAFE_HEIGHT = -10      -- 🛑 Evita que tu carro baje de aquí si el enemigo cae al vacío

-- Variables de control
local flingTargetName = ""       
local flingEnabled = false        
local lastFlingTarget = ""
local targetVehicleOverride = nil -- Guarda el chasis del coche para seguir atacándolo si se bajan

local activeLoop = nil
local currentCar = nil

-- =============================================
-- ENCONTRAR VEHÍCULO PROPIO
-- =============================================
local function findMyVehicle()
    local folder = workspace:FindFirstChild("Vehicles")
    if not folder then return nil end
    
    for _, v in ipairs(folder:GetChildren()) do
        local ownerId = v:GetAttribute("OwnerUserId")
        if ownerId == player.UserId then
            return v
        end
    end
    return nil
end

local function getVehicleRoot(car)
    if not car then return nil end
    local root = car:FindFirstChild("Root")
    if root and root:IsA("BasePart") then
        return root
    end
    return car:FindFirstChildOfClass("VehicleSeat")
end

-- =============================================
-- OBTENER JUGADORES EN VEHÍCULOS
-- =============================================
local function getPlayersInVehicles()
    local options = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                table.insert(options, plr.Name)
            end
        end
    end
    return options
end

-- OBTENER EL CARRO DE UN OBJETIVO ESPECÍFICO
local function getTargetVehicle(targetPlayerName)
    local tgtPlr = Players:FindFirstChild(targetPlayerName)
    if tgtPlr and tgtPlr.Character then
        local hum = tgtPlr.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
            local car = hum.SeatPart.Parent
            while car and car.Parent ~= workspace.Vehicles and car.Parent ~= workspace do
                car = car.Parent
            end
            return car
        end
    end
    return nil
end

-- =============================================
-- RAYCAST ESTABLE SOBRE EL TERRAIN
-- =============================================
local function getGroundHeight(x, z)
    local origin = Vector3.new(x, 5000, z)
    local direction = Vector3.new(0, -10000, 0)
    local rayParams = RaycastParams.new()
    
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {
        player.Character,
        workspace:FindFirstChild("Vehicles")
    }
    
    local result = workspace:Raycast(origin, direction, rayParams)
    if result then
        return result.Position.Y + HEIGHT_OFFSET
    end
    return 19 + HEIGHT_OFFSET
end

local function clearForces(part)
    if not part then return end
    for _, c in ipairs(part:GetChildren()) do
        if c.Name == "_BV" or c.Name == "_BG" or c.Name == "_AV" then
            c:Destroy()
        end
    end
end

-- =============================================
-- SISTEMA MULTI-TARGET DINÁMICO DE ATAQUE Y RETORNO
-- =============================================
local function startFlingSystem()
    local car = findMyVehicle()
    if not car then return end
    
    local primary = getVehicleRoot(car)
    if not primary then return end
    
    pcall(function()
        primary.Anchored = false
    end)
    
    local bv = Instance.new("BodyVelocity")
    bv.Name = "_BV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = primary
    
    local bg = Instance.new("BodyGyro")
    bg.Name = "_BG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.CFrame = primary.CFrame
    bg.Parent = primary

    local av = Instance.new("AngularVelocity")
    av.Name = "_AV"
    av.MaxTorque = math.huge
    av.AngularVelocity = Vector3.new(0, 99999, 0) 
    av.Enabled = false
    av.Parent = primary
    
    activeLoop = RunService.Stepped:Connect(function()
        if not car or not car.Parent or not primary or not primary.Parent then
            if activeLoop then activeLoop:Disconnect(); activeLoop = nil end
            return
        end
        
        -- NOCLIP DIRECTO POR FRAME
        for _, part in ipairs(car:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        
        -- MODO FLING ACTIVO
        if flingEnabled and flingTargetName ~= "" then
            if lastFlingTarget ~= flingTargetName then
                lastFlingTarget = flingTargetName
                targetVehicleOverride = getTargetVehicle(flingTargetName)
            end
            
            local activeVehicle = getTargetVehicle(flingTargetName)
            if activeVehicle then
                targetVehicleOverride = activeVehicle
            end
            
            local targetRoot = getVehicleRoot(targetVehicleOverride)
            
            if targetRoot and targetVehicleOverride and targetVehicleOverride.Parent then
                local targetVel = targetRoot.AssemblyLinearVelocity or Vector3.zero
                local predictedPos = targetRoot.Position + (targetVel * LAGPIT_PREDICTION)
                
                local cur = primary.Position
                
                -- 🏔️ RESPETAR EL TERRAIN EN CAMINO A LA VÍCTIMA
                local myTerrainHeight = getGroundHeight(cur.X, cur.Z)
                
                -- Filtro anti-suicidio para la altura del objetivo
                local targetY = predictedPos.Y
                if targetY < MIN_SAFE_HEIGHT then
                    targetY = myTerrainHeight
                end
                
                -- Evita enterrarse si el terreno actual está más elevado que la víctima
                if myTerrainHeight > targetY then
                    targetY = myTerrainHeight
                end
                
                local targetPosCorrected = Vector3.new(predictedPos.X, targetY, predictedPos.Z)
                local dir = targetPosCorrected - cur
                
                if dir.Magnitude < 18 then
                    av.Enabled = true
                    primary.CanCollide = true 
                    bv.Velocity = dir.Unit * 1250 
                else
                    av.Enabled = false
                    -- Fuerza vertical calculada dinámicamente para escalar elevaciones sin tirones
                    local horizontalVel = Vector3.new(dir.X, 0, dir.Z).Unit * DRAG_SPEED
                    local verticalVel = (targetY - cur.Y) * 10 
                    
                    bv.Velocity = Vector3.new(horizontalVel.X, verticalVel, horizontalVel.Z)
                end
                
                bg.CFrame = CFrame.lookAt(cur, Vector3.new(targetPosCorrected.X, cur.Y, targetPosCorrected.Z))
            else
                targetVehicleOverride = nil
            end
            
        else
            -- MODO RETORNO a zona segura
            local returnPos = Vector3.new(6903, 18, -17)
            local cur = primary.Position
            local toFinal = Vector3.new(returnPos.X - cur.X, 0, returnPos.Z - cur.Z)
            
            av.Enabled = false
            
            if toFinal.Magnitude < 4 then
                if activeLoop then activeLoop:Disconnect(); activeLoop = nil end
                clearForces(primary)
                primary.AssemblyLinearVelocity = Vector3.zero
                primary.AssemblyAngularVelocity = Vector3.zero
                primary.Anchored = true
                return
            end
            
            local groundY = getGroundHeight(cur.X, cur.Z)
            local vel = toFinal.Unit * DRAG_SPEED
            
            local dY = groundY - cur.Y
            bv.Velocity = Vector3.new(vel.X, dY * 8, vel.Z)
            bg.CFrame = CFrame.lookAt(cur, Vector3.new(returnPos.X, cur.Y, returnPos.Z))
        end
    end)
end

