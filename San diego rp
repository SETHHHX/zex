local function executeTruckMission(missionName)
    if isRespawning then return false end
    if not truckMissionsEnabled or not diamondFarmEnabled then return false end
    -- Hard gate: never run if GUI says unavailable
    if not isTruckMissionReallyAvailable(missionName) then
        setStatus("Truck mission not available: " .. tostring(missionName))
        return false
    end

    -- Ir al NPC con el vehículo personal (bike/car). Mission flag después de subir al camión.
    currentActiveMission = ""
    setStatus("Starting truck mission: " .. missionName .. " [" .. tostring(selectedFarmItem) .. "]")

    -- Ir cerca del trucker
    -- Park car, exit, then walk to NPC to start mission
    local safeSidePos = Vector3.new(7079, 17, 274) -- bajarse aqui
    local npcPos = Vector3.new(7126, 20, 238)      -- empezar mission aqui

    setStatus("Going to truck area...")
    dragToPosition(safeSidePos)
    if not truckMissionsEnabled or not diamondFarmEnabled then return false end

    task.wait(0.15)
    bajarseDelVehiculo()
    fw(0.35, 0.06)
    RestoreAll()
    currentActiveMission = missionName
    task.wait(0.1)

    if hrp then
        hrp.CFrame = CFrame.new(safeSidePos + Vector3.new(0, 3, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.15)

    setStatus("Walking to truck NPC...")
    local startTime = tick()
    while hrp and (hrp.Position - npcPos).Magnitude > 2.5 and (tick() - startTime) < 6 do
        hrp.CFrame = CFrame.new(hrp.Position:Lerp(npcPos, 0.18))
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.03)
    end
    if hrp then
        hrp.CFrame = CFrame.new(npcPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.25)

    -- Iniciar misión (0 = normal, 100 = illegal goods)
    local missionMode = illegalGoodsEnabled and 100 or 0
    if illegalGoodsEnabled then
        setStatus("Starting ILLEGAL goods mission: " .. missionName)
    end
    local missionStarted = false
    for attempt = 1, 3 do
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("__remotes")
                :WaitForChild("TruckService")
                :WaitForChild("StartMission")
                :InvokeServer(missionName, missionMode)
        end)

        local checkTime = 0
        while checkTime < 2.5 do
            if h and h.SeatPart and h.SeatPart:IsA("VehicleSeat") then
                missionStarted = true
                break
            end
            task.wait(0.3)
            checkTime = checkTime + 0.3
        end
        if missionStarted then break end
        task.wait(0.2)
    end

    if not missionStarted then
        setStatus("Truck mission failed to start")
        forcePlayerReset()
        return false
    end

    if not (h.SeatPart and h.SeatPart:IsA("VehicleSeat")) then
        subirseConPrompt()
        fw(0.5, 0.08)
        currentActiveMission = ""
        setStatus("Truck mission failed")
        return false
    end

    -- Ya en el camión: activar mission mode (drag de carro + neon en el camión)
    currentActiveMission = missionName
    stopBikeHold()
    bikePathNoclipHold = false
    local truck = findMyVehicle()
    if truck then
        pcall(function()
            for _, part in ipairs(truck:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = false
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
        activateCarNoclip(truck)
        activatePlayerNoclip()
        if aplicarEsteticaNeon then aplicarEsteticaNeon(truck) end
    end
    setStatus("Truck ready — driving: " .. missionName)

    -- Chequeo gasolina camión (mismas funciones del farm, sin tocar drag)
    if not verificarCombustible() then
        setStatus("Truck low fuel → refueling")
        recargarCombustible()
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
            currentActiveMission = ""
            return false
        end
        if not h.SeatPart then subirseConPrompt() fw(0.5, 0.08) end
    end

    -- ===== COMPRAR ITEM SELECCIONADO (rings / ElCapo) =====
    local function truckAbort()
        currentActiveMission = ""
        return false
    end

    if isElCapoItem() then
        allowOnFootFarm = true
        setStatus("Truck ElCapo path 1")
        dragToPosition(POSICIONES.ELCAPO_IDA_1)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck ElCapo path 2")
        dragToPosition(POSICIONES.ELCAPO_IDA_2)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck ElCapo exit")
        dragToPosition(POSICIONES.ELCAPO_IDA_3)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        settleAfterArrive(1)
        bajarseDelVehiculo()
        fw(0.25, 0.05)
        if hrp then
            hrp.CFrame = CFrame.new(POSICIONES.ELCAPO_IDA_3 + Vector3.new(0, 3, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        if tweenPlayerTo then
            pcall(tweenPlayerTo, POSICIONES.ELCAPO_WALK, fastModeEnabled and 0.45 or 0.8)
        end
        fw(0.15, 0.04)
        local buyPos = getFarmItemBuyPosition()
        if tweenPlayerTo then
            pcall(tweenPlayerTo, buyPos, fastModeEnabled and 0.4 or 0.7)
        elseif hrp then
            hrp.CFrame = CFrame.new(buyPos + Vector3.new(0, 3, 0))
        end
        fw(0.1, 0.03)

        comprarAnillos()
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end
        if getFarmItemBackpackCount() == 0 then return truckAbort() end

        if tweenPlayerTo then
            pcall(tweenPlayerTo, POSICIONES.ELCAPO_WALK, 0.5)
            pcall(tweenPlayerTo, POSICIONES.ELCAPO_IDA_3, 0.45)
        end
        subirseConPrompt()
        fw(0.35, 0.06)
        allowOnFootFarm = false
        notSeatedTime = 0
        if not verificarYManejarVehiculo() then return false end

        setStatus("Truck ElCapo sell 1")
        dragToPosition(POSICIONES.ELCAPO_SELL_1)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck ElCapo sell 2")
        dragToPosition(POSICIONES.ELCAPO_SELL_2)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck ElCapo wait spot")
        dragToPosition(POSICIONES.ELCAPO_SELL_WAIT)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end
    else
        setStatus("Going to buy " .. tostring(selectedFarmItem))
        dragToPosition(POSICIONES.COMPRA)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        bajarseDelVehiculo()
        fw(0.3, 0.05)

        comprarAnillos()
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end
        if getFarmItemBackpackCount() == 0 then return truckAbort() end

        subirseConPrompt()
        fw(0.3, 0.05)
        if not verificarYManejarVehiculo() then return false end

        setStatus("Truck path: post-buy 1")
        dragToPosition(POSICIONES.POST_COMPRA_1)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck path: post-buy 2")
        dragToPosition(POSICIONES.POST_COMPRA_2)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck path: post-buy 3")
        dragToPosition(POSICIONES.POST_COMPRA_3)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end

        setStatus("Truck path: waiting spot")
        dragToPosition(POSICIONES.ESPERA_VENTA)
        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then return truckAbort() end
    end

    -- ===== ESPERAR 7 SEGUNDOS =====
    setStatus("Waiting before selling...")
    local sellWait = (fastModeEnabled and 3) or (6.5 + math.random() * 2.5)
    local waitTime = 0
    while waitTime < sellWait and truckMissionsEnabled and diamondFarmEnabled and not isRespawning do
        task.wait(0.45 + math.random() * 0.2)
        waitTime = waitTime + 0.5
    end
    if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
        currentActiveMission = ""
        return false
    end

    -- ===== VENDER ANILLOS =====
    local sellCfg = pickSellerForCycle() -- lock seller once for this cycle
    local sellVehiclePos = sellCfg.vehiclePos or POSICIONES.VENTA
    setStatus("Going to sell (" .. tostring(activeSellerName) .. ")")
    dragToPosition(sellVehiclePos)
    if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
        currentActiveMission = ""
        return false
    end

    -- fijar carro cerca de venta y bajar bien
    pcall(function()
        local car = findMyVehicle()
        local root = car and getVehicleRoot(car)
        if root then
            local y = getGroundHeight(sellVehiclePos.X, sellVehiclePos.Z, sellVehiclePos.Y)
            car:PivotTo(CFrame.new(sellVehiclePos.X, y, sellVehiclePos.Z) * root.CFrame.Rotation)
        end
    end)
    task.wait(0.15)
    local sellAttempts = 0
    while getFarmItemBackpackCount() > 0 and truckMissionsEnabled and diamondFarmEnabled and not isRespawning do
        sellAttempts = sellAttempts + 1
        setStatus("Truck sell attempt " .. tostring(sellAttempts))
        venderAnillos()
        if getFarmItemBackpackCount() <= 0 then break end
        ensureAtSeller(getActiveSeller())
        if sellAttempts >= 12 then break end
    end
    if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
        currentActiveMission = ""
        return false
    end
    if getFarmItemBackpackCount() > 0 then
        setStatus("Truck could not sell — abort")
        currentActiveMission = ""
        return false
    end
    local waitBc = 0
    while getBriefcaseCount() == 0 and waitBc < 4 and truckMissionsEnabled and not isRespawning do
        task.wait(0.25)
        waitBc = waitBc + 0.25
    end

    subirseConPrompt()
    fw(0.3, 0.05)

    -- ===== HELPERS ENTREGA (igual que la versión buena) =====
    local function findDeliveryPart(excludePart)
        local deliveryFolder = workspace:FindFirstChild("TruckDeliveryPoints")
        if not deliveryFolder then return nil end
        for _, folder in ipairs(deliveryFolder:GetChildren()) do
            local part = folder:FindFirstChild("Part") or folder:FindFirstChildWhichIsA("BasePart")
            if part and part ~= excludePart then
                return part
            end
        end
        return nil
    end

    local function waitAndDeliver(label, excludePart, treatEmptyAsDone)
        local deliveryPoint = nil
        local timeout = 0
        setStatus(label or "Looking for delivery point...")
        repeat
            task.wait(0.3)
            timeout = timeout + 0.3
            deliveryPoint = findDeliveryPart(excludePart)
        until deliveryPoint or timeout > 10 or not truckMissionsEnabled or not diamondFarmEnabled

        if not (deliveryPoint and truckMissionsEnabled and diamondFarmEnabled) then
            return false, nil
        end

        local deliveryPos = deliveryPoint.Position
        local groundY = getGroundHeight(deliveryPos.X, deliveryPos.Z, deliveryPos.Y)
        local finalPos = Vector3.new(deliveryPos.X, groundY, deliveryPos.Z)

        setStatus("Delivering: " .. missionName .. (label and (" (" .. label .. ")") or ""))
        local llegoDestino = dragToPosition(finalPos)
        if not (llegoDestino and truckMissionsEnabled and diamondFarmEnabled) then
            return false, deliveryPoint
        end

        -- Illegal goods: SOLO esperar a que desaparezcan los puntos (sin notificaciones)
        -- Normal: puede usar notificación "Delivery complete!" o puntos vacíos
        setStatus(illegalGoodsEnabled and "Waiting for delivery point to clear..." or "Waiting for delivery complete...")
        local deliveryDone = false
        local spinAngle = 0
        local currentCar = findMyVehicle()
        local spinConnection = nil

        if currentCar then
            spinConnection = RunService.Heartbeat:Connect(function(dt)
                if currentCar and currentCar.Parent then
                    spinAngle = (spinAngle + dt * 900) % 360
                    currentCar:PivotTo(CFrame.new(finalPos) * CFrame.Angles(0, math.rad(spinAngle), 0))
                end
            end)
        end

        local tiempoEspera = 0
        local maxEspera = 30

        while tiempoEspera < maxEspera and truckMissionsEnabled and diamondFarmEnabled and not isRespawning do
            task.wait(0.25)
            tiempoEspera = tiempoEspera + 0.25

            local deliveryFolder = workspace:FindFirstChild("TruckDeliveryPoints")
            local count = 0
            local stillHasThis = false
            if deliveryFolder then
                for _, folder in ipairs(deliveryFolder:GetChildren()) do
                    local part = folder:FindFirstChild("Part") or folder:FindFirstChildWhichIsA("BasePart")
                    if part then
                        count = count + 1
                        if part == deliveryPoint then
                            stillHasThis = true
                        end
                    end
                end
            end

            if illegalGoodsEnabled then
                -- Solo puntos: este punto desapareció → esta entrega lista
                if not stillHasThis then
                    deliveryDone = true
                    break
                end
            else
                -- Normal: notificación o folder vacío / punto desaparecido
                pcall(function()
                    for _, gui in ipairs(p.PlayerGui:GetDescendants()) do
                        if (gui:IsA("TextLabel") or gui:IsA("TextButton")) and gui.Text then
                            local txt = string.lower(gui.Text)
                            if string.find(txt, "delivery complete") then
                                deliveryDone = true
                                break
                            end
                        end
                    end
                end)
                if deliveryDone then break end
                if not stillHasThis then
                    deliveryDone = true
                    break
                end
                if not deliveryFolder or count == 0 then
                    deliveryDone = true
                    break
                end
            end
        end

        if spinConnection then
            spinConnection:Disconnect()
            spinConnection = nil
        end

        return deliveryDone, deliveryPoint
    end

    -- ===== 1ª ENTREGA =====
    local ok1, firstPoint = waitAndDeliver(
        illegalGoodsEnabled and "Delivery #1 (illegal)" or "Looking for delivery point...",
        nil,
        not illegalGoodsEnabled -- si illegal, no tratar vacío como fin total aún
    )

    if not ok1 then
        subirseConPrompt()
        fw(0.5, 0.08)
        currentActiveMission = ""
        setStatus("Truck mission failed (delivery #1)")
        return false
    end

    -- ===== 2ª ENTREGA (solo Illegal Goods) =====
    if illegalGoodsEnabled and truckMissionsEnabled and diamondFarmEnabled and not isRespawning then
        setStatus("Illegal goods: waiting 2nd delivery point...")
        -- esperar a que desaparezca el primero y aparezca el segundo
        local tWait = 0
        local secondPoint = nil
        while tWait < 15 and truckMissionsEnabled and diamondFarmEnabled and not isRespawning do
            secondPoint = findDeliveryPart(firstPoint)
            if secondPoint then break end
            -- a veces el mismo folder se reemplaza: cualquier punto nuevo cuenta
            local folder = workspace:FindFirstChild("TruckDeliveryPoints")
            if folder then
                for _, f in ipairs(folder:GetChildren()) do
                    local part = f:FindFirstChild("Part") or f:FindFirstChildWhichIsA("BasePart")
                    if part and part ~= firstPoint then
                        secondPoint = part
                        break
                    end
                end
            end
            if secondPoint then break end
            task.wait(0.35)
            tWait = tWait + 0.35
        end

        if secondPoint then
            local ok2 = waitAndDeliver("Delivery #2 (illegal)", firstPoint, true)
            if not ok2 then
                -- si falla la 2ª, igual intentamos seguir a lavar/regresar
                setStatus("2nd delivery failed — continuing...")
            end
        else
            setStatus("No 2nd delivery point — continuing...")
        end
    end

    -- ===== LAVAR BRIEFCASES =====
    setStatus("Going to launder briefcases")
    dragToPosition(POSICIONES.LAVADO)
    if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
        currentActiveMission = ""
        return false
    end

    bajarseDelVehiculo()
    fw(0.3, 0.05)
    
    lavarBriefcases() -- Ahora esta función existe
    if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
        currentActiveMission = ""
        return false
    end

    subirseConPrompt()
    fw(0.3, 0.05)

    -- ===== REGRESAR =====
    setStatus("Returning from truck mission...")
    local podiumPos = POSICIONES.SPAWN_SEGURO

    currentCar = findMyVehicle()
    if currentCar then
        unanchorCar(currentCar)
        task.wait(0.2)
    end

    dragToPosition(podiumPos)
    task.wait(0.3)

    bajarseDelVehiculo()
    fw(0.3, 0.05)

    if hrp then
        hrp.CFrame = CFrame.new(podiumPos + Vector3.new(0, 2, 4))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.3)

    currentCar = findMyVehicle()
    if currentCar then
        pcall(function() currentCar:Destroy() end)
        task.wait(0.5)
    end

    vehicleSpawned = false
    local spawned = spawnVehicle()
