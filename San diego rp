        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        comprarAnillos()
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end
        if getFarmItemBackpackCount() == 0 then return false end

        if not verificarYManejarVehiculo() then return false end

        setStatus("Post-buy path 1")
        resetHumanSpeed()
        dragToPosition(POSICIONES.POST_COMPRA_1)
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        setStatus("Post-buy path 2")
        resetHumanSpeed()
        dragToPosition(POSICIONES.POST_COMPRA_2)
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        setStatus("Post-buy path 3")
        resetHumanSpeed()
        dragToPosition(POSICIONES.POST_COMPRA_3)
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        setStatus("Going to waiting spot before selling")
        resetHumanSpeed()
        dragToPosition(POSICIONES.ESPERA_VENTA)
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        setStatus("Waiting for sell cooldown...")
        local waitSell = (fastModeEnabled and 2) or (6 + math.random() * 2)
        local espera = 0
        while espera < waitSell and diamondFarmEnabled and h and h.Health > 0 and not isRespawning do
            task.wait(0.5)
            espera = espera + 0.5
        end
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        local sellCfg = pickSellerForCycle()
        local sellVehiclePos = sellCfg.vehiclePos or POSICIONES.VENTA

        setStatus("Going to sell (" .. tostring(activeSellerName) .. ")")
        resetHumanSpeed()
        dragToPosition(sellVehiclePos)
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

        pcall(function()
            local car = findMyVehicle()
            local root = car and getVehicleRoot(car)
            if root then
                local y = getGroundHeight(sellVehiclePos.X, sellVehiclePos.Z, sellVehiclePos.Y)
                car:PivotTo(CFrame.new(sellVehiclePos.X, y, sellVehiclePos.Z) * root.CFrame.Rotation)
            end
        end)
        task.wait(0.15)
        local sellAttempts = 0
        while getFarmItemBackpackCount() > 0 and diamondFarmEnabled and h and h.Health > 0 and not isRespawning do
            sellAttempts = sellAttempts + 1
            setStatus("Selling attempt " .. tostring(sellAttempts))
            venderAnillos()
            if getFarmItemBackpackCount() <= 0 then break end
            setStatus("Sell retry — re-approach seller")
            ensureAtSeller(getActiveSeller())
            if sellAttempts >= 12 then
                setStatus("Sell stuck after many tries")
                break
            end
        end
        if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end
        if getFarmItemBackpackCount() > 0 then
            setStatus("Could not sell all items — abort cycle")
            return false
        end
        local waitBc = 0
        while getBriefcaseCount() == 0 and waitBc < 8 and diamondFarmEnabled and not isRespawning do
            task.wait(0.25)
            waitBc = waitBc + 0.25
        end
        if getBriefcaseCount() == 0 then
            setStatus("No briefcase after sell — abort")
            return false
        end
    end

    if not verificarYManejarVehiculo() then return false end

    setStatus("Traveling to checkpoint")
    resetHumanSpeed()
    dragToPosition(POSICIONES.PASO_2)
    if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

    setStatus("Going to launder briefcases")
    resetHumanSpeed()
    POSICIONES.LAVADO = Vector3.new(6810, 17, -35)
    dragToPosition(Vector3.new(6810, 17, -35))
    if not diamondFarmEnabled or not h or h.Health <= 0 or isRespawning then return false end

    lavarBriefcases()
    setStatus("Cycle completed")
    -- No post-cycle cooldown — go straight to next farm cycle

    return true
end

