local function getFarmItemBackpackCount()
    local count = 0
    local name = selectedFarmItem or "Fake Diamond Ring"
    for _, item in ipairs(p.Backpack:GetChildren()) do
        if item.Name == name then count = count + 1 end
    end
    if c and c:FindFirstChild(name) then count = count + 1 end
    return count
end

-- legacy alias
local function getFakeDiamondsCount()
    return getFarmItemBackpackCount()
end

local function getBriefcaseCount()
    local count = 0
    for _, item in ipairs(p.Backpack:GetChildren()) do
        if item.Name == "Briefcase" then count = count + 1 end
    end
    return count
end

local function comprarAnillos()
    if isRespawning then return end
    local itemName = selectedFarmItem or "Fake Diamond Ring"
    setStatus("Buying " .. itemName .. "...")

    -- Tween farm: already at buy pos via path — never seat
    if isTweenFarm() then
        -- stay on foot
    elseif not isElCapoItem() then
        bajarseDelVehiculo()
        fw(0.25, 0.05)
    end

    local buyPos = getFarmItemBuyPosition()
    if hrp and buyPos and not isTweenFarm() then
        local dist = (hrp.Position - buyPos).Magnitude
        if dist > 4 and dist < 40 then
            if tweenPlayerTo then
                pcall(tweenPlayerTo, buyPos, fastModeEnabled and 0.35 or 0.55)
            else
                hrp.CFrame = CFrame.new(buyPos + Vector3.new(0, 3, 0))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            fw(0.15, 0.04)
        elseif dist >= 40 and isElCapoItem() then
            setStatus("Buying near ElCapo (no long TP)")
        elseif dist >= 40 then
            if tweenPlayerTo then
                pcall(tweenPlayerTo, buyPos, fastModeEnabled and 0.4 or 0.7)
            else
                hrp.CFrame = CFrame.new(buyPos + Vector3.new(0, 3, 0))
            end
            fw(0.2, 0.05)
        end
    end

    local targetAmt = getFarmBuyAmount()
    local timeout = 0
    local maxTimeout = fastModeEnabled and 4 or 10
    local waitTime = fastModeEnabled and 0.01 or 0.03

    while getFarmItemBackpackCount() < targetAmt and diamondFarmEnabled and h and h.Health > 0 and not isRespawning do
        if timeout >= maxTimeout then break end
        pcall(function()
            local inst = getFarmItemInstance()
            if not inst then return end
            game:GetService("ReplicatedStorage"):WaitForChild("__remotes")
                :WaitForChild("WorldBuyableItemService")
                :WaitForChild("PurchaseWorldBuyableItem")
                :FireServer(inst)
        end)
        humanActionWait(math.floor(timeout * 20))
        task.wait(waitTime)
        timeout = timeout + (fastModeEnabled and 0.02 or 0.05)
    end
    fw(0.2, 0.05)
    -- Rings: sit after buy (not in Tween mode). ElCapo: caller handles vehicle return.
    if not isElCapoItem() and not isTweenFarm() then
        subirseConPrompt()
    end
end



local function venderAnillos()
    if isRespawning then return end
    -- Use LOCKED seller from this cycle (do not re-roll Random)
    local cfg = getActiveSeller()
    local itemName = selectedFarmItem or "Fake Diamond Ring"
    setStatus("Selling " .. itemName .. " at " .. tostring(activeSellerName) .. "...")
    ensureAtSeller(cfg)

    local prevItems = getFarmItemBackpackCount()
    local prevBrief = getBriefcaseCount()
    if prevItems <= 0 then
        setStatus("Nothing to sell")
        return true
    end

    local timeout = 0
    -- Much longer window: keep trying until sold
    local maxTimeout = fastModeEnabled and 90 or 180
    local noProgress = 0
    local attempts = 0
    local soldOk = false
    local lastReposition = 0

    -- Keep selling until ALL bought items leave backpack
    while diamondFarmEnabled and h and h.Health > 0 and not isRespawning do
        local itemsLeft = getFarmItemBackpackCount()
        local briefs = getBriefcaseCount()

        if itemsLeft <= 0 then
            soldOk = true
            break
        end

        local sellPos = getSellerPosition(cfg)
        local distToSell = (hrp and sellPos) and (hrp.Position - sellPos).Magnitude or 0
        -- Reposition if far OR periodically if no progress (possible silent rollback)
        if hrp and sellPos and (distToSell > 10 or (noProgress >= 4 and (os.clock() - lastReposition) > 1.2)) then
            setStatus("Reposition sell (" .. tostring(activeSellerName) .. ")...")
            ensureAtSeller(cfg)
            lastReposition = os.clock()
            noProgress = 0
        end

        fireSell(cfg)
        attempts = attempts + 1
        local t0 = os.clock()
        humanActionWait(attempts)
        timeout = timeout + (os.clock() - t0)

        local nowItems = getFarmItemBackpackCount()
        local nowBrief = getBriefcaseCount()
        if nowItems < prevItems then
            ringsSold = ringsSold + (prevItems - nowItems)
            prevItems = nowItems
            noProgress = 0
        elseif nowBrief > prevBrief then
            prevBrief = nowBrief
            noProgress = 0
        else
            noProgress = noProgress + 1
        end

        if noProgress > 5 then
            ensureAtSeller(cfg)
            fireSell(cfg)
            attempts = attempts + 1
            humanActionWait(attempts)
            noProgress = 0
            lastReposition = os.clock()
        end

        if timeout > maxTimeout then
            setStatus("Sell still trying — items left: " .. tostring(getFarmItemBackpackCount()))
            timeout = 0
            ensureAtSeller(cfg)
            if not diamondFarmEnabled or isRespawning then break end
            for _ = 1, 8 do
                if getFarmItemBackpackCount() <= 0 then break end
                fireSell(cfg)
                humanActionWait(attempts)
                attempts = attempts + 1
            end
            if getFarmItemBackpackCount() <= 0 then
                soldOk = true
                break
            end
            break
        end
    end

    local extra = 0
    while getFarmItemBackpackCount() > 0 and extra < 6 and diamondFarmEnabled and not isRespawning do
        fireSell(cfg)
        task.wait(0.25)
        extra = extra + 0.25
    end

    if getFarmItemBackpackCount() <= 0 then
        soldOk = true
        setStatus("Sold all " .. itemName)
    else
        setStatus("Sell incomplete — items left: " .. tostring(getFarmItemBackpackCount()))
    end

    task.wait(0.2 + math.random() * 0.25)
    return soldOk
end


local function lavarBriefcases()
    if isRespawning then return end
    setStatus("Laundering briefcases...")

    local last = getBriefcaseCount()
    if last == 0 then
        if not isTweenFarm() then
            subirseConPrompt()
        end
        return
    end

    -- bajar + arrastre suave a la posición de lavado
    ensureAtLaunder()

    local maxAttempts = fastModeEnabled and 100 or 60
    local attempts = 0
    local standPos = getLaunderStandPos()

    while getBriefcaseCount() > 0 and diamondFarmEnabled and h and h.Health > 0 and not isRespawning and attempts < maxAttempts do
        if hrp and standPos and (hrp.Position - standPos).Magnitude > 12 then
            if isTweenFarm() then
                tweenPlayerConstantSpeed(standPos, tweenFarmSpeed)
            else
                tweenPlayerTo(standPos, fastModeEnabled and 0.3 or 0.55)
            end
        end

        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("__remotes")
                :WaitForChild("SmuggleService")
                :WaitForChild("LaunderBriefcase")
                :FireServer(getLaunderPromptPart())
        end)
        attempts = attempts + 1
        humanActionWait(attempts)

        if attempts % 10 == 0 then
            local cur = getBriefcaseCount()
            if cur < last then
                washesDone = washesDone + (last - cur)
                last = cur
            end
        end
    end

    local remaining = getBriefcaseCount()
    if remaining < last then
        washesDone = washesDone + (last - remaining)
    end

    fw(0.3, 0.05)
    if not isTweenFarm() then
        subirseConPrompt()
    end
end

