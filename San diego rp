startUnifiedFarm = function()
    if mainLoopThread then return end
    if isRespawning then
        task.wait(2)
        if diamondFarmEnabled then task.spawn(startUnifiedFarm) end
        return
    end

    eliminarFolders()
    vehicleSpawned = false
    notSeatedTime = 0
    resetStats()

    if statsUIEnabled then createStatsUI() end
    if autoRecoverEnabled then startSeatWatcher() end

    mainLoopThread = task.spawn(function()
        while diamondFarmEnabled and not isRespawning do
            if not p.Character or not p.Character.Parent then
                p.CharacterAdded:Wait()
                c = p.Character
                h = c:WaitForChild("Humanoid")
                hrp = c:WaitForChild("HumanoidRootPart")
                task.wait(0.5)
                if not (diamondFarmEnabled and not isRespawning) then break end
                continue
            end

            if not h or h.Health <= 0 then
                RestoreAll()
                vehicleSpawned = false
                repeat task.wait(0.5) until p.Character and p.Character ~= c and p.Character.Parent
                c = p.Character
                h = c:WaitForChild("Humanoid")
                hrp = c:WaitForChild("HumanoidRootPart")
                task.wait(1)
                if not (diamondFarmEnabled and not isRespawning) then break end
                continue
            end

            if not verificarYManejarVehiculo() then
                task.wait(0.5)
                continue
            end

            -- Tween farm: no seat required
            if not isTweenFarm() then
                if not h.SeatPart or h.Health <= 0 or not diamondFarmEnabled or isRespawning then
                    task.wait(0.5)
                    continue
                end
            elseif h.Health <= 0 or not diamondFarmEnabled or isRespawning then
                task.wait(0.5)
                continue
            end

            -- Prioridad bank:
            --  BankRobberyActive = robo en curso → esperar
            --  BankWantsPriority = quiere empezar → no iniciar ciclo nuevo (sin trabarse)
            if _G.BankRobberyActive then
                setStatus("Waiting for bank robbery...")
                local waitBank = 0
                while _G.BankRobberyActive and diamondFarmEnabled and not isRespawning do
                    task.wait(0.4)
                    waitBank = waitBank + 0.4
                    if waitBank >= 180 then
                        _G.BankRobberyActive = false
                        _G.BankWantsPriority = false
                        setStatus("Bank active timeout → resume farm")
                        break
                    end
                end
                if not (diamondFarmEnabled and not isRespawning) then break end
                continue
            end
            if _G.BankWantsPriority then
                task.wait(0.35)
                continue
            end

            -- ===== TRUCK MISSIONS + DIAMOND FARM =====
            -- Tween mode cannot run truck missions (needs vehicle)
            if truckMissionsEnabled and isTweenFarm() then
                setStatus("Truck Missions need Vehicle — switching to farm only")
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Truck Missions",
                        Text = "You must farm with Vehicle for Truck Missions. Tween mode only farms items.",
                        Duration = 6,
                    })
                end)
                task.wait(1)
            end

            -- Rotate through ALL available truck missions (not stuck on the first one)
            if truckMissionsEnabled and not isTweenFarm() then
                -- Short refresh only (avoid long idle between truck missions)
                task.wait(fastModeEnabled and 0.08 or 0.2)

                local availableMissions = getAvailableMissions()
                local ranTruck = false

                if #availableMissions > 0 then
                    -- Round-robin: prefer the next mission after the last completed one
                    local ordered = {}
                    local startIdx = 1
                    if lastTruckMissionName then
                        for i, n in ipairs(availableMissions) do
                            if n == lastTruckMissionName then
                                startIdx = i + 1
                                if startIdx > #availableMissions then
                                    startIdx = 1
                                end
                                break
                            end
                        end
                    end
                    for i = startIdx, #availableMissions do
                        table.insert(ordered, availableMissions[i])
                    end
                    for i = 1, startIdx - 1 do
                        table.insert(ordered, availableMissions[i])
                    end

                    local truckList = p.PlayerGui:FindFirstChild("TruckShopGui")
                        and p.PlayerGui.TruckShopGui.Frame
                        and p.PlayerGui.TruckShopGui.Frame.TruckList

                    for _, missionName in ipairs(ordered) do
                        if not truckMissionsEnabled or not diamondFarmEnabled or isRespawning then
                            break
                        end

                        -- Re-check RIGHT before starting (never start if unavailable)
                        if not isTruckMissionReallyAvailable(missionName) then
                            continue
                        end

                        setStatus("Next truck mission: " .. tostring(missionName))
                        lastTruckMissionName = missionName
                        _G.FarmCycleActive = true
                        local ok, err = pcall(executeTruckMission, missionName)
                        _G.FarmCycleActive = false
                        ranTruck = true
                        if not ok then
                            setStatus("Truck error: " .. tostring(err))
                            pcall(RestoreAll)
                            task.wait(1)
                        else
                            pcall(RestoreAll)
                            task.wait(fastModeEnabled and 0.12 or 0.3)
                        end
                        break -- one truck mission per loop pass, then re-scan
                    end
                end

                if not ranTruck then
                    -- No truck free right now → diamond cycle, trucks checked again next pass
                    _G.FarmCycleActive = true
                    local ok, err = pcall(executeDiamondFarm)
                    _G.FarmCycleActive = false
                    if not ok then
                        setStatus("Farm error: " .. tostring(err))
                        pcall(RestoreAll)
                        task.wait(1)
                    end
                end
            else
                _G.FarmCycleActive = true
                local ok, err = pcall(executeDiamondFarm)
                _G.FarmCycleActive = false
                if not ok then
                    setStatus("Farm error: " .. tostring(err))
                    pcall(RestoreAll)
                    task.wait(1)
                end
            end

            task.wait(0.05) -- no post-cycle humanWait; loops immediately
        end
        mainLoopThread = nil
        _G.FarmCycleActive = false
        -- Si el toggle sigue ON, reiniciar el loop (anti-stuck)
        if diamondFarmEnabled and not isRespawning then
            setStatus("Farm loop restart...")
            task.wait(1)
            if diamondFarmEnabled and startUnifiedFarm then
                startUnifiedFarm()
            end
        else
            setStatus("Idle")
        end
    end)
end

stopUnifiedFarm = function()
    truckMissionsEnabled = false
    running = false
    diamondFarmEnabled = false
    allowOnFootFarm = false
    setStatus("Stopping...")

    if mainLoopThread then
        pcall(function() task.cancel(mainLoopThread) end)
        mainLoopThread = nil
    end
    if activeLoop then
        activeLoop:Disconnect()
        activeLoop = nil
    end
    if seatWatchConnection then
        seatWatchConnection:Disconnect()
        seatWatchConnection = nil
    end

    -- Soft stop only: cancel movement, NO teleport to spawn
    task.spawn(function()
        cancelActiveTween()
        if activeLoop then
            pcall(function() activeLoop:Disconnect() end)
            activeLoop = nil
        end

        local car = findMyVehicle()
        if car then
            local primary = getVehicleRoot(car)
            if primary then
                clearForces(primary)
                freezeInertia(primary)
            end
            for _, part in ipairs(car:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end

        limpiarLineaGuia()
        pcall(RestoreAll)
        setStatus("Idle")
    end)
end

