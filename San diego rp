local sectionCount = 0

-- Registry so Save/Load Config can re-apply values
local FlagRegistry = {} -- [flag] = { kind, callback, current }

local function registerFlag(flag, kind, callback, initial)
    if not flag or flag == "" then return end
    FlagRegistry[flag] = {
        kind = kind,
        callback = callback,
        current = initial,
    }
end

local function setFlagValue(flag, value)
    local entry = FlagRegistry[flag]
    if entry then
        entry.current = value
        if type(entry.callback) == "function" then
            pcall(entry.callback, value)
        end
    end
    pcall(function()
        if Library and Library._config and Library._config._flags then
            Library._config._flags[flag] = value
        end
    end)
end

local function wrapModule(module)
    local api = {}

    function api:Toggle(opts, flag)
        opts = opts or {}
        local f = flag or opts.Name
        local cb = opts.Callback or function() end
        local wrapped = function(v)
            registerFlag(f, "toggle", cb, v)
            if FlagRegistry[f] then FlagRegistry[f].current = v end
            cb(v)
        end
        registerFlag(f, "toggle", cb, opts.Default)
        module:create_toggle({
            title = opts.Name or "Toggle",
            flag = f,
            default = opts.Default,
            callback = wrapped,
        })
        return api
    end

    function api:Slider(opts, flag)
        opts = opts or {}
        local f = flag or opts.Name
        local cb = opts.Callback or opts.onInputComplete or function() end
        local init = opts.Default or opts.Minimum or 0
        local wrapped = function(v)
            if FlagRegistry[f] then FlagRegistry[f].current = v end
            cb(v)
        end
        registerFlag(f, "slider", cb, init)
        module:create_slider({
            title = opts.Name or "Slider",
            flag = f,
            minimum_value = opts.Minimum or 0,
            maximum_value = opts.Maximum or 100,
            value = init,
            round_number = true,
            callback = wrapped,
        })
        return api
    end

    function api:Dropdown(opts, flag)
        opts = opts or {}
        local options = opts.Options or {"None"}
        if type(options) ~= "table" or #options == 0 then options = {"None"} end
        local default = opts.Default
        if type(default) == "number" then default = options[default] end
        local f = flag or opts.Name
        local cb = opts.Callback or function() end
        local wrapped = function(v)
            if FlagRegistry[f] then FlagRegistry[f].current = v end
            cb(v)
        end
        registerFlag(f, "dropdown", cb, default)
        local dd = module:create_dropdown({
            title = opts.Name or "Dropdown",
            flag = f,
            options = options,
            multi_dropdown = opts.Multi == true,
            default = default,
            callback = wrapped,
        })
        function dd:ClearOptions() end
        function dd:InsertOptions(list)
            list = list or {"None"}
            if #list == 0 then list = {"None"} end
            return dd
        end
        function dd:UpdateSelection(val)
            pcall(function() dd:Set(val) end)
        end
        return dd
    end

    function api:Button(opts, flag)
        opts = opts or {}
        module:create_button({
            title = opts.Name or "Button",
            callback = opts.Callback or function() end,
        })
        return api
    end

    function api:Input(opts, flag)
        opts = opts or {}
        if module.create_textbox then
            module:create_textbox({
                title = opts.Name or "Input",
                flag = flag or opts.Name,
                placeholder = opts.Placeholder or "",
                callback = opts.Callback or opts.onChanged or function() end,
            })
        end
        return api
    end

    function api:Paragraph(opts, flag)
        opts = opts or {}
        return module:create_paragraph({
            Header = opts.Header or opts.Name or "Info",
            Body = opts.Body or "",
        })
    end

    function api:Divider(opts)
        opts = opts or {}
        if module.create_divider then
            module:create_divider({
                showtopic = opts.Name ~= nil and opts.Name ~= "",
                title = opts.Name or "",
            })
        end
        return api
    end

    function api:Spacer()
        if module.create_divider then
            module:create_divider({ showtopic = false })
        end
        return api
    end

    function api:Colorpicker(opts, flag)
        opts = opts or {}
        if module.create_colorpicker then
            module:create_colorpicker({
                title = opts.Name or "Color",
                flag = flag or opts.Name,
                default = opts.Default or Color3.fromRGB(255, 255, 255),
                callback = opts.Callback or function() end,
            })
        end
        return api
    end

    return api
end

local function createTab(name, icon)
    local tab = Window:create_tab(name, icon or "rbxassetid://89270463071386")
    local tabAPI = {}
    function tabAPI:Section(opts)
        opts = opts or {}
        sectionCount = sectionCount + 1
        local side = (opts.Side == "Right") and "right" or "left"
        local title = opts.Name or (name .. " " .. tostring(sectionCount))
        local mod = tab:create_module({
            title = title,
            flag = "sec_" .. name .. "_" .. tostring(sectionCount),
            description = "",
            section = side,
            showToggle = false,
            callback = function() end,
        })
        return wrapModule(mod)
    end
    function tabAPI:Select() end
    function tabAPI:InsertConfigSection() end
    return tabAPI
end

