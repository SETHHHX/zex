-- FUNCIÓN QUE ELIMINA TODO EXCEPTO LA CARPETA MODELS (NO TOCA NADA DENTRO)
-- =============================================================================
local function deleteMap()
    local map = workspace:FindFirstChild("Map")
    if not map then return false end

    -- Solo eliminar hijos directos de Map que NO sean "Models"
    local mapChildren = map:GetChildren()
    for _, child in ipairs(mapChildren) do
        if child.Name ~= "Models" then
            pcall(function()
                child:Destroy()
            end)
        end
    end

    return true
end

local function deleteVehiclesExceptMine()
    if deletingVehicles then return end
    deletingVehicles = true
   
    local myVehicle = findMyVehicle()
   
    local vehiclesFolder = workspace:FindFirstChild("Vehicles")
    if not vehiclesFolder then
        deletingVehicles = false
        return
    end
   
    local vehiclesToDelete = {}
    for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
        table.insert(vehiclesToDelete, vehicle)
    end
   
    for _, vehicle in ipairs(vehiclesToDelete) do
        if myVehicle and vehicle == myVehicle then
            continue
        end
        deleteVehicle(vehicle)
        task.wait(0.05)
    end
   
    deletingVehicles = false
end

local function startVehicleDeletionLoop()
    if vehicleLoop then
        return
    end
   
    deleteVehiclesExceptMine()
    deleteMap()
   
    vehicleLoop = RunService.Heartbeat:Connect(function()
        if not deletingVehicles then
            deleteVehiclesExceptMine()
        end
    end)
end

local function stopVehicleDeletionLoop()
    if vehicleLoop then
        vehicleLoop:Disconnect()
        vehicleLoop = nil
    end
    deletingVehicles = false
end

