local antiDetectEnabled = true

local function humanWait(minSec, maxSec)
    if not antiDetectEnabled then
        return -- no extra pause when humanize is OFF
    end
    if fastModeEnabled or _G.FastModeEnabled then
        task.wait(0.05 + math.random() * 0.15)
        return
    end
    minSec = minSec or 1
    maxSec = maxSec or 10
    if maxSec < minSec then maxSec = minSec end
    local t = minSec + math.random() * (maxSec - minSec)
    task.wait(t)
end

-- Speed that changes over time (not constant) when antiDetect is ON
local _humanSpeedValue = 180
local _humanSpeedNextChange = 0
local function getHumanDragSpeed(base)
    base = math.clamp(base or dragSpeed or 180, 80, 250)
    if not antiDetectEnabled then
        -- Still micro-vary a bit so Mean/Cv is not perfectly flat (SellSpeedConstant)
        local jitter = 0.92 + math.random() * 0.16
        return math.clamp(base * jitter, 80, 250)
    end
    local now = os.clock()
    if now >= _humanSpeedNextChange then
        -- re-roll often so MovingMean / MovingCv look human
        _humanSpeedNextChange = now + (0.35 + math.random() * 1.6)
        local factor = 0.55 + math.random() * 0.7 -- ~55%..125% of base
        local roll = math.random()
        if roll < 0.18 then
            factor = factor * (0.4 + math.random() * 0.35) -- slow dip
        elseif roll > 0.88 then
            factor = factor * (1.05 + math.random() * 0.15) -- brief push
        end
        -- Hard cap 250 — never exceed (MaxSpeed flag)
        _humanSpeedValue = math.clamp(base * factor, 70, 250)
    end
    return _humanSpeedValue
end

local function resetHumanSpeed()
    _humanSpeedNextChange = 0
    _humanSpeedValue = math.clamp(dragSpeed or 180, 80, 250)
end

-- Anti ActionThroughput: variable delay between remote fires
local function humanActionWait(attempt)
    attempt = attempt or 0
    if not antiDetectEnabled then
        -- original fixed-ish waits
        if fastModeEnabled or _G.FastModeEnabled then
            task.wait(0.015)
        else
            task.wait(0.05)
        end
        return
    end
    if fastModeEnabled or _G.FastModeEnabled then
        task.wait(0.012 + math.random() * 0.028)
        if attempt > 0 and attempt % math.random(5, 9) == 0 then
            task.wait(0.05 + math.random() * 0.12)
        end
        return
    end
    task.wait(0.04 + math.random() * 0.10)
    if attempt > 0 and attempt % math.random(3, 7) == 0 then
        task.wait(0.18 + math.random() * 0.55)
    end
end

