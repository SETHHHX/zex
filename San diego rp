userInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not enabled then return end 
    
    if input.KeyCode == toggleKey then
        isAiming = not isAiming
        if not isAiming then
            currentTarget = nil -- Limpiar objetivo al dejar de apuntar
        end
    end
end)

-- Bucle principal de Renderizado UNIFICADO usando mousemoverel
runService.RenderStepped:Connect(function()
    updateFov()
    
    if not enabled or not isAiming then 
        currentTarget = nil
        return 
    end
    
    local target = getTarget()
    if target then
        local pos = predict(target)
        if pos then
            local screen = cam:WorldToViewportPoint(pos)
            local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            local delta = Vector2.new(screen.X, screen.Y) - center
            local div = (cfg.smooth <= 0) and 1 or cfg.smooth
            
            pcall(function()
                mousemoverel(delta.X / div, delta.Y / div)
            end)
        end
    else
        currentTarget = nil
    end
end)

