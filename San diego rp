RunService.RenderStepped:Connect(function()
    if not ESPConfig.Master then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        -- LÓGICA DEL TEAM CHECK:
        if ESPConfig.TeamCheck and player.Team == LocalPlayer.Team then
            if Cache[player] then
                Cache[player].Box.Visible = false
                Cache[player].Name.Visible = false
                Cache[player].HealthBar.Visible = false
                Cache[player].HealthText.Visible = false
                for _, line in pairs(Cache[player].Bones) do line.Visible = false end
                if Cache[player].Highlight then 
                    Cache[player].Highlight:Destroy() 
                    Cache[player].Highlight = nil
                end
            end
            continue
        end
        
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            CreateESP(player)
            local esp = Cache[player]

            -- Render de Highlight
            if ESPConfig.Highlights and character then
                if not esp.Highlight or esp.Highlight.Parent ~= character then
                    if esp.Highlight then esp.Highlight:Destroy() end
                    
                    local hl = Instance.new("Highlight")
                    hl.Name = "ESP_Highlight"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)      
                    hl.FillTransparency = 0.5                     
                    hl.OutlineColor = Color3.fromRGB(255, 0, 0)   
                    hl.OutlineTransparency = 0                    
                    hl.Adornee = character
                    hl.Parent = character
                    esp.Highlight = hl
                end
            else
                if esp.Highlight then
                    esp.Highlight:Destroy()
                    esp.Highlight = nil
                end
            end

            -- Verificar si el jugador está en pantalla
            local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            
            if onScreen then
                -- Calcular tamaño dinámico de la caja basado en la distancia
                local scale = 1 / (screenPos.Z * 0.05) * 100
                local boxWidth = math.clamp(scale, 10, 150)
                local boxHeight = math.clamp(scale * 1.5, 15, 220)
                
                local boxX = screenPos.X - boxWidth / 2
                local boxY = screenPos.Y - boxHeight / 2
                
                -- 1. Render de Caja
                if ESPConfig.Boxes then
                    esp.Box.Size = Vector2.new(boxWidth, boxHeight)
                    esp.Box.Position = Vector2.new(boxX, boxY)
                    esp.Box.Visible = true
                else
                    esp.Box.Visible = false
                end
                
                -- 2. Render de Nombre
                if ESPConfig.Names then
                    esp.Name.Text = player.Name
                    esp.Name.Position = Vector2.new(screenPos.X, boxY - 20)
                    esp.Name.Visible = true
                else
                    esp.Name.Visible = false
                end
                
                -- 3. CORREGIDO: Render de Health Seguro (Anti-Glitches/Anti-NaN)
                if ESPConfig.Health then
                    -- Evitamos divisiones por cero o valores negativos extraños
                    local maxHealth = humanoid.MaxHealth
                    if maxHealth <= 0 then maxHealth = 100 end 
                    
                    -- Forzamos que el porcentaje esté siempre entre 0 y 1 de forma estricta
                    local healthPercent = math.clamp(humanoid.Health / maxHealth, 0, 1)
                    local barHeight = boxHeight * healthPercent
                    
                    -- Posicionar correctamente la barra sin valores NaN
                    esp.HealthBar.Size = Vector2.new(3, barHeight)
                    esp.HealthBar.Position = Vector2.new(boxX - 6, boxY + (boxHeight - barHeight))
                    esp.HealthBar.Color = Color3.fromHSV(healthPercent * 0.33, 1, 1)
                    esp.HealthBar.Visible = true
                    
                    -- Texto numérico de vida corregido
                    esp.HealthText.Text = tostring(math.floor(humanoid.Health))
                    esp.HealthText.Position = Vector2.new(boxX - 22, boxY + (boxHeight - barHeight) - 2)
                    esp.HealthText.Visible = true
                else
                    esp.HealthBar.Visible = false
                    esp.HealthText.Visible = false
                end
                
                -- 4. Render de Esqueleto (Bones)
                if ESPConfig.Bones then
                    for index, bonePair in ipairs(R15Bones) do
                        local partA = character:FindFirstChild(bonePair[1])
                        local partB = character:FindFirstChild(bonePair[2])
                        local line = esp.Bones[index]
                        
                        if partA and partB and line then
                            local posA, onScreenA = Camera:WorldToViewportPoint(partA.Position)
                            local posB, onScreenB = Camera:WorldToViewportPoint(partB.Position)
                            
                            if onScreenA and onScreenB then
                                line.From = Vector2.new(posA.X, posA.Y)
                                line.To = Vector2.new(posB.X, posB.Y)
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        elseif line then
                            line.Visible = false
                        end
                    end
                else
                    for _, line in pairs(esp.Bones) do line.Visible = false end
                end
                
            else
                -- Si está vivo pero fuera de la pantalla, ocultamos los dibujos 2D por completo
                if Cache[player] then
                    Cache[player].Box.Visible = false
                    Cache[player].Name.Visible = false
                    Cache[player].HealthBar.Visible = false
                    Cache[player].HealthText.Visible = false
                    for _, line in pairs(Cache[player].Bones) do line.Visible = false end
                end
            end
        else
            RemoveESP(player)
        end
    end
end)

