local function isMissionSelected(missionName)
    if type(selectedMissions) ~= "table" then
        return true
    end
    -- map style: { ["All Missions"] = true }
    if selectedMissions["All Missions"] == true then
        return true
    end
    if selectedMissions[missionName] == true then
        return true
    end
    -- array style: { "All Missions", "CarParts" }
    for _, v in pairs(selectedMissions) do
        if v == true then
            -- skip pure map values
        elseif type(v) == "string" then
            if v == "All Missions" or v == missionName then
                return true
            end
        end
    end
    return false
end

local function getTruckList()
    local gui = p.PlayerGui:FindFirstChild("TruckShopGui")
    if not gui then return nil end
    local frame = gui:FindFirstChild("Frame")
    if not frame then return nil end
    return frame:FindFirstChild("TruckList")
end

-- Strict availability (same rules as original MacLib script)
local function isTruckMissionReallyAvailable(missionName)
    if type(missionName) ~= "string" or missionName == "" then
        return false
    end
    if not isMissionSelected(missionName) then
        return false
    end
    local truckList = getTruckList()
    if not truckList then
        return false -- NO gui = NOT available (do not guess)
    end
    local missionGui = truckList:FindFirstChild(missionName)
    if not missionGui then
        return false
    end
    -- Original checks: Overlay or Data means not available
    if missionGui:FindFirstChild("Overlay") then
        return false
    end
    if missionGui:FindFirstChild("Data") then
        return false
    end
    if missionGui:FindFirstChild("Locked") then
        return false
    end
    -- Some UIs use visible lock frames
    for _, child in ipairs(missionGui:GetDescendants()) do
        local n = string.lower(child.Name)
        if (n == "overlay" or n == "locked" or n == "lock" or n == "cooldown") and child:IsA("GuiObject") then
            if child.Visible then
                return false
            end
        end
    end
    return true
end

local function getAvailableMissions()
    local available = {}
    local truckList = getTruckList()
    if not truckList then
        return available
    end
    for _, missionName in ipairs(MISSION_LIST) do
        if isTruckMissionReallyAvailable(missionName) then
            table.insert(available, missionName)
        end
    end
    return available
end

