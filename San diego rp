-- Dibujar esquinas de Corner Box con sombra
local function DrawCornerBox(lines, x, y, w, h, color)
    local l = math.min(w, h) * 0.25
    local index = 1

    local corners = {
        -- Top Left
        {Vector2.new(x, y), Vector2.new(x + l, y)},
        {Vector2.new(x, y), Vector2.new(x, y + l)},
        -- Top Right
        {Vector2.new(x + w, y), Vector2.new(x + w - l, y)},
        {Vector2.new(x + w, y), Vector2.new(x + w, y + l)},
        -- Bottom Left
        {Vector2.new(x, y + h), Vector2.new(x + l, y + h)},
        {Vector2.new(x, y + h), Vector2.new(x, y + h - l)},
        -- Bottom Right
        {Vector2.new(x + w, y + h), Vector2.new(x + w - l, y + h)},
        {Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - l)}
    }

    -- Líneas negras de sombra (atrás)
    for _, c in ipairs(corners) do
        local line = lines[index]
        line.From = c[1]
        line.To = c[2]
        line.Color = Color3.fromRGB(0, 0, 0)
        line.Thickness = 3.5
        line.Visible = true
        index = index + 1
    end

    -- Líneas de color principal (frente)
    for _, c in ipairs(corners) do
        local line = lines[index]
        line.From = c[1]
        line.To = c[2]
        line.Color = color
        line.Thickness = 1.5
        line.Visible = true
        index = index + 1
    end
end

