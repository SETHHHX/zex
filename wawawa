-- Función auxiliar para limpiar los dibujos de un jugador específico
local function RemoveESP(player)
    if Cache[player] then
        if Cache[player].Box then Cache[player].Box:Remove() end
        if Cache[player].Name then Cache[player].Name:Remove() end
        if Cache[player].HealthBar then Cache[player].HealthBar:Remove() end 
        if Cache[player].HealthText then Cache[player].HealthText:Remove() end 
        if Cache[player].Bones then
