-- ===== CONTROL DEL CICLO MULTI-FARM UNIFICADO =====
local function startUnifiedFarm()
    if mainLoopThread then return end
    
    local blackMarket = workspace:FindFirstChild("BlackMarket")
    if blackMarket then blackMarket:Destroy() end
    
    mainLoopThread = task.spawn(function()
        while diamondFarmEnabled do 
            c = p.Character or p.CharacterAdded:Wait()
            h = c:WaitForChild("Humanoid")
            
            if isPlayerJailed() then
                RestoreAll()
                task.wait(5)
                continue
            end
            
            if h.Health <= 0 then
                RestoreAll()
                p.CharacterAdded:Wait()
                task.wait(2)
                continue
            end
            
            -- Intento de spawnear y subirse al carro si estamos a pie
            if not h.SeatPart and diamondFarmEnabled then
                RestoreAll()
                
                local spawned = spawnVehicle()
                if spawned then
                    local timeout = 0
                    repeat 
                        for _, veg in ipairs(workspace.Vehicles:GetChildren()) do
                            if veg:FindFirstChild("Body") then
                                local rootPart = veg:FindFirstChild("Root") or veg:FindFirstChild("HumanoidRootPart")
                                if rootPart and c.HumanoidRootPart then
                                    local dist = (c.HumanoidRootPart.Position - rootPart.Position).Magnitude
                                    if dist < 35 then
                                        subirseConPrompt(veg)
                                        break
                                    end
                                end
                            end
                        end
                        task.wait(0.5)
                        timeout = timeout + 0.5
                    until h.SeatPart or timeout > 5 or not diamondFarmEnabled or h.Health <= 0
                end
            end

            if not h.SeatPart or h.Health <= 0 or not diamondFarmEnabled then
                warn("⚠️ Forzando espera: No se pudo subir al vehículo spaneado. Reintentando...")
                task.wait(1)
                continue
            end

            -- Ciclo de ejecución normal con coche asegurado
            if truckMissionsEnabled then
                local availableMissions = getAvailableMissions()
                
                if #availableMissions > 0 then
                    local missionName = availableMissions[1]
                    
                    local stillAvailable = false
                    local truckList = p.PlayerGui:FindFirstChild("TruckShopGui") 
                        and p.PlayerGui.TruckShopGui.Frame.TruckList
                    if truckList then
                        local missionGui = truckList:FindFirstChild(missionName)
                        if missionGui and not missionGui:FindFirstChild("Overlay") and not missionGui:FindFirstChild("Cooldown") then
                            stillAvailable = true
                        end
                    end
                    
                    if stillAvailable and truckMissionsEnabled and diamondFarmEnabled then
                        executeTruckMission(missionName)
                        task.wait(0.5)
                        RestoreAll()
                    else
                        executeDiamondFarm()
                    end
                else
                    executeDiamondFarm()
                end
            else
                executeDiamondFarm()
            end
            
            task.wait(1)
        end
        
        mainLoopThread = nil
    end)
end

local function stopUnifiedFarm()
    truckMissionsEnabled = false
    diamondFarmEnabled = false
    running = false
    
    task.spawn(function()
        local posSalidaSegura = Vector3.new(6881, 17, -31)
