-- ===== FUNCIONES DE AYUDA Y RESTAURACIÓN FISICA =====

local originalState = {}
local function guardarFisicas(modelo)
    if not modelo then return end
    for _, part in ipairs(modelo:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalState[part] == nil then
                originalState[part] = {
                    CanCollide = part.CanCollide
                }
            end
        end
    end
end

local function RestoreAll()
    if noclipConnection then 
        noclipConnection:Disconnect() 
        noclipConnection = nil
    end
    if heartbeatConnection then 
        heartbeatConnection:Disconnect() 
        heartbeatConnection = nil
    end
    if currentFreezeConnection then 
        currentFreezeConnection:Disconnect() 
        currentFreezeConnection = nil
    end
    
    if h and h.SeatPart then
        local v = h.SeatPart.Parent
        while v and not v:FindFirstChild("Root") do v = v.Parent end
        if v and v:FindFirstChild("Root") then
            v.Root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            v.Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end
    
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end

    for part, data in pairs(originalState) do
        if part and part.Parent then
            if data.CanCollide ~= nil then part.CanCollide = data.CanCollide end
        end
    end
    table.clear(originalState)
    running = false
end

_G.StopCarMovement = function()
    RestoreAll()
end

local function freezeVehicleAt(targetPos)
    if currentFreezeConnection then currentFreezeConnection:Disconnect() end
    if h and h.SeatPart then
        local v = h.SeatPart.Parent
        while v and not v:FindFirstChild("Root") do v = v.Parent end
        local r = v and v:FindFirstChild("Root")
        if r then
            currentFreezeConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if running or not r or not r.Parent then 
                    if currentFreezeConnection then currentFreezeConnection:Disconnect() currentFreezeConnection = nil end
                    return 
                end
                r.CFrame = CFrame.new(targetPos)
                r.AssemblyLinearVelocity = Vector3.new(0,0,0)
                r.AssemblyAngularVelocity = Vector3.new(0,0,0)
            end)
        end
    end
end

local function getClosestPodium()
    local character = p.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local spawnersFolder = workspace:WaitForChild("VehicleSpawners")
    local closestPodium = nil
    local shortestDistance = math.huge
    
    for _, obj in ipairs(spawnersFolder:GetChildren()) do
        local targetPart = nil
        if obj:IsA("BasePart") then
            targetPart = obj
        elseif obj:IsA("Model") then
            targetPart = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
        else
            targetPart = obj:FindFirstChildOfClass("BasePart")
        end
        
        if targetPart and targetPart.Position then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestPodium = obj
            end
        end
    end
    return closestPodium
end

