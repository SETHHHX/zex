task.spawn(function()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")

    local CONFIG = {
        MAX_SPEED = 350,
        MAX_REVERSE_SPEED = 150,
        TURBO_FORCE = 20000,
        REVERSE_FORCE = 10000,
        STEERING_SPEED = 4,
        STEERING_FORCE = 2000,
        STEERING_DAMPING = 0.92,
        MAX_ANGULAR_VEL = 3,
    }

    -- Independent Toggles
    local speedEnabled = false
    local turboEnabled = false
    local steeringEnabled = false

    local vehicle, root = nil, nil
    local throttle, reverse, steerLeft, steerRight = false, false, false, false

    local function GetVehicle()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local seat = hum.SeatPart
        if not seat then return nil end
        
        local current = seat
        while current do
            if current:IsA("Model") then
                local rootPart = current:FindFirstChild("Root")
                if rootPart and rootPart:IsA("BasePart") then
                    return current, rootPart
                end
            end
            current = current.Parent
        end
        return nil
    end

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then throttle = true reverse = false
        elseif input.KeyCode == Enum.KeyCode.S then reverse = true throttle = false
        elseif input.KeyCode == Enum.KeyCode.A then steerLeft = true
        elseif input.KeyCode == Enum.KeyCode.D then steerRight = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then throttle = false
        elseif input.KeyCode == Enum.KeyCode.S then reverse = false
        elseif input.KeyCode == Enum.KeyCode.A then steerLeft = false
        elseif input.KeyCode == Enum.KeyCode.D then steerRight = false
        end
    end)

    RunService.Heartbeat:Connect(function(dt)
        if not speedEnabled and not turboEnabled and not steeringEnabled then return end
        
        if not root or root.Parent == nil then
            vehicle, root = GetVehicle()
            if not root then return end
        end
        
        local vel = root.AssemblyLinearVelocity
        local speed = vel.Magnitude
        local cframe = root.CFrame
        
        -- === STEERING SECTION ===
        if steeringEnabled then
            local steerVal = 0
            if steerLeft then steerVal = -1 end
            if steerRight then steerVal = 1 end
            
            if steerVal ~= 0 then
                root:ApplyImpulse(cframe.RightVector * steerVal * CONFIG.STEERING_FORCE * dt * 60)
                root.AssemblyAngularVelocity = root.AssemblyAngularVelocity + Vector3.new(0, steerVal * CONFIG.STEERING_SPEED * dt * 3, 0)
                
                local angVel = root.AssemblyAngularVelocity
                if math.abs(angVel.Y) > CONFIG.MAX_ANGULAR_VEL then
                    root.AssemblyAngularVelocity = Vector3.new(angVel.X, math.sign(angVel.Y) * CONFIG.MAX_ANGULAR_VEL, angVel.Z)
                end
                
                if speed < 15 then
                    root:ApplyImpulse(cframe.LookVector * steerVal * CONFIG.STEERING_FORCE * 0.12 * dt * 60)
                end
            else
                local angVel = root.AssemblyAngularVelocity
                root.AssemblyAngularVelocity = Vector3.new(angVel.X, angVel.Y * CONFIG.STEERING_DAMPING, angVel.Z)
            end
        end
        
        -- === TURBO SECTION ===
        if turboEnabled then
            if throttle then
                root:ApplyImpulse(cframe.LookVector * CONFIG.TURBO_FORCE * dt * 60)
            end
            if reverse then
                root:ApplyImpulse(-cframe.LookVector * CONFIG.REVERSE_FORCE * dt * 60)
            end
        end
        
        -- === MAX SPEED SECTION ===
        if speedEnabled then
            if speed > CONFIG.MAX_SPEED and throttle then
                root.AssemblyLinearVelocity = vel.Unit * CONFIG.MAX_SPEED
            end
            if reverse and speed > CONFIG.MAX_REVERSE_SPEED then
                root.AssemblyLinearVelocity = vel.Unit * CONFIG.MAX_REVERSE_SPEED
            end
        end
        
        -- Default stability
        if math.abs(vel.Y) > 30 then
            root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * 0.3, vel.Z)
        end
    end)

    -- ==========================================
    -- INTERFAZ DE USUARIO CON EXPLICACIONES (UI)
    -- ==========================================

    --- MODULE 1: MAX SPEED ---
    Vehiclesmod:Paragraph({
        Header = "MAX SPEED SYSTEM",
        Body = "<font color='#FFD700'><b>Toggle this feature to enforce a strict velocity boundary.</b></font> "
    }, "MaxSpeedParagraph")

    Vehiclesmod:Toggle({
        Name = "Enable Max Speed Limit",
        Default = false,
        Callback = function(Value)
            speedEnabled = Value
        end
    }, "SpeedToggle")

    Vehiclesmod:Slider({
        Name = "Max Speed Value",
        Default = 350,
        Minimum = 10,
        Maximum = 1000,
        DisplayMethod = "Value",
        Precision = 0,
        Callback = function(Value)
            CONFIG.MAX_SPEED = Value
        end
    }, "MaxSpeedSlider")

    --- MODULE 2: ACCELERATION / TURBO ---
    Vehiclesmod:Paragraph({
        Header = "TURBO ACCELERATION",
        Body = "<font color='#FFD700'><b>Adds extra vector impulse forces when pressing forward or backward.</b></font> "
    }, "TurboParagraph")

    Vehiclesmod:Toggle({
        Name = "Enable Turbo Acceleration",
        Default = false,
        Callback = function(Value)
            turboEnabled = Value
            if not Value then
                throttle, reverse = false, false
            end
        end
    }, "TurboToggle")

    Vehiclesmod:Slider({
        Name = "Acceleration Force",
        Default = 20000,
        Minimum = 1000,
        Maximum = 20000,
        DisplayMethod = "Value",
        Precision = 0,
        Callback = function(Value)
            CONFIG.TURBO_FORCE = Value
        end
    }, "TurboForceSlider")

    --- MODULE 3: STEERING ---
    Vehiclesmod:Paragraph({
        Header = "PERFECT STEERING",
        Body = "<font color='#FFD700'><b>Forces precision handling dynamics relative to the vehicle orientation.</b></font> "
    }, "SteeringParagraph")

    Vehiclesmod:Toggle({
        Name = "Enable Perfect Steering",
        Default = false,
        Callback = function(Value)
            steeringEnabled = Value
            if not Value then
                steerLeft, steerRight = false, false
            end
        end
    }, "SteeringToggle")

    Vehiclesmod:Slider({
        Name = "Steering Force",
        Default = 2000,
        Minimum = 100,
        Maximum = 2000,
        DisplayMethod = "Value",
        Precision = 0,
        Callback = function(Value)
            CONFIG.STEERING_FORCE = Value
        end
    }, "SteeringForceSlider")
end)









do -- BLOQUE AISLADO PARA LIBERAR REGISTROS (Evita el límite de 200 locales)
    local Config = {
        RADIUS = 200, -- Se actualizará dinámicamente con el Slider
        RETURN_POSITION = Vector3.new(2816, 18, 108),
        TWEEN_SPEED = 300
    }

    local Services = {
        Players = game:GetService("Players"),
        RunService = game:GetService("RunService"),
        ReplicatedStorage = game:GetService("ReplicatedStorage"),
        TweenService = game:GetService("TweenService"),
        Teams = game:GetService("Teams")
    }

    local State = {
        isTweening = false,
        loopConnection = nil
    }

    local LocalPlayer = Services.Players.LocalPlayer
    local BorderService = Services.ReplicatedStorage:WaitForChild("__remotes"):WaitForChild("BorderAuthorisationService")
    local GrantRemote = BorderService:WaitForChild("GrantEntry")
    local InspectionRemote = BorderService:WaitForChild("SendToInspection")

    local VisualCircle = Instance.new("CylinderHandleAdornment")
    VisualCircle.Color3 = Color3.fromRGB(0, 255, 120)
    VisualCircle.Transparency = 0.7
    VisualCircle.Radius = Config.RADIUS
    VisualCircle.Height = 0.2
    VisualCircle.CFrame = CFrame.Angles(math.rad(90), 0, 0)
    VisualCircle.AlwaysOnTop = false
    VisualCircle.Parent = workspace

    local Funcs = {}

    function Funcs.isGranted(player) return player:GetAttribute("Granted") == true end
    function Funcs.isBeingInspected(player) return player:GetAttribute("InspectionActive") == true end
    function Funcs.isFromMexico(player) return player:GetAttribute("FromMexico") == true end
    function Funcs.isWantedBorderStampAllowed(player) return player:GetAttribute("WantedBorderStampAllowed") == true end
    
    function Funcs.hasWantedLevel(player)
        local wantedLevel = player:GetAttribute("WantedLevel")
        return typeof(wantedLevel) == "number" and wantedLevel > 0
    end

    function Funcs.isStampReady(player)
        local lastStamped = player:GetAttribute("LastStamped")
        if type(lastStamped) == "number" then return (os.clock() - lastStamped) >= 3 end
        return true
    end

    function Funcs.canGrantEntry(player)
        if player.Team == Services.Teams.Civilian and not Funcs.hasWantedLevel(player) and Funcs.isStampReady(player) then
            return not Funcs.isGranted(player) and (Funcs.isFromMexico(player) or (Funcs.isBeingInspected(player) or Funcs.isWantedBorderStampAllowed(player)))
        end
        return false
    end

    function Funcs.canSendToInspection(player)
        if player.Team == Services.Teams.Civilian and not Funcs.hasWantedLevel(player) and Funcs.isStampReady(player) then
            if Funcs.isGranted(player) then return false end
            return not Funcs.isBeingInspected(player) and (Funcs.isFromMexico(player) or Funcs.isWantedBorderStampAllowed(player))
        end
        return false
    end

    function Funcs.equipStamp()
        local character = LocalPlayer.Character
        if not character then return false end
        if character:FindFirstChild("Stamp") then return true end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local stamp = backpack:FindFirstChild("Stamp")
            if stamp then stamp.Parent = character return true end
        end
        return false
    end

    function Funcs.tweenCharacter(targetCFrame)
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local duration = distance / Config.TWEEN_SPEED
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local tween = Services.TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end

    function Funcs.checkPlayersInRadius()
        if State.isTweening then return end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        VisualCircle.Adornee = hrp
        VisualCircle.Radius = Config.RADIUS
        VisualCircle.CFrame = CFrame.new(0, -3.2, 0) * CFrame.Angles(math.rad(90), 0, 0)
        
        for _, player in ipairs(Services.Teams.Civilian:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = player.Character.HumanoidRootPart
                local distance = (hrp.Position - targetHrp.Position).Magnitude
                
                if distance <= Config.RADIUS then
                    if Funcs.hasWantedLevel(player) or not Funcs.isStampReady(player) then continue end
                    local isGrantable = Funcs.canGrantEntry(player)
                    local isInspectable = Funcs.canSendToInspection(player)
                    
                    if isGrantable or isInspectable then
                        local equipped = Funcs.equipStamp()
                        if not equipped then continue end
                        
                        State.isTweening = true
                        player:SetAttribute("LastStamped", os.clock())
                        
                        local targetPos = targetHrp.CFrame * CFrame.new(0, 0, 2)
                        Funcs.tweenCharacter(targetPos)
                        task.wait(0.05)
                        
                        pcall(function()
                            if isGrantable then GrantRemote:InvokeServer(player)
                            elseif isInspectable then InspectionRemote:InvokeServer(player) end
                        end)
                        
                        Funcs.tweenCharacter(CFrame.new(Config.RETURN_POSITION))
                        task.wait(0.2)
                        State.isTweening = false
                        break
                    end
                end
            end
        end
    end

    LocalPlayer.CharacterRemoving:Connect(function()
        VisualCircle.Adornee = nil
        State.isTweening = false
    end)




    PoliceXp:Paragraph({
    Header = "AUTO STAMP SYSTEM",
    Body = "<font color='#00FF7F'><b>Automatically equips your Stamp and scans for eligible civilian players within your custom radius.</b></font> "
}, "AutoStampDescription")


    -- Slider para configurar el Rango/Tamaño
    PoliceXp:Slider({
        Name = "Scan Radius",
        Default = 200,
        Minimum = 10,
        Maximum = 300,
        DisplayMethod = "Value",
        Precision = 0,
        Callback = function(Value)
            Config.RADIUS = Value
            -- Actualizar el tamaño visual al instante si el círculo está activo
            if VisualCircle.Adornee then
                VisualCircle.Radius = Value
            end
        end,
        onInputComplete = function(Value)
            Config.RADIUS = Value
        end
    }, "StampRadiusSlider")



    
    -- Ejecución del Toggle
    PoliceXp:Toggle({
        Name = "Auto Stamp",
        Default = false,
        Callback = function(Value)
            if Value then
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - Config.RETURN_POSITION).Magnitude > 2 then
                    State.isTweening = true
                    Funcs.tweenCharacter(CFrame.new(Config.RETURN_POSITION))
                    State.isTweening = false
                end

                if State.loopConnection then State.loopConnection:Disconnect() end
                State.loopConnection = Services.RunService.Heartbeat:Connect(function()
                    Funcs.checkPlayersInRadius()
                end)
            else
                if State.loopConnection then
                    State.loopConnection:Disconnect()
                    State.loopConnection = nil
                end
                VisualCircle.Adornee = nil
                State.isTweening = false
            end
        end
    }, "AutoStampToggle")
end





local boxConnection = nil -- Variable global para controlar el bucle del Auto Farm

PoliceXp:Toggle({
