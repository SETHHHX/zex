    local aimlockEnabled = false      -- Controla si el candado está activado o no
    local showFOV = true
    local teamCheck = false
    local aimlockTarget = nil
    local aimlockPart = "Head"
    local fovSize = 150
    local smoothness = 0.15

    local aimlockLoop = nil
    local fovLoop = nil
    local fovCircle = nil

    --// Variables para el botón móvil
    local isDragging = false
    local dragStart = nil
