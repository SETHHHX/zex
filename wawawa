-- VARIABLES GLOBALES (fuera del toggle)
-- ============================================
local WantedESP = {
    enabled = false,
    espObjects = {},
    connection = nil,
    playersAdded = {},
    playersRemoving = {},
}

-- ============================================
-- FUNCIONES DEL ESP
-- ============================================
local function createESPForPlayer(player)
    if player == game:GetService("Players").LocalPlayer or not player.Character then
        return nil
    end
    
    if WantedESP.espObjects[player] then
        return WantedESP.espObjects[player]
    end
    
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local WantedLevelUtil = require(ReplicatedStorage.SharedModules.WantedLevelUtil)
    local LocalPlayer = game:GetService("Players").LocalPlayer
    
    local wantedLevel = WantedLevelUtil.GetWantedLevelAttribute(player)
    local wantedStage = WantedLevelUtil.GetLevel(wantedLevel)
    
    if wantedStage == 0 then
        return nil
    end
    
    local character = player.Character
    if not character or not character.Parent then
        return nil
    end
    
    -- Highlight ROJO
    local highlight = Instance.new("Highlight")
    highlight.Name = "WantedESP_Highlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.35
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.15
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    local head = character:FindFirstChild("Head") or character.PrimaryPart
    if not head then
        highlight:Destroy()
        return nil
    end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "WantedESP_Billboard"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 100, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character
    
    local frame = Instance.new("Frame")
    frame.Name = "Frame"
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = billboard
    
    -- Estrellas ROJAS
    local wantedLabel = Instance.new("TextLabel")
    wantedLabel.Name = "WantedLabel"
    wantedLabel.Size = UDim2.new(1, 0, 1, 0)
    wantedLabel.BackgroundTransparency = 1
    wantedLabel.Text = string.rep("⭐", wantedStage)
    wantedLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    wantedLabel.TextScaled = true
    wantedLabel.Font = Enum.Font.SourceSansBold
    wantedLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    wantedLabel.TextStrokeTransparency = 0.2
    wantedLabel.Parent = frame
    
    local espData = {
        player = player,
        character = character,
        highlight = highlight,
        billboard = billboard,
        frame = frame,
        wantedLabel = wantedLabel,
        head = head,
        lastStage = wantedStage
    }
    
    WantedESP.espObjects[player] = espData
    return espData
end

local function updateESP(espData)
    if not espData or not espData.player then
        return false
    end
    
    local player = espData.player
    if not player or not player.Parent then
        return false
    end
    
    local character = player.Character
    if not character or not character.Parent then
        return false
    end
    
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local WantedLevelUtil = require(ReplicatedStorage.SharedModules.WantedLevelUtil)
    local LocalPlayer = game:GetService("Players").LocalPlayer
    
    local wantedLevel = WantedLevelUtil.GetWantedLevelAttribute(player)
    local wantedStage = WantedLevelUtil.GetLevel(wantedLevel)
    
    if wantedStage == 0 then
        return false
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    if not rootPart then
        return false
    end
    
    local localRoot = LocalPlayer.Character and 
                     (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character.PrimaryPart)
    
    if localRoot then
        local distance = (rootPart.Position - localRoot.Position).Magnitude
        if distance > 10000 then
            espData.billboard.Enabled = false
            espData.highlight.Enabled = false
            return true
        else
            espData.billboard.Enabled = true
            espData.highlight.Enabled = true
        end
    end
    
    -- Mantener ROJO siempre
    espData.highlight.FillColor = Color3.fromRGB(255, 0, 0)
    espData.wantedLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    
    if espData.lastStage ~= wantedStage then
        espData.wantedLabel.Text = string.rep("⭐", wantedStage)
        espData.lastStage = wantedStage
    end
    
    if espData.highlight.Adornee ~= character then
        espData.highlight.Adornee = character
    end
    
    local head = character:FindFirstChild("Head") or character.PrimaryPart
    if head and espData.billboard.Adornee ~= head then
        espData.billboard.Adornee = head
        espData.head = head
    end
    
    return true
end

local function removeESP(player)
    local espData = WantedESP.espObjects[player]
    if not espData then
        return
    end
    
    if espData.highlight then
        espData.highlight:Destroy()
    end
    if espData.billboard then
        espData.billboard:Destroy()
    end
    
    WantedESP.espObjects[player] = nil
end

local function clearAllESP()
    for player, espData in pairs(WantedESP.espObjects) do
        if espData.highlight then
            espData.highlight:Destroy()
        end
        if espData.billboard then
            espData.billboard:Destroy()
        end
    end
    WantedESP.espObjects = {}
end

local function updateAllESP()
    if not WantedESP.enabled then
        return
    end
    
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local WantedLevelUtil = require(ReplicatedStorage.SharedModules.WantedLevelUtil)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local espData = WantedESP.espObjects[player]
            local character = player.Character
            
            if not espData and character and character.Parent then
                local wantedLevel = WantedLevelUtil.GetWantedLevelAttribute(player)
                local wantedStage = WantedLevelUtil.GetLevel(wantedLevel)
                if wantedStage > 0 then
                    createESPForPlayer(player)
                end
            end
            
            if espData then
                local keep = updateESP(espData)
                if not keep then
                    removeESP(player)
                end
            end
        end
    end
    
    local playersToRemove = {}
    for player, espData in pairs(WantedESP.espObjects) do
        if not player or not player.Parent then
            table.insert(playersToRemove, player)
        end
    end
    for _, player in pairs(playersToRemove) do
        removeESP(player)
    end
end

local function onWantedChanged(player)
    if not WantedESP.enabled then return end
    if player == game:GetService("Players").LocalPlayer then return end
    
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local WantedLevelUtil = require(ReplicatedStorage.SharedModules.WantedLevelUtil)
    
    local wantedLevel = WantedLevelUtil.GetWantedLevelAttribute(player)
    local wantedStage = WantedLevelUtil.GetLevel(wantedLevel)
    local espData = WantedESP.espObjects[player]
    
    if wantedStage > 0 then
        if not espData and player.Character and player.Character.Parent then
            createESPForPlayer(player)
        elseif espData then
            updateESP(espData)
        end
    else
        if espData then
            removeESP(player)
        end
    end
end

local function onCharacterAdded(player, character)
    if not WantedESP.enabled then return end
    if player == game:GetService("Players").LocalPlayer then return end
    
    if WantedESP.espObjects[player] then
        removeESP(player)
    end
    
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local WantedLevelUtil = require(ReplicatedStorage.SharedModules.WantedLevelUtil)
    
    local wantedLevel = WantedLevelUtil.GetWantedLevelAttribute(player)
    local wantedStage = WantedLevelUtil.GetLevel(wantedLevel)
    
    if wantedStage > 0 then
        task.wait(0.5)
        createESPForPlayer(player)
    end
end

