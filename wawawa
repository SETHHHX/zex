local function viajarA(targetPos)
    c = p.Character or c
    h = c:FindFirstChildOfClass("Humanoid") or h
    hrp = c:FindFirstChild("HumanoidRootPart") or hrp

    if not diamondFarmEnabled and not running then return false end 
    if not h then return false end
    
    if noclipConnection then noclipConnection:Disconnect() end
    if heartbeatConnection then heartbeatConnection:Disconnect() end
    if currentFreezeConnection then currentFreezeConnection:Disconnect() end
    
    running = true
    
    local s = h.SeatPart
    if not s then 
        running = false 
        return false 
    end
    
    local v = s.Parent
    while v and not v:FindFirstChild("Root") do v = v.Parent end
    if not v then 
        running = false 
        return false 
    end
    local r = v:FindFirstChild("Root")
    
    limpiarLlantas(v)
    guardarFisicas(c)
    guardarFisicas(v)
    
    for _, part in ipairs(v:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.AssemblyLinearVelocity = Vector3.new(0,0,0)
            part.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end
    if r then r.Anchored = false end
    task.wait(0.05)
    
    noclipConnection = game:GetService("RunService").Stepped:Connect(function()
        if not running or not v or not v.Parent then 
            if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
            return 
        end
        for _, part in ipairs(v:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
    
    local llego = false
    
    heartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not running or not r or not r.Parent then 
            if heartbeatConnection then heartbeatConnection:Disconnect() heartbeatConnection = nil end
            return 
        end
        
        if h and h.Health > 0 then
            local jail = workspace:FindFirstChild("Jail")
            if jail and h:FindFirstChild("Jailed") then
                running = false
                RestoreAll()
                return
            end
        end
        
        local pos = r.Position
        local dir = targetPos - pos
        local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
        
        if dist < DISTANCIA_LLEGADA then
            running = false
            if heartbeatConnection then heartbeatConnection:Disconnect() heartbeatConnection = nil end
            if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
            
            r.CFrame = CFrame.new(targetPos)
            RestoreAll()
            
            freezeVehicleAt(targetPos)
            llego = true
            return
        end
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {v, c}
        local ray = workspace:Raycast(pos + Vector3.new(0,15,0), Vector3.new(0,-50,0), raycastParams)
        if ray then
            r.CFrame = CFrame.new(Vector3.new(pos.X, ray.Position.Y + 2.5, pos.Z))
        else
            r.CFrame = CFrame.new(Vector3.new(pos.X, math.max(pos.Y, targetPos.Y - 3), pos.Z))
        end
        
        local currentSpeed = (dist > FRENADO_INICIO) and MAX_SPEED or math.max(FRENADO_MINIMO, MAX_SPEED * (dist / FRENADO_INICIO))
        local moveDir = Vector3.new(dir.X, 0, dir.Z).Unit
        if moveDir.Magnitude == 0 then moveDir = Vector3.new(1, 0, 0) end
        
        r.AssemblyLinearVelocity = moveDir * currentSpeed
        r.CFrame = CFrame.lookAt(r.Position, r.Position + moveDir)
        r.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end)
    
    repeat 
        task.wait(0.1) 
    until llego or not running or (h and h.Health <= 0)
    
    return llego
end

-- ===== FUNCIÓN INTELIGENTE PARA DETECTAR MISIONES DISPONIBLES =====
local function getAvailableMissions()
    local available = {}
    local truckList = p.PlayerGui:FindFirstChild("TruckShopGui") 
        and p.PlayerGui.TruckShopGui.Frame.TruckList
    
    if not truckList then return available end
    
    for _, missionName in ipairs(MISSION_LIST) do
        local missionGui = truckList:FindFirstChild(missionName)
        if missionGui then
            if not missionGui:FindFirstChild("Overlay") and not missionGui:FindFirstChild("Cooldown") then
                table.insert(available, missionName)
            end
        end
    end
    
    return available
end

-- ===== FUNCIÓN PARA EJECUTAR UNA MISIÓN ESPECÍFICA =====
local function executeTruckMission(missionName)
    
    local safeSidePos = Vector3.new(7107, 17, 191)
    local llegoAlLado = viajarA(safeSidePos)
    
    if llegoAlLado and truckMissionsEnabled and diamondFarmEnabled then
        task.wait(0.5)
        
        local checkSeatTimeout = 0
        while h and h.SeatPart and checkSeatTimeout < 2 do
            h.Jump = true
            task.wait(0.2)
            checkSeatTimeout = checkSeatTimeout + 0.2
        end
        RestoreAll()
        task.wait(0.2)
        
        local npcPos = Vector3.new(7129, 19, 231)
        local startTime = tick()
        
        while (hrp.Position - npcPos).Magnitude > 2 and (tick() - startTime) < 4 do
            hrp.CFrame = CFrame.new(hrp.Position:Lerp(npcPos, 0.15))
            hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
            task.wait(0.05)
        end
        hrp.CFrame = CFrame.new(npcPos)
        task.wait(0.4)
        
        local missionStarted = false
        
        for attempt = 1, 3 do
            local args = { [1] = missionName, [2] = 0 }
            game:GetService("ReplicatedStorage"):WaitForChild("__remotes"):WaitForChild("TruckService"):WaitForChild("StartMission"):InvokeServer(unpack(args))
            
            local checkTime = 0
            while checkTime < 3.5 do
                if h and h.SeatPart and h.SeatPart:IsA("VehicleSeat") then
                    missionStarted = true
                    break
                end
                task.wait(0.5)
                checkTime = checkTime + 0.5
            end
            
            if missionStarted then break end
            task.wait(0.5)
        end
        
        -- PLAN DE ESCAPE CON ARRASTRE ULTRA-SUAVE (ANTI-CHEAT)
        if not missionStarted then
            local podiumPos = Vector3.new(6897, 17, -36)
            
            local escapeNoclip = game:GetService("RunService").Stepped:Connect(function()
                for _, part in ipairs(c:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end)
            
            local escapeTime = tick()
            while (hrp.Position - podiumPos).Magnitude > 2 and (tick() - escapeTime) < 6 do
                hrp.CFrame = CFrame.new(hrp.Position:Lerp(podiumPos, 0.08))
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                task.wait(0.04)
            end
            
            escapeNoclip:Disconnect()
            hrp.CFrame = CFrame.new(podiumPos)
            task.wait(0.5)
            RestoreAll()
            return false
        end
        
        -- Si ya estamos montados, procedemos directo a buscar el destino de entrega
        if h.SeatPart and h.SeatPart:IsA("VehicleSeat") then
            local deliveryPoint = nil
            local timeout = 0
            
            repeat
                task.wait(0.5)
                timeout = timeout + 0.5
                
                local deliveryFolder = workspace:FindFirstChild("TruckDeliveryPoints")
                if deliveryFolder then
                    for _, folder in ipairs(deliveryFolder:GetChildren()) do
                        if folder:FindFirstChild("Part") then
                            deliveryPoint = folder.Part
                            break
                        end
                    end
                end
            until deliveryPoint or timeout > 6 or not truckMissionsEnabled or not diamondFarmEnabled
            
            if deliveryPoint and truckMissionsEnabled and diamondFarmEnabled then
                
                local llegoDestino = viajarA(deliveryPoint.Position)
                if llegoDestino and truckMissionsEnabled and diamondFarmEnabled then
                    
                    local s = h.SeatPart
                    local v = s and s.Parent
                    while v and not v:FindFirstChild("Root") do v = v.Parent end
                    local r = v and v:FindFirstChild("Root")
                    
                    if r then
                        if currentFreezeConnection then currentFreezeConnection:Disconnect() end
                        
                        local undergroundDeliveryPos = deliveryPoint.Position - Vector3.new(0, 15, 0)
