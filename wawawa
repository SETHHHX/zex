                            elseif not child:IsA("BasePart") then
                                local foundParts = false
                                for _, part in pairs(child:GetDescendants()) do
                                    if part:IsA("BasePart") and not part:FindFirstChild("ESP_Highlight") then
                                        createESP(part, child.Name)
                                        foundParts = true
                                    end
                                end
                                if foundParts then
                                    printersFound = printersFound + 1
                                end
                            end
                        end
                    end
                    return printersFound
                else
                    for _, descendant in pairs(apartment:GetDescendants()) do
                        local name = descendant.Name:lower()
                        if (name:find("money") and name:find("printer")) or name == "money printer" then
                            if descendant:IsA("BasePart") and not descendant:FindFirstChild("ESP_Highlight") then
                                createESP(descendant)
                                printersFound = printersFound + 1
                            end
                        end
                    end
                    return printersFound
                end
            end

