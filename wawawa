                local count = 0
                local apartments = Workspace:FindFirstChild("Apartments")
                if apartments then
                    local units = apartments:FindFirstChild("Units")
                    if units then
                        for _, apartment in pairs(units:GetChildren()) do
                            for _, descendant in pairs(apartment:GetDescendants()) do
                                if descendant:FindFirstChild("ESP_Highlight") then
                                    removeESP(descendant)
                                    count = count + 1
                                end
                            end
                        end
                    end
                end
                print("[*] " .. count .. " ESP elements removed")
            end

