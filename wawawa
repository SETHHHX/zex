                fovCircle.Position = getScreenCenter()
                -- Solo se ve si el Master de la UI está encendido, mostrar FOV es true, y el candado está activo
                fovCircle.Visible = showFOV and aimbotMasterEnabled and aimlockEnabled
            end
        end)
    end

    --// Bucle principal del aimbot
--// Bucle principal del aimbot (CORREGIDO PARA MOBILE)
    local function startAimlock()
        if aimlockLoop then 
            aimlockLoop:Disconnect() 
            aimlockLoop = nil 
        end

        aimlockLoop = RunService.RenderStepped:Connect(function()
            if not aimbotMasterEnabled or not aimlockEnabled then return end
            
            if not aimlockTarget or not isAlive(aimlockTarget) then
                aimlockTarget = getClosestPlayerInFOV()
                if not aimlockTarget then return end
            end

            local part = getTargetPart(aimlockTarget)
            if not part then 
                aimlockTarget = nil 
                return 
            end

            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then 
                aimlockTarget = getClosestPlayerInFOV()
                return 
            end

            local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
            
            if not isInFOV(targetScreen) then
                aimlockTarget = getClosestPlayerInFOV()
                return
            end
            
            -- En vez de usar mousemoverel, calculamos la rotación que debe tener la cámara
            -- Usamos CFrame.lookAt para apuntar directo a la parte del objetivo
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, part.Position)
            
            -- Aplicamos el suavizado usando :Lerp() directo en la cámara del jugador
            -- Nota: como smoothness suele ser bajo (ej: 0.15), el Lerp dará un movimiento súper fluido en Mobile
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothness)
        end)
    end

    --// Detener aimbot
    local function stopAimlock()
        if aimlockLoop then 
            aimlockLoop:Disconnect() 
            aimlockLoop = nil 
        end
