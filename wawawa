                for _, player in pairs(Players:GetPlayers()) do
                    if player.DisplayName == displayName then
                        return player.Name
                    end
                end
                return displayName
            end

            local function applyStyle(textLabel)
                textLabel.TextColor3 = currentStyle.textColor
                textLabel.TextStrokeColor3 = currentStyle.strokeColor
                textLabel.TextStrokeTransparency = currentStyle.strokeTransparency
                textLabel.Font = currentStyle.font
                textLabel.TextScaled = true
                textLabel.RichText = true
            end

            -- --- MAIN UNIFIED SCAN ---
            local function performUnifiedScan()
                if not _G.MoneyPrinterAndNameplateESP then return end

                local apartments = Workspace:FindFirstChild("Apartments")
                if not apartments then 
