Visual2:Toggle({
    Name = "Wanted ESP",
    Default = false,
    Callback = function(Value)
        WantedESP.enabled = Value
        
        if Value then
            local Players = game:GetService("Players")
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local RunService = game:GetService("RunService")
            local WantedLevelUtil = require(ReplicatedStorage.SharedModules.WantedLevelUtil)
            local LocalPlayer = Players.LocalPlayer
            
            -- Conectar eventos de wanted
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    if not WantedESP.playersAdded[player] then
                        WantedESP.playersAdded[player] = player:GetAttributeChangedSignal(WantedLevelUtil.WANTED_LEVEL_ATTRIBUTE):Connect(function()
                            onWantedChanged(player)
                        end)
                    end
                end
            end
            
            -- Conectar PlayerAdded
            if not WantedESP.playersAdded._playerAdded then
                WantedESP.playersAdded._playerAdded = Players.PlayerAdded:Connect(function(player)
                    if player ~= LocalPlayer then
                        if not WantedESP.playersAdded[player] then
                            WantedESP.playersAdded[player] = player:GetAttributeChangedSignal(WantedLevelUtil.WANTED_LEVEL_ATTRIBUTE):Connect(function()
                                onWantedChanged(player)
                            end)
                        end
                    end
                end)
            end
            
            -- Conectar eventos de character
            local function onPlayerCharacterAdded(player)
                if player ~= LocalPlayer then
                    if not WantedESP.playersAdded["char_" .. player.UserId] then
                        WantedESP.playersAdded["char_" .. player.UserId] = player.CharacterAdded:Connect(function(character)
                            onCharacterAdded(player, character)
                        end)
                    end
                end
            end
            
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    onPlayerCharacterAdded(player)
                end
            end
            
            if not WantedESP.playersAdded._playerAddedChar then
                WantedESP.playersAdded._playerAddedChar = Players.PlayerAdded:Connect(onPlayerCharacterAdded)
            end
            
            -- Loop principal
            if not WantedESP.connection then
                WantedESP.connection = RunService.Heartbeat:Connect(function()
                    updateAllESP()
                end)
            end
            
            task.wait(0.5)
            updateAllESP()
            
        else
            -- Desconectar eventos
            for key, connection in pairs(WantedESP.playersAdded) do
                if connection and type(connection) == "table" and connection.Disconnect then
                    pcall(function() connection:Disconnect() end)
                end
            end
            WantedESP.playersAdded = {}
            
            -- Desconectar loop
            if WantedESP.connection then
                pcall(function() WantedESP.connection:Disconnect() end)
                WantedESP.connection = nil
            end
            
            -- Limpiar ESPs
            clearAllESP()
        end
    end
}, nil)


