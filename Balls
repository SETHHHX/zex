-- Animated background loop connection
local animBgConnection = nil
local animBgFrameIndex = 1
local animBgTime = 0

local function stopAnimBg()
    if animBgConnection then
        animBgConnection:Disconnect()
        animBgConnection = nil
    end
end

local function startAnimBg(theme)
    stopAnimBg()
    animBgFrameIndex = 1
    animBgTime = 0
    local frames = theme.animFrames
    local numFrames = #frames
    local cycleDuration = 3.5 -- seconds per frame

    animBgConnection = RunService.Heartbeat:Connect(function(dt)
        animBgTime += dt
        if animBgTime >= cycleDuration then
            animBgTime = 0
            animBgFrameIndex = (animBgFrameIndex % (numFrames - 1)) + 1
            local nextIndex = animBgFrameIndex + 1
            if nextIndex > numFrames then nextIndex = 1 end
            local topColor = frames[animBgFrameIndex][1]
            local botColor = frames[animBgFrameIndex][2]
            local tweenTarget = {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, topColor),
                    ColorSequenceKeypoint.new(1, botColor),
                })
            }
            -- UIGradient can't be tweened directly so we lerp manually
            -- We'll do a short loop interpolation
            local startTop = frames[animBgFrameIndex][1]
            local startBot = frames[animBgFrameIndex][2]
            local endTop   = frames[nextIndex][1]
            local endBot   = frames[nextIndex][2]
            local elapsed  = 0
            local transitionTime = cycleDuration
            -- Remove old sub-connection and start new transition
            task.spawn(function()
                local t = 0
                while t < 1 do
                    t += RunService.Heartbeat:Wait() / transitionTime
                    t = math.min(t, 1)
                    local tc = startTop:Lerp(endTop, t)
                    local bc = startBot:Lerp(endBot, t)
                    animGrad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, tc),
                        ColorSequenceKeypoint.new(1, bc),
                    })
                end
            end)
        end
    end)
end

-- Collect all recolor-able UI elements into a table for easy bulk recolor
-- We do a "live recolor" approach: walk through known references
-- This is a selective recolor of key elements that drive the look

-- We'll define a function that does a full recolor pass
-- It tweens major accent elements and snaps the rest

function applyTheme(index)
    local t = THEMES[index]
    applyThemeToC(t) -- Update C table

    -- Stop any current animation
    stopAnimBg()

    -- Background
    if t.animated then
        animBg.BackgroundTransparency = 1
        -- Set initial gradient
        animGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, t.animFrames[1][1]),
            ColorSequenceKeypoint.new(1, t.animFrames[1][2]),
        })
        animGrad.Rotation = 140
        startAnimBg(t)
    else
        animBg.BackgroundTransparency = 0
        animBg.BackgroundColor3 = t.bg
        animGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, t.bgHeader),
            ColorSequenceKeypoint.new(1, t.bgDeep),
        })
        animGrad.Rotation = 140
    end

    -- Panel frame
    TweenService:Create(frame, tweenInfo, {BackgroundColor3=t.bg}):Play()
    TweenService:Create(mainPanelStroke, tweenInfo, {Color=t.accentBorder}):Play()

    -- Header
