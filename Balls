    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- ======= KEYBIND DETECTION =======
local function setWaiting(mode, btn)
    waitingFor     = mode
    btn.Text       = "Press key..."
    btn.TextColor3 = C.accent
end

local function clearWaiting(btn, displayLbl, name)
    waitingFor        = nil
    btn.Text          = "Change"
    btn.TextColor3    = C.textMuted
    displayLbl.Text   = name
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == Enum.KeyCode.Escape and waitingFor then
        if     waitingFor == "macro"   then clearWaiting(bindBtn,    keybindDisplay, currentKeybind.Name)
        elseif waitingFor == "hide"    then clearWaiting(hideBndBtn, hideDisplay,    hideKeybind.Name)
        elseif waitingFor == "spamkey" then clearWaiting(spamBndBtn, spamDisplay,    spamKey.Name) end
        waitingFor = nil
        return
    end

    if waitingFor == "macro" then
        currentKeybind = input.KeyCode
        clearWaiting(bindBtn, keybindDisplay, input.KeyCode.Name)
        updateOverlayText()
        return
    elseif waitingFor == "hide" then
        hideKeybind = input.KeyCode
        clearWaiting(hideBndBtn, hideDisplay, input.KeyCode.Name)
        return
    elseif waitingFor == "spamkey" then
        spamKey = input.KeyCode
        clearWaiting(spamBndBtn, spamDisplay, input.KeyCode.Name)
        updateOverlayText()
        if macroEnabled then stopSpam(); startSpam() end
        return
    end

    if gameProcessed then return end

    if     input.KeyCode == currentKeybind then toggleMacro()
    elseif input.KeyCode == hideKeybind    then toggleEverything() end
end)

