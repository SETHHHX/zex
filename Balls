-- ============ SPAM LOOP — MAX SPEED ============
-- cachedInterval se actualiza solo cuando cambia keysPerSecond,
-- evitando la división en cada frame.
-- Los eventos se envían directo sin for-loop extra cuando ticks == 1
-- (caso más común a velocidades razonables).
-- Para ticks > 1 (frames lentos/lag spike) sí itera, pero es raro.
local function updateInterval()
    cachedInterval = 1 / keysPerSecond
end

local function startSpam()
    if spamConnection then spamConnection:Disconnect(); spamConnection = nil end
    accumulator = 0
    spamConnection = RunService.Heartbeat:Connect(function(dt)
        if not macroEnabled then return end
        accumulator = accumulator + dt
        if accumulator < cachedInterval then return end  -- fast-path: nada que hacer
        local ticks = math.floor(accumulator / cachedInterval)
        accumulator = accumulator - ticks * cachedInterval
        -- hot path sin overhead de task.spawn para ticks bajos
        if ticks == 1 then
            VirtualInputManager:SendKeyEvent(true,  spamKey, false, game)
            VirtualInputManager:SendKeyEvent(false, spamKey, false, game)
        else
            task.spawn(function()
                for _ = 1, ticks do
                    VirtualInputManager:SendKeyEvent(true,  spamKey, false, game)
                    VirtualInputManager:SendKeyEvent(false, spamKey, false, game)
                end
            end)
        end
    end)
end

local function stopSpam()
    if spamConnection then spamConnection:Disconnect(); spamConnection = nil end
    accumulator = 0
end

