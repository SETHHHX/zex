    if enter then
        local num = tonumber(cpsBox.Text)
        if num and num > 0 then
            keysPerSecond = math.clamp(num, 1, 2000)
            cpsBox.Text   = tostring(keysPerSecond)
            updateInterval()  -- recalcula el intervalo cacheado
            if macroEnabled then stopSpam(); startSpam() end
        else
            cpsBox.Text = tostring(keysPerSecond)
        end
    end
end)

