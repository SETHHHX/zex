local function makeCorner(parent, radius)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, radius or 8)
    return c
end
local function makeStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke", parent)
    s.Color        = color        or C.accentBorder
    s.Thickness    = thickness    or 1
    s.Transparency = transparency or 0.55
    return s
end

local function makeSwitch(parent, xOffset, yPos, isOn, onColor, onBorder)
    local track = Instance.new("Frame")
    track.Size                   = UDim2.new(0, 42, 0, 22)
    track.Position               = UDim2.new(1, xOffset, 0, yPos)
    track.BackgroundColor3       = isOn and onColor or C.accentDim
    track.BackgroundTransparency = 0.3
    track.BorderSizePixel        = 0
    track.ZIndex                 = 12
    track.Parent                 = parent
    makeCorner(track, 11)
    local stroke = makeStroke(track, isOn and onBorder or C.accentDim, 1, 0.45)

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 16, 0, 16)
    thumb.Position         = isOn and UDim2.new(0, 23, 0, 3) or UDim2.new(0, 3, 0, 3)
    thumb.BackgroundColor3 = C.white
    thumb.BorderSizePixel  = 0
    thumb.ZIndex           = 13
    thumb.Parent           = track
    makeCorner(thumb, 99)

    local btn = Instance.new("TextButton")
    btn.Size               = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text               = ""
    btn.ZIndex             = 14
    btn.Parent             = track

    return track, thumb, stroke, btn
end

