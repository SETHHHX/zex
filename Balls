-- ============ MODO TOGGLE / HOLD ============
local function setMacroMode(mode)
    macroMode = mode
    -- si cambia a toggle mientras hold estaba activo, apaga el macro
    if mode == "toggle" and macroEnabled and not holdActive then
        macroEnabled = false
        updateMacroVisuals()
        stopSpam()
    end
    if mode == "toggle" then
        TweenService:Create(modeToggleBtn,tweenInfo,{BackgroundColor3=C.accentDim,BackgroundTransparency=0.2}):Play()
        modeToggleBtn.TextColor3=C.accent
        TweenService:Create(modeToggleStroke,tweenInfo,{Color=C.accentBorder,Transparency=0.35}):Play()
        TweenService:Create(modeHoldBtn,tweenInfo,{BackgroundColor3=C.bgRow,BackgroundTransparency=0.0}):Play()
        modeHoldBtn.TextColor3=C.textMuted
        TweenService:Create(modeHoldStroke,tweenInfo,{Color=C.accentDim,Transparency=0.6}):Play()
    else
        TweenService:Create(modeHoldBtn,tweenInfo,{BackgroundColor3=C.accentDim,BackgroundTransparency=0.2}):Play()
        modeHoldBtn.TextColor3=C.accent
        TweenService:Create(modeHoldStroke,tweenInfo,{Color=C.accentBorder,Transparency=0.35}):Play()
        TweenService:Create(modeToggleBtn,tweenInfo,{BackgroundColor3=C.bgRow,BackgroundTransparency=0.0}):Play()
        modeToggleBtn.TextColor3=C.textMuted
        TweenService:Create(modeToggleStroke,tweenInfo,{Color=C.accentDim,Transparency=0.6}):Play()
    end
end

modeToggleBtn.MouseButton1Click:Connect(function() setMacroMode("toggle") end)
modeHoldBtn.MouseButton1Click:Connect(function()   setMacroMode("hold")   end)

-- ======= DRAG =======
local dragging, dragStart, startPos = false, nil, nil
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging=true; dragStart=input.Position; startPos=frame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local d = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X,
                                    startPos.Y.Scale, startPos.Y.Offset+d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
end)

-- ======= KEYBINDS =======
local function setWaiting(mode, btn)
    waitingFor=mode; btn.Text="Press key..."; btn.TextColor3=C.accent
end
local function clearWaiting(btn, displayLbl, name)
    waitingFor=nil; btn.Text="Change"; btn.TextColor3=C.textMuted; displayLbl.Text=name
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == Enum.KeyCode.Escape and waitingFor then
        if     waitingFor=="macro"   then clearWaiting(bindBtn,    keybindDisplay, currentKeybind.Name)
        elseif waitingFor=="hide"    then clearWaiting(hideBndBtn, hideDisplay,    hideKeybind.Name)
        elseif waitingFor=="spamkey" then clearWaiting(spamBndBtn, spamDisplay,    spamKey.Name) end
        waitingFor=nil; return
    end

    if waitingFor=="macro" then
        currentKeybind=input.KeyCode; clearWaiting(bindBtn,keybindDisplay,input.KeyCode.Name)
        updateOverlayText(); return
    elseif waitingFor=="hide" then
        hideKeybind=input.KeyCode; clearWaiting(hideBndBtn,hideDisplay,input.KeyCode.Name); return
    elseif waitingFor=="spamkey" then
        spamKey=input.KeyCode; clearWaiting(spamBndBtn,spamDisplay,input.KeyCode.Name)
        updateOverlayText()
        if macroEnabled then stopSpam(); startSpam() end; return
    end

    if gameProcessed then return end

    if input.KeyCode == currentKeybind then
        if macroMode == "toggle" then
            toggleMacro()
        elseif macroMode == "hold" then
            holdActive = true
            if not macroEnabled then
                macroEnabled = true
                updateMacroVisuals()
                startSpam()
            end
        end
    elseif input.KeyCode == hideKeybind then
        toggleEverything()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == currentKeybind and macroMode == "hold" then
        holdActive = false
        if macroEnabled then
            macroEnabled = false
            updateMacroVisuals()
            stopSpam()
        end
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
end)

