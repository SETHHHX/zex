    end)
end

-- ============ LOW GRAPHICS — CARTOON ============
local savedParts    = {}
local savedLighting = {}
local savedEffects  = {}

local function applyCartoonMode()
    savedLighting = {
        GlobalShadows=Lighting.GlobalShadows, Brightness=Lighting.Brightness,
        ShadowSoftness=Lighting.ShadowSoftness, Ambient=Lighting.Ambient,
        OutdoorAmbient=Lighting.OutdoorAmbient,
    }
    Lighting.GlobalShadows=false; Lighting.Brightness=2; Lighting.ShadowSoftness=0
    Lighting.Ambient=Color3.fromRGB(178,178,178); Lighting.OutdoorAmbient=Color3.fromRGB(178,178,178)
    savedEffects={}
    for _,child in ipairs(Lighting:GetChildren()) do
        if child:IsA("BlurEffect") or child:IsA("ColorCorrectionEffect")
        or child:IsA("SunRaysEffect") or child:IsA("BloomEffect")
        or child:IsA("DepthOfFieldEffect") then
            savedEffects[child]=child.Enabled; child.Enabled=false
        end
    end
    settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
    savedParts={}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsA("Terrain") then
            savedParts[obj]={color=obj.Color,material=obj.Material,castShadow=obj.CastShadow}
            obj.Material=Enum.Material.SmoothPlastic; obj.CastShadow=false
        end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            savedParts[obj]={transparency=obj.Transparency}; obj.Transparency=1
        end
        if obj:IsA("MeshPart") then
            if not savedParts[obj] then savedParts[obj]={} end
            savedParts[obj].textureID=obj.TextureID; obj.TextureID=""
        elseif obj:IsA("SpecialMesh") then
            if not savedParts[obj] then savedParts[obj]={} end
            savedParts[obj].textureID=obj.TextureId; obj.TextureId=""
        end
    end
end

local function restoreCartoonMode()
    if savedLighting.GlobalShadows~=nil then
        Lighting.GlobalShadows=savedLighting.GlobalShadows; Lighting.Brightness=savedLighting.Brightness
        Lighting.ShadowSoftness=savedLighting.ShadowSoftness; Lighting.Ambient=savedLighting.Ambient
        Lighting.OutdoorAmbient=savedLighting.OutdoorAmbient
    end
    for effect,wasEnabled in pairs(savedEffects) do
        if effect and effect.Parent then effect.Enabled=wasEnabled end
    end
    settings().Rendering.QualityLevel=Enum.QualityLevel.Automatic
    for obj,data in pairs(savedParts) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                obj.Color=data.color; obj.Material=data.material; obj.CastShadow=data.castShadow
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency=data.transparency
            elseif obj:IsA("MeshPart") then obj.TextureID=data.textureID or ""
            elseif obj:IsA("SpecialMesh") then obj.TextureId=data.textureID or ""
            end
        end
    end
    savedParts={}
end

