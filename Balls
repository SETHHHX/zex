        TweenService:Create(modeToggleBtn, tweenInfo, {BackgroundColor3=t.bgRow, TextColor3=t.textMuted}):Play()
        TweenService:Create(modeHoldStroke, tweenInfo, {Color=t.accentBorder}):Play()
        TweenService:Create(modeToggleStroke, tweenInfo, {Color=t.accentDim}):Play()
    end

    -- KPS card
    TweenService:Create(kpsCard, tweenInfo, {BackgroundColor3=t.bgCard}):Play()
