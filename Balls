local function toggleMacro()
    macroEnabled = not macroEnabled
    updateMacroVisuals()
    if macroEnabled then startSpam() else stopSpam() end
end

local function togglePanel()
    panelVisible = not panelVisible
    if panelVisible then
        TweenService:Create(frame,tweenInfo,{Size=UDim2.new(0,PANEL_W,0,PANEL_H_VISIBLE)}):Play()
        hideBtn.Text="Hide ▲"
    else
        TweenService:Create(frame,tweenInfo,{Size=UDim2.new(0,PANEL_W,0,PANEL_H_CLOSED)}):Play()
        hideBtn.Text="Show ▼"
    end
end

local function toggleEverything()
    everythingVisible = not everythingVisible
    frame.Visible = everythingVisible
end

local function toggleOverlaySwitch()
