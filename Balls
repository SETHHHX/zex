        overlayLabel.TextColor3=C.green; toggleBtn.Text="● MACRO ENABLED"; statusBadge.Text="ON"
    else
        TweenService:Create(toggleBtn,    tweenInfo,{BackgroundColor3=C.accentDim,BackgroundTransparency=0.55,TextColor3=C.accent}):Play()
        TweenService:Create(toggleStroke, tweenInfo,{Color=C.accentBorder,Transparency=0.45}):Play()
        TweenService:Create(headerDot,    tweenInfo,{BackgroundColor3=C.accent}):Play()
        TweenService:Create(statusBadge,  tweenInfo,{BackgroundColor3=C.accentDim,TextColor3=C.accent}):Play()
        TweenService:Create(overlayStroke,tweenInfo,{Color=C.accentBorder,Transparency=0.5}):Play()
