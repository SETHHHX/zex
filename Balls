-- ============ KPS LOOP (anti-lag: cumulative timing) ============
local kpsHeartbeat = nil

local function startKPS()
    if kpsRunning or not kpsEnabled then return end
    kpsRunning = true
    local acc = 0
    kpsHeartbeat = RunService.Heartbeat:Connect(function(dt)
        if not kpsRunning or not macroEnabled or not kpsEnabled then
            kpsRunning = false
            kpsHeartbeat:Disconnect()
            kpsHeartbeat = nil
            return
        end
        acc += dt
        local interval = 1 / keysPerSecond
        local fired = 0
        while acc >= interval and fired < 8 do
            VIM:SendKeyEvent(true,  spamKey, false, _game)
            VIM:SendKeyEvent(false, spamKey, false, _game)
            acc -= interval
            fired += 1
        end
        if acc > interval * 8 then acc = 0 end
    end)
end

local function stopKPS()
    kpsRunning = false
end

-- ============ CPS LOOP ============
local cpsHeartbeat = nil

local function startCPS()
    if cpsRunning or not cpsEnabled then return end
    cpsRunning = true
    local acc = 0
    cpsHeartbeat = RunService.Heartbeat:Connect(function(dt)
        if not cpsRunning or not macroEnabled or not cpsEnabled then
            cpsRunning = false
            cpsHeartbeat:Disconnect()
            cpsHeartbeat = nil
            return
        end
        acc += dt
        local interval = 1 / clicksPerSecond
        local fired = 0
        while acc >= interval and fired < 8 do
            if cpsButton == "LMB" then
                VIM:SendMouseButtonEvent(0, 0, 0, true,  _game, 1)
                VIM:SendMouseButtonEvent(0, 0, 0, false, _game, 1)
            else
                VIM:SendMouseButtonEvent(0, 0, 1, true,  _game, 1)
                VIM:SendMouseButtonEvent(0, 0, 1, false, _game, 1)
            end
            acc -= interval
            fired += 1
        end
        if acc > interval * 8 then acc = 0 end
    end)
end

local function stopCPS()
    cpsRunning = false
end

-- ============ FPS UNLOCK ============
local fpsLoopConnection = nil

local function applyFPSUnlock()
    if setfpscap then setfpscap(999) end
end
local function restoreFPSCap()
    if setfpscap then setfpscap(60) end
end
local function startFPSLoop()
    if fpsLoopConnection then return end
    local timer = 0
    fpsLoopConnection = RunService.Heartbeat:Connect(function(dt)
        if not fpsUnlockOn then return end
        timer += dt
        if timer >= 2 then timer = 0; applyFPSUnlock() end
    end)
end
local function stopFPSLoop()
    if fpsLoopConnection then fpsLoopConnection:Disconnect(); fpsLoopConnection = nil end
end

