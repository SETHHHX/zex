        Size=UDim2.new(0,14,0,14),
        Position=isOn and UDim2.new(0,21,0,3) or UDim2.new(0,3,0,3),
        BackgroundColor3=C.white,
        BorderSizePixel=0,
        ZIndex=15,
        Parent=track
