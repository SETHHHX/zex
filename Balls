local function updateMacroVisuals()
    if macroEnabled then
        TweenService:Create(toggleBtn,    tweenInfo, {BackgroundColor3=C.greenDim,  BackgroundTransparency=0.55, TextColor3=C.green}):Play()
        TweenService:Create(toggleStroke, tweenInfo, {Color=C.greenBorder, Transparency=0.35}):Play()
        TweenService:Create(headerDot,    tweenInfo, {BackgroundColor3=C.green}):Play()
        TweenService:Create(statusBadge,  tweenInfo, {BackgroundColor3=C.greenDim,  TextColor3=C.green}):Play()
        TweenService:Create(overlayStroke,tweenInfo, {Color=C.greenBorder, Transparency=0.4}):Play()
        TweenService:Create(overlayDot,   tweenInfo, {BackgroundColor3=C.green}):Play()
        overlayLabel.TextColor3 = C.green
        toggleBtn.Text          = "● MACRO ENABLED"
        statusBadge.Text        = "ON"
    else
        TweenService:Create(toggleBtn,    tweenInfo, {BackgroundColor3=C.accentDim, BackgroundTransparency=0.55, TextColor3=C.accent}):Play()
        TweenService:Create(toggleStroke, tweenInfo, {Color=C.accentBorder, Transparency=0.45}):Play()
        TweenService:Create(headerDot,    tweenInfo, {BackgroundColor3=C.accent}):Play()
        TweenService:Create(statusBadge,  tweenInfo, {BackgroundColor3=C.accentDim, TextColor3=C.accent}):Play()
        TweenService:Create(overlayStroke,tweenInfo, {Color=C.accentBorder, Transparency=0.5}):Play()
        TweenService:Create(overlayDot,   tweenInfo, {BackgroundColor3=C.accent}):Play()
        overlayLabel.TextColor3 = C.accent
        toggleBtn.Text          = "● MACRO DISABLED"
        statusBadge.Text        = "OFF"
    end
    updateOverlayText()
end

local function toggleMacro()
    macroEnabled = not macroEnabled
    updateMacroVisuals()
    if macroEnabled then startSpam() else stopSpam() end
end

local function togglePanel()
    panelVisible = not panelVisible
    if panelVisible then
        TweenService:Create(frame, tweenInfo, {Size = UDim2.new(0, PANEL_W, 0, PANEL_H_OPEN)}):Play()
        hideBtn.Text = "Hide ▲"
    else
        TweenService:Create(frame, tweenInfo, {Size = UDim2.new(0, PANEL_W, 0, PANEL_H_CLOSED)}):Play()
        hideBtn.Text = "Show ▼"
    end
end

local function toggleEverything()
