-- Función auxiliar para verificar si el Owner cambió (confirmación de compra)
local function getOwner(cube)
    local ownerValue = cube:GetAttribute("Owner") 
        or (cube:FindFirstChild("Owner") and cube.Owner.Value)
    
    if not ownerValue then
        pcall(function() ownerValue = cube.Owner end)
    end
    return ownerValue
end

-- Función principal de Auto Buy
local function processAutoBuy()
    local sheepFolder = Workspace:FindFirstChild("CubeSheep")
    if not sheepFolder then return end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, cube in pairs(sheepFolder:GetChildren()) do
        if not AutoBuyEnabled then break end
        
        if cube:IsA("BasePart") and cube.Name == "Cube" then
            
            -- Obtener 'SheepName'
            local sheepName = cube:GetAttribute("SheepName") 
                or (cube:FindFirstChild("SheepName") and cube.SheepName.Value)
            
            if not sheepName then
                pcall(function() sheepName = cube.SheepName end)
            end

            local currentOwner = getOwner(cube)

            -- Validar si la oveja está seleccionada en el Multi Dropdown y le pertenece al "Market"
            if SelectedSheeps[sheepName] and currentOwner == "Market" then
                local prompt = cube:FindFirstChildOfClass("ProximityPrompt") or cube:FindFirstChild("ProximityPrompt")
                
                if prompt then
                    -- 1. Guardar posición original antes de mover al personaje
                    local originalCFrame = hrp.CFrame

                    -- 2. TP a la oveja
                    hrp.CFrame = cube.CFrame * CFrame.new(0, 3, 0)
                    
                    -- ⏳ Esperar 2 segundos tras llegar
                    task.wait(2)

                    -- 3. Intentar comprar si aún no ha sido comprada
                    local attempts = 0
                    while AutoBuyEnabled and getOwner(cube) == "Market" and attempts < 5 do
                        if prompt.Enabled then
                            fireproximityprompt(prompt)
                        end
                        task.wait(0.3) -- Pequeño intervalo de reintento si falla
                        attempts = attempts + 1
                    end

                    -- ⏳ Esperar 2 segundos después de intentar comprar
                    task.wait(2)

                    -- 4. Regresar a la posición inicial
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        character.HumanoidRootPart.CFrame = originalCFrame
                    end
                    
                    task.wait(0.5) -- Pausa rápida de seguridad antes de ir por la siguiente oveja
                end
            end
        end
    end
end

